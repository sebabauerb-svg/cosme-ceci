---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getSql, ensureNewsletter } from '../../lib/db';
import { confirmar, tokenValido } from '../../lib/newsletter';

// Segundo paso del doble opt-in: el link del mail de confirmación trae ?t=<token>.
const t = Astro.url.searchParams.get('t');
let estado: 'confirmado' | 'baja' | 'invalido' | 'error' = 'invalido';
if (tokenValido(t)) {
  try {
    const sql = getSql();
    await ensureNewsletter(sql);
    estado = (await confirmar(sql, t)) ?? 'invalido';
  } catch (e) {
    console.error('newsletter/confirmar:', e instanceof Error ? e.message : e);
    estado = 'error';
  }
}
if (estado === 'invalido') Astro.response.status = 404;
---

<Base title="Suscripción a novedades" path="/newsletter/confirmar" noindex>
  <Nav />
  <main id="contenido" class="section nl-pag">
    <div class="container nl-pag__wrap">
      {estado === 'confirmado' && (
        <>
          <h1>¡Listo, ya estás en la lista!</h1>
          <p class="nl-pag__lead">Cuando haya novedades, tips o notas nuevas te llegan a tu email. Cada mail trae un link para darte de baja cuando quieras.</p>
          <div class="nl-pag__actions">
            <a href="/blog" class="btn btn--primary">Ver las novedades</a>
            <a href="/" class="btn btn--ghost">Ir al inicio</a>
          </div>
        </>
      )}
      {estado === 'baja' && (
        <>
          <h1>Este email está dado de baja</h1>
          <p class="nl-pag__lead">Te diste de baja de las novedades. Si querés volver a recibirlas, suscribite de nuevo desde la página de novedades.</p>
          <div class="nl-pag__actions"><a href="/blog#suscribirse" class="btn btn--primary">Suscribirme de nuevo</a></div>
        </>
      )}
      {estado === 'invalido' && (
        <>
          <h1>Este link no es válido</h1>
          <p class="nl-pag__lead">Puede que esté incompleto o que sea de un pedido viejo. Probá suscribirte de nuevo: te llega un mail nuevo para confirmar.</p>
          <div class="nl-pag__actions"><a href="/blog#suscribirse" class="btn btn--primary">Suscribirme</a></div>
        </>
      )}
      {estado === 'error' && (
        <>
          <h1>No pudimos confirmar ahora</h1>
          <p class="nl-pag__lead">Hubo un problema de nuestro lado. Volvé a tocar el link del mail en unos minutos.</p>
        </>
      )}
    </div>
  </main>
  <Footer />
</Base>

<style>
  .nl-pag { padding-block: clamp(4rem, 10vw, 7rem); }
  .nl-pag__wrap { max-width: 560px; margin-inline: auto; text-align: center; }
  .nl-pag__wrap h1 { margin: 0.4rem 0 1rem; }
  .nl-pag__lead { color: var(--ink-soft); margin-bottom: 2rem; }
  .nl-pag__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: center; }
</style>
