---
export const prerender = false;

import Base from '../layouts/Base.astro';
import { isAdmin } from '../lib/admin';
import { getSql, ensureFranjas, ensureDuracionMin, ensureConfirmacion } from '../lib/db';

const authed = isAdmin(Astro.cookies);

const SEDES = [
  { slug: 'montevideo', nombre: 'Montevideo', dur: 45 },
  { slug: 'san-jose', nombre: 'San José', dur: 30 },
  { slug: 'online', nombre: 'Online', dur: 30 },
];

// Horas para los selectores (formato 24 h, cada 15 min, 06:00–23:00).
const pad2 = (n: number) => String(n).padStart(2, '0');
const HORAS_SEL: string[] = [];
for (let t = 6 * 60; t <= 23 * 60; t += 15) HORAS_SEL.push(`${pad2(Math.floor(t / 60))}:${pad2(t % 60)}`);
const DURACIONES = [15, 20, 30, 45, 60, 90];

function fmtFechaTabla(iso?: string | null) {
  if (!iso) return '—';
  try {
    return new Date(iso + 'T12:00:00Z').toLocaleDateString('es-UY', {
      weekday: 'short',
      day: 'numeric',
      month: 'short',
      timeZone: 'UTC',
    });
  } catch {
    return iso;
  }
}

let reservas: any[] = [];
let dbError = '';

if (authed) {
  try {
    const sql = getSql();
    await ensureFranjas(sql);
    await ensureDuracionMin(sql);
    await ensureConfirmacion(sql);
    reservas = (await sql`
      select r.id, r.modalidad, coalesce(s.nombre, 'Online') as sede,
             r.fecha::text as fecha, to_char(r.hora,'HH24:MI') as hora,
             r.nombre, r.telefono, r.estado, r.monto_cobrado, r.pagado
      from reservas r left join sedes s on s.id = r.sede_id
      order by r.created_at desc limit 60
    `) as any[];
  } catch (e) {
    dbError = e instanceof Error ? e.message : String(e);
  }
}
---

<Base title="Panel de Ceci" path="/admin">
  <main class="admin">
    <div class="container">
      {!authed ? (
        <div class="login">
          <h1>Panel de Ceci</h1>
          <p>Ingresá tu contraseña para administrar horarios y ver reservas.</p>
          <form id="login-form">
            <label class="login__label">Contraseña
              <input type="password" name="password" autocomplete="current-password" required />
            </label>
            <button type="submit" class="btn btn--primary">Entrar</button>
          </form>
          <p id="login-error" class="login__err" hidden></p>
        </div>
      ) : (
        <div class="panel">
          <header class="panel__head">
            <h1>Panel de Ceci</h1>
            <button id="logout" class="btn btn--ghost">Salir</button>
          </header>

          {dbError && <p class="login__err">Error de base de datos: {dbError}</p>}

          <section class="card">
            <h2>Tu disponibilidad</h2>
            <p class="muted">Elegí un lugar, tocá los días del calendario y abrí tus horarios. Las clientas solo verán lo que dejes abierto.</p>

            <div class="sedes-tabs" id="sedes-tabs">
              {SEDES.map((s, i) => (
                <button type="button" class:list={['sede-tab', i === 0 && 'is-active']} data-sede={s.slug} data-dur={s.dur}>{s.nombre}</button>
              ))}
            </div>

            <div class="disp">
              <!-- Columna izquierda: franja + calendario -->
              <div class="disp__cal">
                <div class="franja">
                  <span class="franja__lbl">Horario a abrir</span>
                  <div class="franja__ctrl">
                    <select id="f-desde" aria-label="Desde">
                      {HORAS_SEL.map((h) => <option value={h} selected={h === '08:00'}>{h}</option>)}
                    </select>
                    <span class="franja__sep">a</span>
                    <select id="f-hasta" aria-label="Hasta">
                      {HORAS_SEL.map((h) => <option value={h} selected={h === '12:00'}>{h}</option>)}
                    </select>
                    <span class="franja__sep">· cada</span>
                    <select id="f-dur" aria-label="Duración de la consulta">
                      {DURACIONES.map((d) => <option value={d} selected={d === 45}>{d} min</option>)}
                    </select>
                    <span class="franja__prev" id="f-prev"></span>
                  </div>
                </div>
                <div class="atajo">
                  <span class="atajo__lbl">Atajo:</span>
                  <button type="button" class="btn btn--ghost btn--sm" id="atajo-btn">Repetir cada</button>
                  <select id="atajo-dia">
                    <option value="1">lunes</option>
                    <option value="2">martes</option>
                    <option value="3">miércoles</option>
                    <option value="4">jueves</option>
                    <option value="5">viernes</option>
                    <option value="6">sábado</option>
                    <option value="0">domingo</option>
                  </select>
                  <span class="atajo__lbl">por</span>
                  <input type="number" id="atajo-n" min="1" max="26" step="1" value="10" />
                  <span class="atajo__lbl">semanas</span>
                </div>

                <div class="cal">
                  <div class="cal__head">
                    <button type="button" class="cal__nav" id="cal-prev" aria-label="Mes anterior">‹</button>
                    <span class="cal__mes" id="cal-mes"></span>
                    <button type="button" class="cal__nav" id="cal-next" aria-label="Mes siguiente">›</button>
                  </div>
                  <div class="cal__wd"><span>L</span><span>M</span><span>X</span><span>J</span><span>V</span><span>S</span><span>D</span></div>
                  <div class="cal__grid" id="cal-grid"></div>
                  <div class="cal__leg">
                    <span><i class="lg lg--on"></i> abierto</span>
                    <span><i class="lg lg--res"></i> con reserva</span>
                    <span><i class="lg lg--sel"></i> viendo</span>
                  </div>
                </div>
              </div>

              <!-- Columna derecha: detalle del día -->
              <div class="disp__dia" id="dia-panel">
                <p class="dia-vacio">Tocá un día del calendario para abrir o gestionar sus turnos.</p>
              </div>
            </div>

            <div class="guardar">
              <button type="button" id="guardar" class="btn btn--primary">Guardar</button>
              <span id="guardar-msg" class="guardar__msg"></span>
            </div>
          </section>

          <section class="card">
            <div class="card__head">
              <div>
                <h2>Reservas a confirmar</h2>
                <p class="muted">Reservas hechas por la web sin pagar. Confirmalas (el turno queda firme) o rechazalas (libera el cupo). Podés anotar el monto y si ya pagó.</p>
              </div>
            </div>
            <div id="por-confirmar"><p class="ag-vacia">Cargando…</p></div>
          </section>

          <section class="card">
            <div class="card__head">
              <div>
                <h2>Gestión de turnos</h2>
                <p class="muted">Turnos confirmados de acá en adelante: cuánto se acordó, cuánto entró de seña y qué saldo queda. Desde acá también armás el mensaje de WhatsApp y marcás a quién ya recordaste.</p>
              </div>
              <div class="gs-filtros">
                <label class="gs-filtro"><input type="checkbox" id="gs-solo-deuda" /> Solo con saldo</label>
                <label class="gs-filtro"><input type="checkbox" id="gs-solo-pronto" /> Próximos 7 días</label>
              </div>
            </div>
            <div id="gestion"><p class="ag-vacia">Cargando…</p></div>
          </section>

          <section class="card">
            <div class="card__head">
              <div>
                <h2>Agenda de las próximas semanas</h2>
                <p class="muted">Todo lo que tenés abierto y reservado, junto.</p>
              </div>
              <div class="ag-leg">
                <span class="ag-leg__i"><i class="ag-dot ag--mv"></i> Montevideo</span>
                <span class="ag-leg__i"><i class="ag-dot ag--on"></i> Online</span>
                <span class="ag-leg__i"><i class="ag-dot ag--sj"></i> San José</span>
              </div>
            </div>
            <div id="agenda"><p class="muted">Cargando…</p></div>
          </section>

          <section class="card">
            <h2>Reservas ({reservas.length})</h2>
            {reservas.length === 0 ? (
              <p class="muted">Todavía no hay reservas.</p>
            ) : (
              <div class="grid-wrap">
                <table class="grid grid--res">
                  <thead>
                    <tr><th>Servicio</th><th>Sede</th><th>Día</th><th>Hora</th><th>Nombre</th><th>WhatsApp</th><th>Estado</th><th>Pago</th><th></th></tr>
                  </thead>
                  <tbody>
                    {reservas.map((r) => (
                      <tr>
                        <td>{r.modalidad === 'manual' ? 'Reserva manual' : r.modalidad}</td>
                        <td>{r.sede}</td>
                        <td>{fmtFechaTabla(r.fecha)}</td>
                        <td>{r.hora ?? '—'}</td>
                        <td>{r.nombre}</td>
                        <td>{r.telefono && r.telefono !== '—' ? (
                          <a class="tel-link" href={`https://wa.me/598${String(r.telefono).replace(/\D/g, '').replace(/^(598|0)/, '')}`} target="_blank" rel="noopener">{r.telefono}</a>
                        ) : '—'}</td>
                        <td><span class={`badge badge--${r.estado}`}>{r.estado}</span></td>
                        <td>{r.estado === 'confirmada' ? (
                          <button class="pago-tog" data-id={r.id} data-pagado={r.pagado ? '1' : '0'} data-monto={r.monto_cobrado != null ? String(Math.round(Number(r.monto_cobrado))) : ''}>{(r.pagado ? '✓ cobrado' : 'pendiente') + (r.monto_cobrado != null ? ' $' + Math.round(Number(r.monto_cobrado)) : '')}</button>
                        ) : '—'}</td>
                        <td><button class="del" data-id={r.id}>Borrar</button></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>
        </div>
      )}
    </div>
  </main>
</Base>

<script>
  // ---------- Login ----------
  const lf = document.getElementById('login-form') as HTMLFormElement | null;
  lf?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = document.getElementById('login-error');
    const pw = (lf.querySelector('input[name="password"]') as HTMLInputElement).value;
    const res = await fetch('/api/admin/login', {
      method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ password: pw }),
    });
    if (res.ok) location.reload();
    else { const d = await res.json().catch(() => ({})); if (err) { err.textContent = d.error || 'No se pudo entrar.'; err.hidden = false; } }
  });
  document.getElementById('logout')?.addEventListener('click', async () => {
    await fetch('/api/admin/login', { method: 'DELETE' });
    location.reload();
  });

  const panel = document.getElementById('dia-panel');
  if (panel) {
    const $ = (id: string) => document.getElementById(id)!;
    const MESES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
    const pad = (n: number) => String(n).padStart(2, '0');
    const hoyUY = new Date(Date.now() - 3 * 3600 * 1000).toISOString().slice(0, 10);

    // ---------- Estado ----------
    let sede = 'montevideo';
    let durSede: Record<string, number> = { montevideo: 45, 'san-jose': 30, online: 30 };
    // dias: fecha -> { horas:Set<string>, duracion:number }
    let dias = new Map<string, { horas: Set<string>; duracion: number }>();
    // reservas: 'fecha hora' -> { nombre, modalidad }
    let reservasMap = new Map<string, { nombre: string; modalidad: string }>();
    let sel: string | null = null; // fecha seleccionada
    let sucio = false;
    const base = new Date(hoyUY + 'T12:00:00Z');
    let vy = base.getUTCFullYear(), vm = base.getUTCMonth();

    function rangoHoras(desde: string, hasta: string, dur: number): string[] {
      if (!desde || !hasta || !dur || dur <= 0) return [];
      const [dh, dm] = desde.split(':').map(Number);
      const [hh, hm] = hasta.split(':').map(Number);
      const fin = hh * 60 + hm;
      const out: string[] = [];
      for (let t = dh * 60 + dm; t + dur <= fin; t += dur) out.push(`${pad(Math.floor(t / 60))}:${pad(t % 60)}`);
      return out;
    }
    function franjaActual() {
      return {
        desde: ($('f-desde') as HTMLInputElement).value,
        hasta: ($('f-hasta') as HTMLInputElement).value,
        dur: Number(($('f-dur') as HTMLInputElement).value),
      };
    }
    function marcarSucio() { sucio = true; setMsg('Tenés cambios sin guardar.', 'dirty'); }
    function setMsg(txt: string, cls = '') { const m = $('guardar-msg'); m.textContent = txt; m.className = 'guardar__msg' + (cls ? ' guardar__msg--' + cls : ''); }
    // Si la sesión expiró (12 h), los fetch devuelven 401: avisar claro y ofrecer recargar.
    function sesionExpirada(res: Response): boolean {
      if (res.status !== 401) return false;
      setMsg('Tu sesión expiró. Recargá la página e ingresá de nuevo.', 'dirty');
      if (confirm('Tu sesión expiró. ¿Recargar para ingresar de nuevo?')) location.reload();
      return true;
    }

    // ---------- Cargar sede ----------
    async function cargarSede(s: string) {
      sede = s;
      sel = null; sucio = false; setMsg('');
      ($('f-dur') as HTMLInputElement).value = String(durSede[s]);
      try {
        const res = await fetch(`/api/admin/horario?sede=${s}`);
        if (sesionExpirada(res)) return;
        const d = await res.json();
        dias = new Map();
        reservasMap = new Map();
        if (d.ok) {
          for (const f of d.franjas) {
            const dia = dias.get(f.fecha) ?? { horas: new Set<string>(), duracion: Number(f.duracion) || 30 };
            dia.horas.add(f.hora); dia.duracion = Number(f.duracion) || dia.duracion;
            dias.set(f.fecha, dia);
          }
          for (const r of d.reservas) reservasMap.set(`${r.fecha} ${r.hora}`, { nombre: r.nombre, modalidad: r.modalidad });
        }
      } catch { setMsg('No se pudo cargar. Probá de nuevo.', 'dirty'); }
      renderCal(); renderDia(); actualizarPrev();
    }

    // ---------- Preview de la franja ----------
    function actualizarPrev() {
      const { desde, hasta, dur } = franjaActual();
      const n = rangoHoras(desde, hasta, dur).length;
      $('f-prev').textContent = n ? `${n} turno${n > 1 ? 's' : ''}` : '⚠ sin turnos';
      $('f-prev').className = 'franja__prev' + (n ? '' : ' franja__prev--warn');
    }
    ['f-desde', 'f-hasta', 'f-dur'].forEach((id) => $(id).addEventListener('input', actualizarPrev));

    // ---------- Calendario ----------
    function renderCal() {
      $('cal-mes').textContent = `${MESES[vm]} ${vy}`;
      const grid = $('cal-grid');
      grid.innerHTML = '';
      const first = new Date(Date.UTC(vy, vm, 1)).getUTCDay(); // 0=dom
      const offset = (first + 6) % 7; // lunes primero
      for (let i = 0; i < offset; i++) grid.appendChild(cel(''));
      const ndays = new Date(Date.UTC(vy, vm + 1, 0)).getUTCDate();
      for (let d = 1; d <= ndays; d++) {
        const iso = `${vy}-${pad(vm + 1)}-${pad(d)}`;
        grid.appendChild(cel(iso, d));
      }
    }
    function cel(iso: string, day?: number) {
      const el = document.createElement(iso && iso >= hoyUY ? 'button' : 'div');
      el.className = 'cal__cell';
      if (!iso) { el.className += ' cal__cell--empty'; return el; }
      el.textContent = String(day);
      if (iso < hoyUY) { el.className += ' cal__cell--past'; return el; }
      (el as HTMLButtonElement).type = 'button';
      const dia = dias.get(iso);
      if (dia && dia.horas.size) {
        el.className += ' cal__cell--on';
        const conRes = [...dia.horas].some((h) => reservasMap.has(`${iso} ${h}`));
        if (conRes) el.className += ' cal__cell--res';
      }
      if (iso === sel) el.className += ' cal__cell--sel';
      el.addEventListener('click', () => { sel = iso; renderCal(); renderDia(); });
      return el;
    }
    $('cal-prev').addEventListener('click', () => { if (vm === 0) { vm = 11; vy--; } else vm--; renderCal(); });
    $('cal-next').addEventListener('click', () => { if (vm === 11) { vm = 0; vy++; } else vm++; renderCal(); });

    // ---------- Panel del día ----------
    function renderDia() {
      if (!sel) { panel.innerHTML = '<p class="dia-vacio">Tocá un día del calendario para abrir o gestionar sus turnos.</p>'; return; }
      const [y, m, d] = sel.split('-');
      const titulo = new Date(sel + 'T12:00:00Z').toLocaleDateString('es-UY', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
      const dia = dias.get(sel);
      panel.innerHTML = '';

      const h = document.createElement('div'); h.className = 'dia-panel__head';
      h.innerHTML = `<strong>${titulo}</strong>`;
      panel.appendChild(h);

      if (!dia || !dia.horas.size) {
        const p = document.createElement('p'); p.className = 'dia-vacio';
        p.textContent = 'Este día está cerrado. Abrilo con el horario de la izquierda:';
        panel.appendChild(p);
        panel.appendChild(btnAbrir());
        return;
      }

      const horas = [...dia.horas].sort();
      const wrap = document.createElement('div'); wrap.className = 'turnos';
      for (const hora of horas) {
        const key = `${sel} ${hora}`;
        const res = reservasMap.get(key);
        const t = document.createElement('div');
        t.className = 'turno' + (res ? ' turno--res' : '');
        const lbl = document.createElement('span'); lbl.className = 'turno__h'; lbl.textContent = hora;
        t.appendChild(lbl);
        if (res) {
          const n = document.createElement('span'); n.className = 'turno__nom';
          n.textContent = res.modalidad === 'manual' ? res.nombre : `${res.nombre} (web)`;
          t.appendChild(n);
          if (res.modalidad === 'manual') {
            const lib = document.createElement('button'); lib.className = 'turno__lib'; lib.textContent = 'Liberar';
            lib.addEventListener('click', () => liberar(hora));
            t.appendChild(lib);
          }
        } else {
          const marc = document.createElement('button'); marc.className = 'turno__marc'; marc.textContent = 'Marcar reservado';
          marc.addEventListener('click', () => marcarReservado(hora));
          t.appendChild(marc);
          const quitar = document.createElement('button'); quitar.className = 'turno__x'; quitar.setAttribute('aria-label', 'Quitar este turno'); quitar.title = 'Quitar este turno'; quitar.textContent = '✕';
          quitar.addEventListener('click', () => { dia.horas.delete(hora); if (!dia.horas.size) dias.delete(sel!); marcarSucio(); renderCal(); renderDia(); });
          t.appendChild(quitar);
        }
        wrap.appendChild(t);
      }
      panel.appendChild(wrap);

      const acc = document.createElement('div'); acc.className = 'dia-panel__acc';
      acc.appendChild(btnAbrir('Agregar otro horario'));
      const cerrar = document.createElement('button'); cerrar.className = 'btn btn--ghost btn--sm';
      cerrar.textContent = 'Cerrar este día';
      cerrar.addEventListener('click', () => {
        const conRes = horas.some((hh) => reservasMap.has(`${sel} ${hh}`));
        if (conRes && !confirm('Este día tiene reservas. Si lo cerrás, las reservas siguen pero no se ofrecen más turnos nuevos. ¿Seguir?')) return;
        dias.delete(sel!); marcarSucio(); renderCal(); renderDia();
      });
      acc.appendChild(cerrar);
      panel.appendChild(acc);
    }

    function btnAbrir(txt = 'Abrir con este horario') {
      const b = document.createElement('button'); b.className = 'btn btn--primary btn--sm'; b.textContent = txt;
      b.addEventListener('click', () => {
        const { desde, hasta, dur } = franjaActual();
        const horas = rangoHoras(desde, hasta, dur);
        if (!horas.length) { setMsg('Ese horario no genera turnos: revisá desde/hasta/duración.', 'dirty'); return; }
        const dia = dias.get(sel!) ?? { horas: new Set<string>(), duracion: dur };
        horas.forEach((h) => dia.horas.add(h));
        dia.duracion = dur;
        dias.set(sel!, dia);
        marcarSucio(); renderCal(); renderDia();
      });
      return b;
    }

    // ---------- Reserva manual (acción inmediata) ----------
    async function marcarReservado(hora: string) {
      const nombre = prompt('¿A nombre de quién? (nombre de la persona que reservó)');
      if (!nombre || !nombre.trim()) return;
      const res = await fetch('/api/admin/reserva-manual', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ sede, fecha: sel, hora, nombre: nombre.trim() }),
      });
      if (sesionExpirada(res)) return;
      const d = await res.json().catch(() => ({}));
      if (res.ok) { reservasMap.set(`${sel} ${hora}`, { nombre: nombre.trim(), modalidad: 'manual' }); renderCal(); renderDia(); }
      else alert(d.error || 'No se pudo marcar el turno.');
    }
    async function liberar(hora: string) {
      if (!confirm('¿Liberar este turno? Vuelve a quedar disponible para reservar.')) return;
      const res = await fetch(`/api/admin/reserva-manual?sede=${sede}&fecha=${sel}&hora=${hora}`, { method: 'DELETE' });
      if (res.ok) { reservasMap.delete(`${sel} ${hora}`); renderCal(); renderDia(); }
      else alert('No se pudo liberar el turno.');
    }

    // ---------- Atajo repetir (toggle: si ya está aplicado, lo quita) ----------
    let ultimoAtajo: { firma: string; fechas: string[] } | null = null;
    $('atajo-btn').addEventListener('click', () => {
      const { desde, hasta, dur } = franjaActual();
      const horas = rangoHoras(desde, hasta, dur);
      if (!horas.length) { setMsg('Ese horario no genera turnos: revisá desde/hasta/duración.', 'dirty'); return; }
      const dow = Number(($('atajo-dia') as HTMLInputElement).value); // 0=dom
      const n = Math.max(1, Math.min(26, Number(($('atajo-n') as HTMLInputElement).value)));
      const firma = `${dow}|${n}|${desde}|${hasta}|${dur}`;

      // Fechas objetivo: los próximos N días con ese día de la semana.
      let cur = new Date(hoyUY + 'T12:00:00Z');
      while (cur.getUTCDay() !== dow) cur = new Date(cur.getTime() + 86400000);
      const fechas: string[] = [];
      for (let i = 0; i < n; i++) { fechas.push(cur.toISOString().slice(0, 10)); cur = new Date(cur.getTime() + 7 * 86400000); }

      // ¿Ya está aplicado exactamente esto? Entonces este click lo DESHACE.
      const yaAplicado = ultimoAtajo?.firma === firma &&
        fechas.every((f) => { const d = dias.get(f); return d && horas.every((h) => d.horas.has(h)); });

      if (yaAplicado) {
        for (const f of fechas) { const d = dias.get(f); if (d) { horas.forEach((h) => d.horas.delete(h)); if (!d.horas.size) dias.delete(f); } }
        ultimoAtajo = null;
        setMsg(`Quitado de ${fechas.length} días. Tocá "Repetir" otra vez para volver a agregarlo.`, 'dirty');
      } else {
        for (const f of fechas) { const d = dias.get(f) ?? { horas: new Set<string>(), duracion: dur }; horas.forEach((h) => d.horas.add(h)); d.duracion = dur; dias.set(f, d); }
        ultimoAtajo = { firma, fechas };
        setMsg(`Agregado a ${fechas.length} días. Tocá "Repetir" otra vez para deshacerlo, o Guardar para publicar.`, 'dirty');
      }
      sucio = true; renderCal(); renderDia();
    });

    // ---------- Guardar ----------
    $('guardar').addEventListener('click', async (ev) => {
      const btn = ev.currentTarget as HTMLButtonElement;
      const payload = { sede, dias: [...dias.entries()].map(([fecha, d]) => ({ fecha, horas: [...d.horas], duracion: d.duracion })) };
      btn.disabled = true; setMsg('Guardando…');
      try {
        const res = await fetch('/api/admin/horario', {
          method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload),
        });
        if (sesionExpirada(res)) { btn.disabled = false; return; }
        const d = await res.json().catch(() => ({}));
        if (res.ok) { sucio = false; setMsg(`✓ Guardado (${d.turnos} turnos en ${d.dias} días). Ya está publicado.`, 'ok'); }
        else setMsg(`Error: ${d.error || 'no se pudo'}${d.detalle ? ' — ' + d.detalle : ''}`, 'dirty');
      } catch { setMsg('Sin conexión: no se guardó. Probá de nuevo.', 'dirty'); }
      finally { btn.disabled = false; }
    });

    // ---------- Tabs de sede ----------
    document.querySelectorAll<HTMLButtonElement>('.sede-tab').forEach((tab) => {
      durSede[tab.dataset.sede!] = Number(tab.dataset.dur);
      tab.addEventListener('click', async () => {
        if (sucio && !confirm('Tenés cambios sin guardar en esta sede. ¿Cambiar igual y perderlos?')) return;
        document.querySelectorAll('.sede-tab').forEach((t) => t.classList.remove('is-active'));
        tab.classList.add('is-active');
        await cargarSede(tab.dataset.sede!);
      });
    });

    cargarSede('montevideo');
  }

  // ---------- Agenda consolidada (todas las sedes), semana por semana ----------
  (async function cargarAgenda() {
    const cont = document.getElementById('agenda');
    if (!cont) return;
    const CLS: Record<string, string> = { Montevideo: 'mv', 'San José': 'sj', Online: 'on' };
    const DIA = 86400000;

    // Lunes (12:00Z) de la semana que contiene esa fecha ISO.
    const lunesDe = (iso: string) => {
      const dt = new Date(iso + 'T12:00:00Z');
      const dow = (dt.getUTCDay() + 6) % 7; // 0 = lunes
      dt.setUTCDate(dt.getUTCDate() - dow);
      return dt;
    };
    const isoDe = (dt: Date) => dt.toISOString().slice(0, 10);
    const fmtRango = (mon: Date) => {
      const sun = new Date(mon.getTime() + 6 * DIA);
      if (mon.getUTCMonth() === sun.getUTCMonth()) {
        const mes = mon.toLocaleDateString('es-UY', { month: 'long', timeZone: 'UTC' });
        return `${mon.getUTCDate()} al ${sun.getUTCDate()} de ${mes}`;
      }
      const o = { day: 'numeric', month: 'long', timeZone: 'UTC' } as const;
      return `${mon.toLocaleDateString('es-UY', o)} al ${sun.toLocaleDateString('es-UY', o)}`;
    };

    try {
      const res = await fetch('/api/admin/resumen?dias=56');
      if (res.status === 401) { cont.innerHTML = '<p class="ag-vacia">Ingresá de nuevo para ver la agenda.</p>'; return; }
      const d = await res.json();
      if (!d.ok) { cont.innerHTML = '<p class="ag-vacia">No se pudo cargar la agenda.</p>'; return; }

      // Consolidar: fecha → sede → Map<hora, {reservado, nombre}>
      const porFecha = new Map<string, Map<string, Map<string, any>>>();
      const getSede = (fecha: string, sede: string) => {
        let f = porFecha.get(fecha); if (!f) { f = new Map(); porFecha.set(fecha, f); }
        let s = f.get(sede); if (!s) { s = new Map(); f.set(sede, s); }
        return s;
      };
      for (const fr of d.franjas) { const s = getSede(fr.fecha, fr.sede); if (!s.has(fr.hora)) s.set(fr.hora, { reservado: false }); }
      for (const r of d.reservas) getSede(r.fecha, r.sede).set(r.hora, { reservado: true, nombre: r.nombre });

      const fechas = [...porFecha.keys()].sort();
      if (!fechas.length) { cont.innerHTML = '<p class="ag-vacia">No hay turnos abiertos ni reservas todavía. Cargalos arriba en “Tu disponibilidad”.</p>'; return; }

      // Semanas de lunes a domingo. offset 0 = semana que contiene hoy.
      const baseMon = lunesDe(d.hoy);
      const offsetDe = (iso: string) => Math.round((lunesDe(iso).getTime() - baseMon.getTime()) / (7 * DIA));
      const offsets = fechas.map(offsetDe);
      const minOff = Math.min(...offsets);
      const maxOff = Math.max(...offsets);
      let semana = minOff; // arranca en la semana actual o, si está vacía, la próxima con datos

      // Un bloque por día (misma estructura de siempre).
      function bloqueDia(fecha: string) {
        const titulo = new Date(fecha + 'T12:00:00Z').toLocaleDateString('es-UY', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
        const bloque = document.createElement('div'); bloque.className = 'ag-dia';
        const h = document.createElement('div'); h.className = 'ag-dia__fecha'; h.textContent = titulo; bloque.appendChild(h);
        const sedes = porFecha.get(fecha)!;
        for (const sedeNombre of ['Montevideo', 'San José', 'Online']) {
          const turnos = sedes.get(sedeNombre); if (!turnos) continue;
          const row = document.createElement('div'); row.className = 'ag-sede ag--' + CLS[sedeNombre];
          const lbl = document.createElement('span'); lbl.className = 'ag-sede__nom'; lbl.textContent = sedeNombre; row.appendChild(lbl);
          const chips = document.createElement('div'); chips.className = 'ag-chips';
          for (const hora of [...turnos.keys()].sort()) {
            const t = turnos.get(hora);
            const c = document.createElement('span'); c.className = 'ag-chip' + (t.reservado ? ' ag-chip--res' : '');
            c.textContent = t.reservado ? `${hora} · ${t.nombre}` : hora;
            chips.appendChild(c);
          }
          row.appendChild(chips);
          bloque.appendChild(row);
        }
        return bloque;
      }

      function render() {
        cont!.innerHTML = '';
        const mon = new Date(baseMon.getTime() + semana * 7 * DIA);
        const lunISO = isoDe(mon);
        const domISO = isoDe(new Date(mon.getTime() + 6 * DIA));

        // Encabezado con navegación de semanas.
        const nav = document.createElement('div'); nav.className = 'ag-nav';
        const prev = document.createElement('button');
        prev.className = 'ag-nav__btn'; prev.type = 'button'; prev.textContent = '‹';
        prev.setAttribute('aria-label', 'Semana anterior');
        prev.disabled = semana <= minOff;
        prev.addEventListener('click', () => { if (semana > minOff) { semana--; render(); } });

        const info = document.createElement('div'); info.className = 'ag-nav__info';
        const rango = document.createElement('span'); rango.className = 'ag-nav__rango';
        rango.textContent = 'Semana del ' + fmtRango(mon);
        info.appendChild(rango);
        if (semana === 0) { const b = document.createElement('span'); b.className = 'ag-nav__badge'; b.textContent = 'Esta semana'; info.appendChild(b); }

        const next = document.createElement('button');
        next.className = 'ag-nav__btn'; next.type = 'button'; next.textContent = '›';
        next.setAttribute('aria-label', 'Semana siguiente');
        next.disabled = semana >= maxOff;
        next.addEventListener('click', () => { if (semana < maxOff) { semana++; render(); } });

        nav.appendChild(prev); nav.appendChild(info); nav.appendChild(next);
        cont!.appendChild(nav);

        const dela = fechas.filter((f) => f >= lunISO && f <= domISO);
        if (!dela.length) {
          const p = document.createElement('p'); p.className = 'ag-vacia';
          p.textContent = 'No hay turnos abiertos ni reservas esta semana.';
          cont!.appendChild(p);
          return;
        }
        for (const fecha of dela) cont!.appendChild(bloqueDia(fecha));
      }

      render();
    } catch { cont.innerHTML = '<p class="ag-vacia">No se pudo cargar la agenda.</p>'; }
  })();

  // ---------- Reservas a confirmar (web sin pago, esperan validación de Ceci) ----------
  (async function cargarPorConfirmar() {
    const cont = document.getElementById('por-confirmar');
    if (!cont) return;
    const CLS: Record<string, string> = { Montevideo: 'mv', 'San José': 'sj', Online: 'on' };

    const fmtHold = (expira: string | null) => {
      if (!expira) return '';
      const ms = new Date(expira).getTime() - Date.now();
      if (ms <= 0) return 'venció';
      const min = Math.round(ms / 60000);
      if (min < 60) return `vence en ${min} min`;
      const h = Math.floor(min / 60), mm = min % 60;
      return `vence en ${h} h${mm ? ' ' + mm + ' min' : ''}`;
    };
    const fmtCuando = (fecha: string | null, hora: string | null) => {
      if (!fecha) return 'Membresía · a coordinar';
      const t = new Date(fecha + 'T12:00:00Z').toLocaleDateString('es-UY', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
      return hora ? `${t} · ${hora} h` : t;
    };
    const vaciarSiCorresponde = () => {
      if (!cont.querySelector('.pc-item')) cont.innerHTML = '<p class="ag-vacia">No hay reservas a confirmar por ahora.</p>';
    };
    /** Teléfono uruguayo → link de WhatsApp (098… y 59898… llegan al mismo lado). */
    const waHref = (tel: string, msg: string) =>
      `https://wa.me/598${String(tel).replace(/\D/g, '').replace(/^(598|0)/, '')}?text=${encodeURIComponent(msg)}`;

    /**
     * Al confirmar, el turno ya salió por mail automático. Acá le damos a Ceci el
     * segundo canal que pidió: un WhatsApp a la paciente con el mensaje escrito.
     */
    function mostrarConfirmada(el: HTMLElement, r: any) {
      const cuando = r.fechaLabel ? `${r.fechaLabel}${r.hora ? ' · ' + r.hora + ' h' : ''}` : fmtCuando(r.fecha, r.hora);
      el.classList.add('pc-item--ok');
      el.innerHTML = '';
      const t = document.createElement('div'); t.className = 'pc-ok__t';
      t.textContent = `✓ ${r.nombre}: turno confirmado`;
      const sub = document.createElement('div'); sub.className = 'pc-ok__sub';
      sub.textContent = `${cuando} · le enviamos el mail de confirmación`;
      el.appendChild(t); el.appendChild(sub);

      const acc = document.createElement('div'); acc.className = 'pc-ok__acc';
      if (r.telefono && r.telefono !== '—') {
        const msg = [
          `Hola ${r.nombre}! Te confirmo tu turno:`,
          `• ${r.modalidad}`,
          r.sede ? `• Sede: ${r.sede}` : null,
          `• ${cuando}`,
          '¡Nos vemos! Si necesitás cambiar algo, avisame por acá.',
        ].filter(Boolean).join('\n');
        const wa = document.createElement('a');
        wa.className = 'btn btn--primary btn--sm'; wa.target = '_blank'; wa.rel = 'noopener';
        wa.href = waHref(r.telefono, msg);
        wa.textContent = 'Avisar por WhatsApp';
        acc.appendChild(wa);
      }
      const listo = document.createElement('button');
      listo.className = 'pc-rech'; listo.textContent = 'Listo';
      listo.addEventListener('click', () => { el.remove(); vaciarSiCorresponde(); });
      acc.appendChild(listo);
      el.appendChild(acc);
    }

    function item(r: any) {
      const el = document.createElement('div'); el.className = 'pc-item pc--' + (CLS[r.sede] || 'on');

      const head = document.createElement('div'); head.className = 'pc-item__head';
      const sede = document.createElement('span'); sede.className = 'pc-item__sede'; sede.textContent = r.sede;
      const hold = document.createElement('span'); hold.className = 'pc-item__hold'; hold.textContent = fmtHold(r.expira_at);
      head.appendChild(sede); head.appendChild(hold);

      const nom = document.createElement('div'); nom.className = 'pc-item__nom'; nom.textContent = r.nombre;
      const cuando = document.createElement('div'); cuando.className = 'pc-item__cuando';
      cuando.textContent = `${r.modalidad === 'manual' ? 'Reserva manual' : r.modalidad} · ${fmtCuando(r.fecha, r.hora)}`;

      const tel = document.createElement('div'); tel.className = 'pc-item__tel';
      if (r.telefono && r.telefono !== '—') {
        const a = document.createElement('a'); a.className = 'tel-link'; a.target = '_blank'; a.rel = 'noopener';
        a.href = `https://wa.me/598${String(r.telefono).replace(/\D/g, '').replace(/^(598|0)/, '')}`;
        a.textContent = r.telefono; tel.appendChild(a);
      }

      const ctr = document.createElement('div'); ctr.className = 'pc-ctrls';
      const montoWrap = document.createElement('label'); montoWrap.className = 'pc-monto'; montoWrap.append('$ ');
      const monto = document.createElement('input'); monto.type = 'number'; monto.min = '0'; monto.step = '1'; monto.placeholder = 'monto';
      if (r.precio_uyu != null) monto.value = String(Math.round(Number(r.precio_uyu)));
      montoWrap.appendChild(monto);
      const pagoWrap = document.createElement('label'); pagoWrap.className = 'pc-pago';
      const pago = document.createElement('input'); pago.type = 'checkbox';
      pagoWrap.appendChild(pago); pagoWrap.append(' Ya pagó');
      const conf = document.createElement('button'); conf.className = 'btn btn--primary btn--sm'; conf.textContent = 'Confirmar';
      const rech = document.createElement('button'); rech.className = 'pc-rech'; rech.textContent = 'Rechazar';

      conf.addEventListener('click', async () => {
        conf.disabled = true; rech.disabled = true; conf.textContent = 'Confirmando…';
        try {
          const res = await fetch('/api/admin/reserva-confirmar', {
            method: 'POST', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id: r.id, monto_cobrado: monto.value === '' ? null : Number(monto.value), pagado: pago.checked }),
          });
          if (res.status === 401) { alert('Tu sesión expiró. Recargá la página e ingresá de nuevo.'); return; }
          const d = await res.json().catch(() => ({}));
          if (res.ok && d.ok) { mostrarConfirmada(el, { ...r, ...(d.reserva || {}) }); }
          else { conf.disabled = false; rech.disabled = false; conf.textContent = 'Confirmar'; alert(d.error || 'No se pudo confirmar.'); }
        } catch { conf.disabled = false; rech.disabled = false; conf.textContent = 'Confirmar'; alert('Sin conexión: probá de nuevo.'); }
      });
      rech.addEventListener('click', async () => {
        if (!confirm('¿Rechazar esta reserva? Se libera el cupo para que lo tome otra persona.')) return;
        conf.disabled = true; rech.disabled = true;
        try {
          const res = await fetch('/api/admin/reserva-rechazar', {
            method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: r.id }),
          });
          if (res.status === 401) { alert('Tu sesión expiró. Recargá la página e ingresá de nuevo.'); return; }
          const d = await res.json().catch(() => ({}));
          if (res.ok && d.ok) { el.remove(); vaciarSiCorresponde(); }
          else { conf.disabled = false; rech.disabled = false; alert(d.error || 'No se pudo rechazar.'); }
        } catch { conf.disabled = false; rech.disabled = false; alert('Sin conexión: probá de nuevo.'); }
      });

      ctr.appendChild(montoWrap); ctr.appendChild(pagoWrap); ctr.appendChild(conf); ctr.appendChild(rech);
      el.appendChild(head); el.appendChild(nom); el.appendChild(cuando);
      if (tel.childNodes.length) el.appendChild(tel);
      el.appendChild(ctr);
      return el;
    }

    try {
      const res = await fetch('/api/admin/por-confirmar');
      if (res.status === 401) { cont.innerHTML = '<p class="ag-vacia">Ingresá de nuevo para ver esto.</p>'; return; }
      const d = await res.json();
      if (!d.ok) { cont.innerHTML = '<p class="ag-vacia">No se pudo cargar.</p>'; return; }
      const rs = d.reservas || [];
      if (!rs.length) { cont.innerHTML = '<p class="ag-vacia">No hay reservas a confirmar por ahora.</p>'; return; }
      cont.innerHTML = '';
      for (const r of rs) cont.appendChild(item(r));
    } catch { cont.innerHTML = '<p class="ag-vacia">No se pudo cargar.</p>'; }
  })();

  // ---------- Gestión de turnos (cobro + mensajes + recordatorios) ----------
  (async function cargarGestion() {
    const cont = document.getElementById('gestion');
    if (!cont) return;
    const CLS: Record<string, string> = { Montevideo: 'mv', 'San José': 'sj' };
    const $$ = (n: number | null) => (n == null ? '—' : '$' + n.toLocaleString('es-UY'));
    let datos: any[] = [];

    /** Guarda un campo suelto. Devuelve false y avisa si no se pudo. */
    async function guardar(id: string, campos: Record<string, unknown>): Promise<boolean> {
      try {
        const res = await fetch('/api/admin/gestion', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id, ...campos }),
        });
        if (res.status === 401) { alert('Tu sesión expiró. Recargá la página e ingresá de nuevo.'); return false; }
        const d = await res.json().catch(() => ({}));
        if (!res.ok || !d.ok) { alert(d.error || 'No se pudo guardar.'); return false; }
        return true;
      } catch { alert('Sin conexión: no se pudo guardar.'); return false; }
    }

    function item(r: any) {
      const el = document.createElement('div');
      el.className = 'gs-item gs--' + (CLS[r.sede] || 'on');

      const head = document.createElement('div'); head.className = 'gs-item__head';
      const cuando = document.createElement('span'); cuando.className = 'gs-item__cuando';
      cuando.textContent = `${r.fechaLarga || r.fecha}${r.hora ? ' · ' + r.hora + ' h' : ''}`;
      const sede = document.createElement('span'); sede.className = 'gs-item__sede';
      sede.textContent = r.sede || 'Online';
      head.append(cuando, sede);

      const nom = document.createElement('div'); nom.className = 'gs-item__nom';
      nom.textContent = r.nombre;
      const sub = document.createElement('div'); sub.className = 'gs-item__sub';
      sub.textContent = r.modalidad;
      if (r.telefono && r.telefono !== '—') {
        sub.append(' · ');
        const a = document.createElement('a');
        a.className = 'tel-link'; a.target = '_blank'; a.rel = 'noopener';
        a.href = `https://wa.me/598${String(r.telefono).replace(/\D/g, '').replace(/^(598|0)/, '')}`;
        a.textContent = r.telefono;
        sub.appendChild(a);
      }

      // --- Cobro: total acordado, seña recibida, forma de pago, saldo ---
      const cobro = document.createElement('div'); cobro.className = 'gs-cobro';
      const campo = (label: string, valor: number | null, onSave: (v: number | null) => void) => {
        const w = document.createElement('label'); w.className = 'gs-campo';
        const t = document.createElement('span'); t.textContent = label;
        const i = document.createElement('input');
        i.type = 'number'; i.min = '0'; i.step = '1'; i.placeholder = '—';
        if (valor != null) i.value = String(Math.round(valor));
        i.addEventListener('change', () => onSave(i.value === '' ? null : Number(i.value)));
        w.append(t, i);
        return w;
      };

      const saldoEl = document.createElement('div'); saldoEl.className = 'gs-saldo';
      const estadoEl = document.createElement('span'); estadoEl.className = 'gs-estado';
      const pintarEstado = () => {
        const total = r.total, sena = r.senaPagada;
        r.saldo = total != null ? Math.max(0, total - (sena ?? 0)) : null;
        saldoEl.innerHTML = `<span>Saldo</span><strong>${$$(r.saldo)}</strong>`;
        const clase = sena == null || sena === 0 ? 'sin' : r.saldo === 0 ? 'full' : 'parcial';
        estadoEl.className = 'gs-estado gs-estado--' + clase;
        estadoEl.textContent = clase === 'sin' ? 'Sin seña' : clase === 'full' ? 'Pago completo' : 'Señado';
      };

      cobro.appendChild(campo('Total acordado', r.total, async (v) => {
        if (await guardar(r.id, { total_acordado: v })) { r.total = v; pintarEstado(); }
      }));
      cobro.appendChild(campo('Seña recibida', r.senaPagada, async (v) => {
        if (await guardar(r.id, { sena_pagada: v })) { r.senaPagada = v; pintarEstado(); }
      }));

      const formaW = document.createElement('label'); formaW.className = 'gs-campo';
      const formaT = document.createElement('span'); formaT.textContent = 'Cómo pagó';
      const forma = document.createElement('select');
      [['', '—'], ['mercadopago', 'MercadoPago'], ['transferencia', 'BROU'], ['efectivo', 'Efectivo']]
        .forEach(([v, t]) => { const o = document.createElement('option'); o.value = v; o.textContent = t; forma.appendChild(o); });
      forma.value = r.formaPago || '';
      forma.addEventListener('change', () => guardar(r.id, { forma_pago: forma.value || null }));
      formaW.append(formaT, forma);
      cobro.appendChild(formaW);
      cobro.appendChild(saldoEl);

      // --- Generador de mensajes ---
      const msg = document.createElement('div'); msg.className = 'gs-msg';
      const sel = document.createElement('select'); sel.className = 'gs-msg__sel';
      [['confirmacion', 'Confirmación de turno'], ['transferencia', 'Datos para transferir'],
       ['recordatorio', 'Recordatorio'], ['reprogramar', 'Reprogramar']]
        .forEach(([v, t]) => { const o = document.createElement('option'); o.value = v; o.textContent = t; sel.appendChild(o); });
      const gen = document.createElement('button'); gen.className = 'btn btn--ghost btn--sm'; gen.textContent = 'Generar mensaje';
      const caja = document.createElement('div'); caja.className = 'gs-msg__caja'; caja.hidden = true;
      const ta = document.createElement('textarea'); ta.className = 'gs-msg__ta'; ta.rows = 12;
      const acc = document.createElement('div'); acc.className = 'gs-msg__acc';
      const copiar = document.createElement('button'); copiar.className = 'btn btn--primary btn--sm'; copiar.textContent = 'Copiar';
      const waBtn = document.createElement('a'); waBtn.className = 'btn btn--ghost btn--sm'; waBtn.target = '_blank'; waBtn.rel = 'noopener'; waBtn.textContent = 'Abrir WhatsApp';
      acc.append(copiar, waBtn);
      caja.append(ta, acc);

      gen.addEventListener('click', async () => {
        gen.disabled = true; gen.textContent = 'Generando…';
        try {
          const res = await fetch('/api/admin/mensaje', {
            method: 'POST', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id: r.id, plantilla: sel.value }),
          });
          if (res.status === 401) { alert('Tu sesión expiró. Recargá la página e ingresá de nuevo.'); return; }
          const d = await res.json().catch(() => ({}));
          if (!res.ok || !d.ok) { alert(d.error || 'No se pudo generar.'); return; }
          ta.value = d.texto;
          caja.hidden = false;
          if (d.wa) { waBtn.href = d.wa; waBtn.hidden = false; } else { waBtn.hidden = true; }
        } catch { alert('Sin conexión: probá de nuevo.'); }
        finally { gen.disabled = false; gen.textContent = 'Generar mensaje'; }
      });
      copiar.addEventListener('click', async () => {
        // El texto puede haberse editado a mano antes de copiar: se copia el textarea.
        try { await navigator.clipboard.writeText(ta.value); }
        catch { ta.select(); document.execCommand('copy'); }
        copiar.textContent = '¡Copiado!';
        setTimeout(() => { copiar.textContent = 'Copiar'; }, 1600);
      });
      // Al mandar el WhatsApp damos por recordada a la paciente: es el mismo
      // registro que usa el cron, así que no le llega el mail duplicado.
      waBtn.addEventListener('click', () => {
        if (sel.value !== 'recordatorio' || r.recordatorioAt) return;
        guardar(r.id, { recordado: true }).then((ok) => { if (ok) { r.recordatorioAt = new Date().toISOString(); pintarRec(); } });
      });

      const pie = document.createElement('div'); pie.className = 'gs-pie';
      const rec = document.createElement('button'); rec.className = 'gs-rec';
      const pintarRec = () => {
        rec.textContent = r.recordatorioAt ? '✓ recordada' : 'marcar como recordada';
        rec.classList.toggle('is-on', !!r.recordatorioAt);
      };
      rec.addEventListener('click', async () => {
        const nuevo = !r.recordatorioAt;
        if (await guardar(r.id, { recordado: nuevo })) { r.recordatorioAt = nuevo ? new Date().toISOString() : null; pintarRec(); }
      });
      pintarRec();
      pie.append(estadoEl, rec);

      msg.append(sel, gen, caja);
      el.append(head, nom, sub, cobro, msg, pie);
      pintarEstado();
      return el;
    }

    function render() {
      const soloDeuda = (document.getElementById('gs-solo-deuda') as HTMLInputElement)?.checked;
      const soloPronto = (document.getElementById('gs-solo-pronto') as HTMLInputElement)?.checked;
      const limite = new Date(Date.now() - 3 * 3600 * 1000 + 7 * 24 * 3600 * 1000).toISOString().slice(0, 10);
      const lista = datos.filter((r) => {
        if (soloDeuda && !(r.saldo != null && r.saldo > 0)) return false;
        if (soloPronto && r.fecha > limite) return false;
        return true;
      });
      cont.innerHTML = '';
      if (!lista.length) {
        cont.innerHTML = '<p class="ag-vacia">No hay turnos que mostrar con estos filtros.</p>';
        return;
      }
      for (const r of lista) cont.appendChild(item(r));
    }

    document.getElementById('gs-solo-deuda')?.addEventListener('change', render);
    document.getElementById('gs-solo-pronto')?.addEventListener('change', render);

    try {
      const res = await fetch('/api/admin/gestion');
      if (res.status === 401) { cont.innerHTML = '<p class="ag-vacia">Ingresá de nuevo para ver esto.</p>'; return; }
      const d = await res.json();
      if (!d.ok) { cont.innerHTML = '<p class="ag-vacia">No se pudo cargar.</p>'; return; }
      datos = d.reservas || [];
      if (!datos.length) { cont.innerHTML = '<p class="ag-vacia">No hay turnos confirmados próximos.</p>'; return; }
      render();
    } catch { cont.innerHTML = '<p class="ag-vacia">No se pudo cargar.</p>'; }
  })();

  // ---------- Borrar reserva (tabla) ----------
  document.querySelectorAll('.del').forEach((b) => {
    b.addEventListener('click', async () => {
      if (!confirm('¿Borrar esta reserva? Se libera el cupo y se quita del calendario.')) return;
      const btn = b as HTMLButtonElement;
      const orig = btn.textContent;
      btn.disabled = true; btn.textContent = 'Borrando…';
      try {
        const res = await fetch(`/api/admin/reserva?id=${btn.dataset.id}`, { method: 'DELETE' });
        if (res.ok) { btn.closest('tr')?.remove(); return; }
        alert('No se pudo borrar. Probá de nuevo.');
      } catch { alert('Sin conexión: no se pudo borrar.'); }
      btn.disabled = false; btn.textContent = orig;
    });
  });

  // ---------- Marcar cobrado / pendiente en una reserva confirmada (seguimiento) ----------
  document.querySelectorAll<HTMLButtonElement>('.pago-tog').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const pagadoActual = btn.dataset.pagado === '1';
      const nuevo = !pagadoActual;
      let monto: number | null = btn.dataset.monto ? Number(btn.dataset.monto) : null;
      if (!Number.isFinite(monto as number)) monto = null;
      // Al pasar a "cobrado" sin monto anotado, ofrecemos registrarlo.
      if (nuevo && monto == null) {
        const v = prompt('¿Monto cobrado? (opcional, en $)');
        if (v && v.trim() && Number.isFinite(Number(v))) monto = Math.round(Number(v));
      }
      const orig = btn.textContent;
      btn.disabled = true; btn.textContent = '…';
      try {
        const res = await fetch('/api/admin/reserva-pago', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id: btn.dataset.id, pagado: nuevo, monto_cobrado: monto }),
        });
        if (res.status === 401) { alert('Tu sesión expiró. Recargá la página e ingresá de nuevo.'); btn.disabled = false; btn.textContent = orig; return; }
        const d = await res.json().catch(() => ({}));
        if (res.ok && d.ok) {
          btn.dataset.pagado = nuevo ? '1' : '0';
          btn.dataset.monto = monto != null ? String(monto) : '';
          btn.textContent = (nuevo ? '✓ cobrado' : 'pendiente') + (monto != null ? ' $' + monto : '');
        } else { btn.textContent = orig; alert(d.error || 'No se pudo actualizar el cobro.'); }
      } catch { btn.textContent = orig; alert('Sin conexión: probá de nuevo.'); }
      btn.disabled = false;
    });
  });
</script>

