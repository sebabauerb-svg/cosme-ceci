  .sede-tab { font: inherit; font-weight: 600; font-size: 0.88rem; padding: 0.5rem 1.1rem; border: 0; border-radius: 10px; background: none; color: var(--ink-soft); cursor: pointer; transition: background 0.18s ease, color 0.18s ease, box-shadow 0.18s ease; }
  .sede-tab:hover { color: var(--ink); }
  .sede-tab.is-active { background: var(--white); color: var(--sage-deep); box-shadow: 0 1px 3px rgba(42, 48, 43, 0.08); }
  .sede-tab:focus-visible { outline: 2px solid var(--sage); outline-offset: 2px; }

  /* Layout disponibilidad */
  .disp { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: 1.5rem; align-items: start; }
  @media (max-width: 760px) { .disp { grid-template-columns: 1fr; } }
  .disp__cal { display: flex; flex-direction: column; gap: 0.9rem; }

  /* Franja horaria — toolbar */
  .franja { background: var(--white); border: 1px solid var(--sand); border-radius: var(--radius); padding: 0.95rem 1.1rem; }
  .franja__lbl { display: block; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: 0.7rem; }
  .franja__ctrl { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem 0.55rem; }
  .franja select { font: inherit; font-variant-numeric: tabular-nums; padding: 0.45rem 0.6rem; border: 1px solid var(--sand); border-radius: var(--radius-sm); background: var(--white); color: var(--ink); cursor: pointer; }
  .franja select:focus-visible { outline: 2px solid var(--sage); outline-offset: 1px; border-color: var(--sage); }
  .franja__sep { font-size: 0.9rem; color: var(--ink-soft); }
  .franja__prev { margin-left: auto; font-size: 0.78rem; font-weight: 600; color: var(--sage-deep); background: color-mix(in srgb, var(--sage) 14%, var(--white)); padding: 0.3rem 0.7rem; border-radius: 999px; white-space: nowrap; }
  .franja__prev--warn { color: var(--clay-deep); background: color-mix(in srgb, var(--clay) 14%, var(--white)); }

  /* Atajo */
  .atajo { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; font-size: 0.85rem; color: var(--ink-soft); padding: 0 0.25rem; }
  .atajo__lbl { font-size: 0.85rem; }
  .atajo select, .atajo input { font: inherit; padding: 0.35rem 0.45rem; border: 1px solid var(--sand); border-radius: var(--radius-sm); background: var(--white); color: var(--ink); }
