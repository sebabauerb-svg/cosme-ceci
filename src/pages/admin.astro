  .lg--res { position: relative; background: var(--cream-deep); }
  .lg--res::after { content: ''; position: absolute; bottom: 2px; left: 50%; transform: translateX(-50%); width: 4px; height: 4px; border-radius: 50%; background: var(--clay); }
  .lg--sel { background: var(--white); box-shadow: inset 0 0 0 2px var(--ink); }

