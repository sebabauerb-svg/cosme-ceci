---
export const prerender = false;

import Base from '../layouts/Base.astro';
import { isAdmin } from '../lib/admin';
import { getSql, ensureFranjas, ensureDuracionMin } from '../lib/db';

const authed = isAdmin(Astro.cookies);

const LUGARES = [
  { slug: 'montevideo', nombre: 'Montevideo' },
  { slug: 'san-jose', nombre: 'San José' },
  { slug: 'online', nombre: 'Online (Virtual / Skincare Inteligente)' },
];
// Duración por defecto sugerida al abrir un rango nuevo (Ceci puede cambiarla)
const SEDE_INTERVALO: Record<string, number> = { montevideo: 45, 'san-jose': 30, online: 30 };

// Calendario de los próximos meses para que Ceci marque sus días.
// "Hoy" en hora de Uruguay (UTC-3): el runtime corre en UTC y de 21:00 a 24:00
// el panel correría un día.
const HOY_ISO = new Date(Date.now() - 3 * 3600 * 1000).toISOString().slice(0, 10);
const WD = ['L', 'M', 'X', 'J', 'V', 'S', 'D'];
type Celda = { iso: string; day: number; sel: boolean } | null;
function calMeses(cant: number) {
  const out: { label: string; cells: Celda[] }[] = [];
  const base = new Date(Date.now() - 3 * 3600 * 1000);
  let y = base.getUTCFullYear();
  let mo = base.getUTCMonth();
  for (let i = 0; i < cant; i++) {
    const firstDow = new Date(Date.UTC(y, mo, 1)).getUTCDay();
    const offset = (firstDow + 6) % 7;
    const ndays = new Date(Date.UTC(y, mo + 1, 0)).getUTCDate();
    const cells: Celda[] = [];
    for (let k = 0; k < offset; k++) cells.push(null);
    for (let day = 1; day <= ndays; day++) {
      const iso = `${y}-${String(mo + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
      cells.push({ iso, day, sel: iso >= HOY_ISO });
    }
    out.push({
      label: new Date(Date.UTC(y, mo, 1)).toLocaleDateString('es-UY', { month: 'long', year: 'numeric', timeZone: 'UTC' }),
      cells,
    });
    mo++; if (mo > 11) { mo = 0; y++; }
  }
  return out;
}
const CAL = calMeses(3);

// Fecha legible para la tabla de reservas (ej. "mié 15 jul")
function fmtFechaTabla(iso?: string | null) {
  if (!iso) return '—';
  try {
    return new Date(iso + 'T12:00:00Z').toLocaleDateString('es-UY', {
      weekday: 'short',
      day: 'numeric',
      month: 'short',
      timeZone: 'UTC',
    });
  } catch {
    return iso;
  }
}

// Cada día guarda su propio set de horas y su propia duración de consulta
// (no todos los días tienen el mismo horario ni la misma duración)
type DiaConfig = { horas: string[]; duracion: number };
const config: Record<string, { dias: Record<string, DiaConfig>; llenas: Set<string> }> = {
  montevideo: { dias: {}, llenas: new Set() },
  'san-jose': { dias: {}, llenas: new Set() },
  online: { dias: {}, llenas: new Set() },
};
let reservas: any[] = [];
let dbError = '';

if (authed) {
  try {
    const sql = getSql();
    await ensureFranjas(sql);
    await ensureDuracionMin(sql);
    const fr = await sql`
      select coalesce(s.nombre, 'Online') as lugar, f.fecha::text as fecha,
             to_char(f.hora,'HH24:MI') as hora, f.duracion_min as duracion
      from franjas f left join sedes s on s.id = f.sede_id
      where f.fecha >= current_date
      order by f.fecha, f.hora
    `;
    const map: Record<string, string> = { Montevideo: 'montevideo', 'San José': 'san-jose', Online: 'online' };
    // Horas guardadas de cada fecha (para precargar el calendario tal cual quedó).
    // La duración se toma del primer turno del día (una franja se abre entera con
    // un mismo rango+duración; si hubiera datos mezclados, prevalece el primero).
    for (const r of fr as any[]) {
      const slug = map[r.lugar] ?? 'online';
      const dia = (config[slug].dias[r.fecha] ??= { horas: [], duracion: Number(r.duracion) || 30 });
      dia.horas.push(r.hora);
    }
    const bl = await sql`
      select coalesce(s.nombre, 'Online') as lugar, b.fecha::text as fecha
      from bloqueos b left join sedes s on s.id = b.sede_id
      where b.fecha >= current_date
    `;
    for (const r of bl as any[]) {
      const slug = map[r.lugar] ?? 'online';
      config[slug].llenas.add(r.fecha);
    }
    reservas = (await sql`
      select r.id, r.modalidad, coalesce(s.nombre, 'Online') as sede,
             r.fecha::text as fecha, to_char(r.hora,'HH24:MI') as hora,
             r.nombre, r.telefono, r.estado
      from reservas r left join sedes s on s.id = r.sede_id
      order by r.created_at desc limit 50
    `) as any[];
  } catch (e) {
    dbError = e instanceof Error ? e.message : String(e);
  }
}
---

<Base title="Panel de Ceci" path="/admin">
  <main class="admin">
    <div class="container">
      {!authed ? (
        <div class="login">
          <h1>Panel de Ceci</h1>
          <p>Ingresá tu contraseña para administrar horarios y ver reservas.</p>
          <form id="login-form">
            <label class="login__label">Contraseña
              <input type="password" name="password" autocomplete="current-password" required />
            </label>
            <button type="submit" class="btn btn--primary">Entrar</button>
          </form>
          <p id="login-error" class="login__err" hidden></p>
        </div>
      ) : (
        <div class="panel">
          <header class="panel__head">
            <h1>Panel de Ceci</h1>
            <button id="logout" class="btn btn--ghost">Salir</button>
          </header>

          {dbError && <p class="login__err">Error de base de datos: {dbError}</p>}

          <section class="card">
            <h2>Tu disponibilidad</h2>
            <p class="muted">Para cada lugar: <strong>tocá los días</strong> que querés abrir, elegí el <strong>rango horario</strong> y la <strong>duración</strong> de cada consulta, y tocá <strong>Aplicar</strong>: el sistema arma los turnos solo. Podés marcar días como <strong>llenos</strong>. Las clientas solo verán lo que marques. <strong>Nada se guarda hasta que tocás “Confirmar”.</strong></p>

            {LUGARES.map((lugar) => (
              <div class="sede-block" data-sede={lugar.slug}>
                <div class="sede-block__top">
                  <h3>{lugar.nombre}</h3>
                  <span class="dirty-flag" data-dirty={lugar.slug} hidden>● Cambios sin confirmar</span>
                </div>

                <p class="hint">1) Tocá los días que querés editar (se resaltan). &nbsp; 2) Elegí desde/hasta y la duración de la consulta. &nbsp; 3) Tocá <b>Aplicar</b>. &nbsp; Repetí con otros días si tienen otro horario.</p>

                <div class="acals">
                  {CAL.map((mes) => (
                    <div class="acal">
                      <div class="acal__head">{mes.label}</div>
                      <div class="acal__grid">
                        {WD.map((w) => <div class="acal__wd">{w}</div>)}
                        {mes.cells.map((c) => {
                          if (!c) return <div class="acal__cell acal__cell--empty"></div>;
                          if (!c.sel) return <div class="acal__cell acal__cell--past">{c.day}</div>;
                          const dia = config[lugar.slug].dias[c.iso];
                          const horas = dia?.horas ?? [];
                          const duracion = dia?.duracion ?? SEDE_INTERVALO[lugar.slug];
                          const lleno = config[lugar.slug].llenas.has(c.iso);
                          const st = lleno ? 'lleno' : horas.length ? 'horas' : '';
                          const hstr = horas.join(',');
                          return (
                            <button
                              type="button"
                              class:list={['acal__cell', 'acal__cell--btn', st && `is-${st}`]}
                              data-lugar={lugar.slug}
                              data-fecha={c.iso}
                              data-state={st}
                              data-horas={hstr}
                              data-duracion={String(duracion)}
                              data-saved-state={st}
                              data-saved-horas={hstr}
                              data-saved-duracion={String(duracion)}
                            >{c.day}</button>
                          );
                        })}
                      </div>
                    </div>
                  ))}
                </div>

                <div class="editor" data-editor={lugar.slug}>
                  <p class="editor__count" data-count={lugar.slug}>Tocá uno o más días para elegir sus horarios.</p>
                  <div class="rango">
                    <label class="rango__f">Desde
                      <input type="time" data-desde value="08:00" step="300" />
                    </label>
                    <label class="rango__f">Hasta
                      <input type="time" data-hasta value="20:00" step="300" />
                    </label>
                    <label class="rango__f">Duración de la consulta
                      <span class="rango__dur">
                        <input type="number" data-duracion min="5" max="240" step="5" value={SEDE_INTERVALO[lugar.slug]} /> min
                      </span>
                    </label>
                  </div>
                  <p class="rango__preview" data-preview aria-live="polite"></p>
                  <div class="editor__actions">
                    <button type="button" class="btn btn--primary btn--sm" data-aplicar={lugar.slug}>Aplicar a los días elegidos</button>
                    <button type="button" class="btn btn--ghost btn--sm" data-lleno={lugar.slug}>Marcar lleno</button>
                    <button type="button" class="btn btn--ghost btn--sm" data-quitar={lugar.slug}>Quitar día</button>
                    <button type="button" class="link-btn" data-deselect={lugar.slug}>Deseleccionar</button>
                  </div>
                </div>

                <p class="resumen" data-resumen={lugar.slug}></p>

                <div class="sede-actions">
                  <button class="btn btn--primary btn--sm" data-confirmar={lugar.slug}>Confirmar {lugar.nombre}</button>
                  <button class="btn btn--ghost btn--sm" data-descartar={lugar.slug}>Descartar cambios</button>
                  <span class="sede-msg" data-msg={lugar.slug}></span>
                </div>
              </div>
            ))}
          </section>

          <section class="card">
            <h2>Reservas ({reservas.length})</h2>
            {reservas.length === 0 ? (
              <p class="muted">Todavía no hay reservas.</p>
            ) : (
              <div class="grid-wrap">
                <table class="grid grid--res">
                  <thead>
                    <tr><th>Servicio</th><th>Sede</th><th>Día</th><th>Hora</th><th>Nombre</th><th>WhatsApp</th><th>Estado</th><th></th></tr>
                  </thead>
                  <tbody>
                    {reservas.map((r) => (
                      <tr>
                        <td>{r.modalidad}</td>
                        <td>{r.sede}</td>
                        <td>{fmtFechaTabla(r.fecha)}</td>
                        <td>{r.hora ?? '—'}</td>
                        <td>{r.nombre}</td>
                        <td>{r.telefono ? (
                          <a
                            class="tel-link"
                            href={`https://wa.me/598${String(r.telefono).replace(/\D/g, '').replace(/^(598|0)/, '')}`}
                            target="_blank"
                            rel="noopener"
                          >{r.telefono}</a>
                        ) : '—'}</td>
                        <td><span class={`badge badge--${r.estado}`}>{r.estado}</span></td>
                        <td><button class="del" data-id={r.id}>Borrar</button></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>
        </div>
      )}
    </div>
  </main>
</Base>

<script>
  const lf = document.getElementById('login-form');
  lf?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = document.getElementById('login-error');
    const pw = (lf.querySelector('input[name="password"]') as HTMLInputElement).value;
    const res = await fetch('/api/admin/login', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ password: pw }),
    });
    if (res.ok) location.reload();
    else {
      const d = await res.json().catch(() => ({}));
      if (err) { err.textContent = d.error || 'No se pudo entrar.'; err.hidden = false; }
    }
  });

  document.getElementById('logout')?.addEventListener('click', async () => {
    await fetch('/api/admin/login', { method: 'DELETE' });
    location.reload();
  });

  // ----- Disponibilidad: seleccionar días + generar horarios por rango -----
  // Genera los horarios de inicio entre "desde" y "hasta" separados por
  // "duracion" minutos, exigiendo que cada consulta termine antes de "hasta"
  // (ej. 8 a 10 con 30 min → 08:00, 08:30, 09:00, 09:30).
  function rangoHoras(desde: string, hasta: string, duracion: number): string[] {
    if (!desde || !hasta || !duracion || duracion <= 0) return [];
    const [dh, dm] = desde.split(':').map(Number);
    const [hh, hm] = hasta.split(':').map(Number);
    const fin = hh * 60 + hm;
    const out: string[] = [];
    for (let t = dh * 60 + dm; t + duracion <= fin; t += duracion) {
      out.push(`${String(Math.floor(t / 60)).padStart(2, '0')}:${String(t % 60).padStart(2, '0')}`);
    }
    return out;
  }
  const fmtDia = (iso: string) => { const [, m, d] = iso.split('-'); return `${+d}/${+m}`; };
  const cellsDe = (b: HTMLElement) => [...b.querySelectorAll('.acal__cell--btn')] as HTMLElement[];
  const selDe = (b: HTMLElement) => cellsDe(b).filter((c) => c.classList.contains('is-sel'));
  const horasDe = (c: HTMLElement) => (c.dataset.horas ? c.dataset.horas.split(',') : []);

  // Pone el estado de un día: '' (libre), 'horas' (con horarios+duración) o 'lleno'
  function setState(cell: HTMLElement, state: string, horas: string[] = [], duracion?: number) {
    cell.classList.remove('is-horas', 'is-lleno');
    cell.dataset.state = state;
    cell.dataset.horas = state === 'horas' ? horas.join(',') : '';
    if (state === 'horas' && duracion) cell.dataset.duracion = String(duracion);
    if (state) cell.classList.add('is-' + state);
  }
  function estaSucio(block: HTMLElement) {
    return cellsDe(block).some(
      (c) =>
        (c.dataset.state || '') !== (c.dataset.savedState || '') ||
        (c.dataset.horas || '') !== (c.dataset.savedHoras || '') ||
        (c.dataset.state === 'horas' && (c.dataset.duracion || '') !== (c.dataset.savedDuracion || ''))
    );
  }
  function etiquetaHoras(horas: string[], duracion: string) {
    return `${horas.length} turno${horas.length > 1 ? 's' : ''} de ${duracion} min (${horas[0]}–${horas[horas.length - 1]})`;
  }

  function refrescar(block: HTMLElement) {
    const sede = block.dataset.sede!;
    // Agrupar días disponibles por su firma (horas + duración)
    const grupos: Record<string, { horas: string[]; duracion: string; dias: string[] }> = {};
    const llenos: string[] = [];
    let turnos = 0;
    for (const c of cellsDe(block)) {
      if (c.dataset.state === 'lleno') { llenos.push(c.dataset.fecha!); continue; }
      if (c.dataset.state === 'horas') {
        const duracion = c.dataset.duracion || '30';
        const sig = `${duracion}|${c.dataset.horas || ''}`;
        (grupos[sig] ??= { horas: horasDe(c), duracion, dias: [] }).dias.push(c.dataset.fecha!);
        turnos += horasDe(c).length;
      }
    }
    const partes: string[] = [];
    for (const sig of Object.keys(grupos).sort()) {
      const g = grupos[sig];
      const dias = g.dias.sort().map(fmtDia).join(', ');
      partes.push(`<b>${etiquetaHoras(g.horas, g.duracion)}</b> (${g.dias.length} día${g.dias.length > 1 ? 's' : ''}): ${dias}`);
    }
    if (llenos.length) partes.push(`<b class="res-lleno">Llenos</b> (${llenos.length}): ${llenos.sort().map(fmtDia).join(', ')}`);

    const res = block.querySelector(`[data-resumen="${sede}"]`) as HTMLElement;
    if (res) res.innerHTML = partes.length
      ? partes.join('<br>') + `<br><span class="resumen__tot">${turnos} turnos para reservar</span>`
      : '<span class="resumen__vacio">Sin días marcados.</span>';

    const flag = block.querySelector(`[data-dirty="${sede}"]`) as HTMLElement;
    if (flag) flag.hidden = !estaSucio(block);
  }

  function actualizarSeleccion(block: HTMLElement) {
    const sede = block.dataset.sede!;
    const sel = selDe(block);
    const cnt = block.querySelector(`[data-count="${sede}"]`) as HTMLElement;
    if (cnt) cnt.textContent = sel.length
      ? `${sel.length} día${sel.length > 1 ? 's' : ''} seleccionado${sel.length > 1 ? 's' : ''}: elegí el rango y tocá Aplicar.`
      : 'Tocá uno o más días para elegir sus horarios.';
    // Si hay un único día seleccionado con horarios, precargamos su rango en
    // los inputs para poder ajustarlo. Con varios días (o ninguno) el rango
    // tipeado se deja como está: es lo que se va a aplicar a todos.
    const desde = block.querySelector('[data-desde]') as HTMLInputElement;
    const hasta = block.querySelector('[data-hasta]') as HTMLInputElement;
    const dur = block.querySelector('[data-duracion]') as HTMLInputElement;
    if (sel.length === 1 && sel[0].dataset.state === 'horas') {
      const horas = horasDe(sel[0]);
      const duracion = Number(sel[0].dataset.duracion) || 30;
      if (desde && horas.length) desde.value = horas[0];
      if (dur) dur.value = String(duracion);
      if (hasta && horas.length) {
        const [h, m] = horas[horas.length - 1].split(':').map(Number);
        const finMin = h * 60 + m + duracion;
        hasta.value = `${String(Math.floor(finMin / 60) % 24).padStart(2, '0')}:${String(finMin % 60).padStart(2, '0')}`;
      }
    }
    actualizarPreview(block);
  }

  function actualizarPreview(block: HTMLElement) {
    const desde = (block.querySelector('[data-desde]') as HTMLInputElement)?.value;
    const hasta = (block.querySelector('[data-hasta]') as HTMLInputElement)?.value;
    const duracion = Number((block.querySelector('[data-duracion]') as HTMLInputElement)?.value);
    const prev = block.querySelector('[data-preview]') as HTMLElement;
    if (!prev) return;
    const horas = rangoHoras(desde, hasta, duracion);
    if (!desde || !hasta || !duracion) {
      prev.textContent = '';
    } else if (!horas.length) {
      prev.textContent = 'Ese rango no entra ni un turno: revisá desde/hasta/duración.';
    } else {
      prev.textContent = `Se van a crear ${horas.length} turno${horas.length > 1 ? 's' : ''}: ${horas.join(', ')}`;
    }
  }

  document.querySelectorAll<HTMLElement>('.sede-block').forEach((block) => {
    const sede = block.dataset.sede!;
    const msg = () => block.querySelector(`[data-msg="${sede}"]`) as HTMLElement;

    // Seleccionar/deseleccionar días
    cellsDe(block).forEach((cell) =>
      cell.addEventListener('click', () => {
        cell.classList.toggle('is-sel');
        actualizarSeleccion(block);
      })
    );

    // Vista previa en vivo del rango
    ['[data-desde]', '[data-hasta]', '[data-duracion]'].forEach((sel) => {
      block.querySelector(sel)?.addEventListener('input', () => actualizarPreview(block));
    });

    // Aplicar el rango generado a los días seleccionados
    block.querySelector(`[data-aplicar="${sede}"]`)?.addEventListener('click', () => {
      const sel = selDe(block);
      if (!sel.length) { if (msg()) msg().textContent = 'Primero tocá los días a editar.'; return; }
      const desde = (block.querySelector('[data-desde]') as HTMLInputElement)?.value;
      const hasta = (block.querySelector('[data-hasta]') as HTMLInputElement)?.value;
      const duracion = Number((block.querySelector('[data-duracion]') as HTMLInputElement)?.value);
      const horas = rangoHoras(desde, hasta, duracion);
      if (!horas.length) { if (msg()) msg().textContent = 'Ese rango no genera ningún turno: revisá desde/hasta/duración.'; return; }
      sel.forEach((c) => { setState(c, 'horas', horas, duracion); c.classList.remove('is-sel'); });
      if (msg()) msg().textContent = '';
      actualizarSeleccion(block); refrescar(block);
    });

    // Marcar seleccionados como llenos
    block.querySelector(`[data-lleno="${sede}"]`)?.addEventListener('click', () => {
      const sel = selDe(block);
      if (!sel.length) { if (msg()) msg().textContent = 'Primero tocá los días.'; return; }
      sel.forEach((c) => { setState(c, 'lleno'); c.classList.remove('is-sel'); });
      actualizarSeleccion(block); refrescar(block);
    });

    // Quitar disponibilidad de los seleccionados (vuelven a libres)
    block.querySelector(`[data-quitar="${sede}"]`)?.addEventListener('click', () => {
      const sel = selDe(block);
      if (!sel.length) { if (msg()) msg().textContent = 'Primero tocá los días.'; return; }
      sel.forEach((c) => { setState(c, ''); c.classList.remove('is-sel'); });
      actualizarSeleccion(block); refrescar(block);
    });

    // Deseleccionar
    block.querySelector(`[data-deselect="${sede}"]`)?.addEventListener('click', () => {
      cellsDe(block).forEach((c) => c.classList.remove('is-sel'));
      actualizarSeleccion(block);
    });

    // Descartar cambios → vuelve a lo último confirmado (no toca la base)
    block.querySelector(`[data-descartar="${sede}"]`)?.addEventListener('click', () => {
      cellsDe(block).forEach((c) => {
        c.classList.remove('is-sel');
        const st = c.dataset.savedState || '';
        setState(c, st, st === 'horas' ? (c.dataset.savedHoras || '').split(',').filter(Boolean) : [], Number(c.dataset.savedDuracion) || undefined);
      });
      if (msg()) msg().textContent = '';
      actualizarSeleccion(block); refrescar(block);
    });

    // Confirmar → guarda la foto completa de la sede
    block.querySelector(`[data-confirmar="${sede}"]`)?.addEventListener('click', async (ev) => {
      const btn = ev.currentTarget as HTMLButtonElement;
      const cells = cellsDe(block);
      const dias = cells
        .filter((c) => c.dataset.state === 'horas')
        .map((c) => ({ fecha: c.dataset.fecha, horas: horasDe(c), duracionMin: Number(c.dataset.duracion) || 30 }));
      const llenas = cells.filter((c) => c.dataset.state === 'lleno').map((c) => c.dataset.fecha);
      btn.disabled = true;
      if (msg()) msg().textContent = 'Guardando…';
      try {
        const res = await fetch('/api/admin/disponibilidad', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ lugar: sede, dias, llenas }),
        });
        const d = await res.json().catch(() => ({}));
        if (res.ok) {
          cells.forEach((c) => {
            c.dataset.savedState = c.dataset.state || '';
            c.dataset.savedHoras = c.dataset.horas || '';
            c.dataset.savedDuracion = c.dataset.duracion || '';
          });
          refrescar(block);
          if (msg()) msg().textContent = `✓ Confirmado: ${d.fechas} días · ${d.turnos} turnos${d.llenas ? ` · ${d.llenas} llenos` : ''}`;
        } else if (msg()) {
          msg().textContent = `Error: ${d.error || 'no se pudo guardar'}. Tus cambios siguen acá: probá Confirmar de nuevo.`;
        }
      } catch {
        if (msg()) msg().textContent = 'Sin conexión: no se guardó. Tus cambios siguen acá: probá Confirmar de nuevo.';
      } finally {
        btn.disabled = false;
      }
    });

    actualizarSeleccion(block);
    refrescar(block);
  });

  // Borrar reserva
  document.querySelectorAll('.del').forEach((b) => {
    b.addEventListener('click', async () => {
      if (!confirm('¿Borrar esta reserva? Se libera el cupo y se quita del calendario.')) return;
      const btn = b as HTMLButtonElement;
      const id = btn.dataset.id;
      const orig = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Borrando…';
      try {
        const res = await fetch(`/api/admin/reserva?id=${id}`, { method: 'DELETE' });
        if (res.ok) {
          btn.closest('tr')?.remove();
          return;
        }
        alert('No se pudo borrar. Probá de nuevo.');
      } catch {
        alert('Sin conexión: no se pudo borrar. Probá de nuevo.');
      }
      btn.disabled = false;
      btn.textContent = orig;
    });
  });
</script>

