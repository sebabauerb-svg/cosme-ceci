---
export const prerender = false;

import Base from '../layouts/Base.astro';
import { isAdmin } from '../lib/admin';
import { getSql, ensureFranjas } from '../lib/db';

const authed = isAdmin(Astro.cookies);

const LUGARES = [
  { slug: 'montevideo', nombre: 'Montevideo' },
  { slug: 'san-jose', nombre: 'San José' },
  { slug: 'online', nombre: 'Online (Virtual / Skincare Inteligente)' },
];
// Intervalo de turnos por sede (minutos)
const SEDE_INTERVALO: Record<string, number> = { montevideo: 45, 'san-jose': 30, online: 30 };
function genHoras(step: number, start = '08:00', end = '20:30') {
  const [sh, sm] = start.split(':').map(Number);
  const [eh, em] = end.split(':').map(Number);
  const out: string[] = [];
  for (let t = sh * 60 + sm; t <= eh * 60 + em; t += step) {
    out.push(`${String(Math.floor(t / 60)).padStart(2, '0')}:${String(t % 60).padStart(2, '0')}`);
  }
  return out;
}

// Calendario de los próximos meses para que Ceci marque sus días
const HOY_ISO = new Date().toISOString().slice(0, 10);
const WD = ['L', 'M', 'X', 'J', 'V', 'S', 'D'];
type Celda = { iso: string; day: number; sel: boolean } | null;
function calMeses(cant: number) {
  const out: { label: string; cells: Celda[] }[] = [];
  const base = new Date();
  let y = base.getUTCFullYear();
  let mo = base.getUTCMonth();
  for (let i = 0; i < cant; i++) {
    const firstDow = new Date(Date.UTC(y, mo, 1)).getUTCDay();
    const offset = (firstDow + 6) % 7;
    const ndays = new Date(Date.UTC(y, mo + 1, 0)).getUTCDate();
    const cells: Celda[] = [];
    for (let k = 0; k < offset; k++) cells.push(null);
    for (let day = 1; day <= ndays; day++) {
      const iso = `${y}-${String(mo + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
      cells.push({ iso, day, sel: iso >= HOY_ISO });
    }
    out.push({
      label: new Date(Date.UTC(y, mo, 1)).toLocaleDateString('es-UY', { month: 'long', year: 'numeric', timeZone: 'UTC' }),
      cells,
    });
    mo++; if (mo > 11) { mo = 0; y++; }
  }
  return out;
}
const CAL = calMeses(3);

// Corte Mañana / Tarde para los atajos (debe coincidir con el del cliente)
const CORTE = '13:00';
// Cada día guarda su propio set de horas (no todos los días tienen el mismo horario)
const config: Record<string, { dias: Record<string, string[]>; llenas: Set<string> }> = {
  montevideo: { dias: {}, llenas: new Set() },
  'san-jose': { dias: {}, llenas: new Set() },
  online: { dias: {}, llenas: new Set() },
};
let reservas: any[] = [];
let dbError = '';

if (authed) {
  try {
    const sql = getSql();
    await ensureFranjas(sql);
    const fr = await sql`
      select coalesce(s.nombre, 'Online') as lugar, f.fecha::text as fecha, to_char(f.hora,'HH24:MI') as hora
      from franjas f left join sedes s on s.id = f.sede_id
      where f.fecha >= current_date
    `;
    const map: Record<string, string> = { Montevideo: 'montevideo', 'San José': 'san-jose', Online: 'online' };
    // Horas guardadas de cada fecha (para precargar el calendario tal cual quedó)
    for (const r of fr as any[]) {
      const slug = map[r.lugar] ?? 'online';
      (config[slug].dias[r.fecha] ??= []).push(r.hora);
    }
    for (const slug of Object.keys(config)) {
      for (const f of Object.keys(config[slug].dias)) config[slug].dias[f].sort();
    }
    const bl = await sql`
      select coalesce(s.nombre, 'Online') as lugar, b.fecha::text as fecha
      from bloqueos b left join sedes s on s.id = b.sede_id
      where b.fecha >= current_date
    `;
    for (const r of bl as any[]) {
      const slug = map[r.lugar] ?? 'online';
      config[slug].llenas.add(r.fecha);
    }
    reservas = (await sql`
      select r.id, r.modalidad, coalesce(s.nombre, 'Online') as sede,
             r.fecha::text as fecha, to_char(r.hora,'HH24:MI') as hora,
             r.nombre, r.telefono, r.estado
      from reservas r left join sedes s on s.id = r.sede_id
      order by r.created_at desc limit 50
    `) as any[];
  } catch (e) {
    dbError = e instanceof Error ? e.message : String(e);
  }
}
---

<Base title="Panel de Ceci" path="/admin">
  <main class="admin">
    <div class="container">
      {!authed ? (
        <div class="login">
          <h1>Panel de Ceci</h1>
          <p>Ingresá tu contraseña para administrar horarios y ver reservas.</p>
          <form id="login-form">
            <input type="password" name="password" placeholder="Contraseña" autocomplete="current-password" required />
            <button type="submit" class="btn btn--primary">Entrar</button>
          </form>
          <p id="login-error" class="login__err" hidden></p>
        </div>
      ) : (
        <div class="panel">
          <header class="panel__head">
            <h1>Panel de Ceci</h1>
            <button id="logout" class="btn btn--ghost">Salir</button>
          </header>

          {dbError && <p class="login__err">Error de base de datos: {dbError}</p>}

          <section class="card">
            <h2>Tu disponibilidad</h2>
            <p class="muted">Para cada lugar: <strong>tocá los días</strong> y elegí sus <strong>horarios</strong>. Cada día puede tener horarios distintos. Podés marcar días como <strong>llenos</strong>. Las clientas solo verán lo que marques. <strong>Nada se guarda hasta que tocás “Confirmar”.</strong></p>

            {LUGARES.map((lugar) => (
              <div class="sede-block" data-sede={lugar.slug}>
                <div class="sede-block__top">
                  <h3>{lugar.nombre} <span class="sede-int">· turnos cada {SEDE_INTERVALO[lugar.slug]} min</span></h3>
                  <span class="dirty-flag" data-dirty={lugar.slug} hidden>● Cambios sin confirmar</span>
                </div>

                <p class="hint">1) Tocá los días que querés editar (se resaltan). &nbsp; 2) Abajo elegí los horarios y tocá <b>Aplicar</b>. &nbsp; Repetí con otros días si tienen otro horario.</p>

                <div class="acals">
                  {CAL.map((mes) => (
                    <div class="acal">
                      <div class="acal__head">{mes.label}</div>
                      <div class="acal__grid">
                        {WD.map((w) => <div class="acal__wd">{w}</div>)}
                        {mes.cells.map((c) => {
                          if (!c) return <div class="acal__cell acal__cell--empty"></div>;
                          if (!c.sel) return <div class="acal__cell acal__cell--past">{c.day}</div>;
                          const horas = config[lugar.slug].dias[c.iso] ?? [];
                          const lleno = config[lugar.slug].llenas.has(c.iso);
                          const st = lleno ? 'lleno' : horas.length ? 'horas' : '';
                          const hstr = horas.join(',');
                          return (
                            <button
                              type="button"
                              class:list={['acal__cell', 'acal__cell--btn', st && `is-${st}`]}
                              data-lugar={lugar.slug}
                              data-fecha={c.iso}
                              data-state={st}
                              data-horas={hstr}
                              data-saved-state={st}
                              data-saved-horas={hstr}
                            >{c.day}</button>
                          );
                        })}
                      </div>
                    </div>
                  ))}
                </div>

                <div class="editor" data-editor={lugar.slug}>
                  <p class="editor__count" data-count={lugar.slug}>Tocá uno o más días para elegir sus horarios.</p>
                  <div class="quick">
                    <span class="quick__lbl">Atajos:</span>
                    <button type="button" class="chip" data-quick="manana">Mañana</button>
                    <button type="button" class="chip" data-quick="tarde">Tarde</button>
                    <button type="button" class="chip" data-quick="dia">Todo el día</button>
                    <button type="button" class="chip chip--ghost" data-quick="none">Ninguno</button>
                  </div>
                  <div class="horas">
                    {genHoras(SEDE_INTERVALO[lugar.slug]).map((h) => (
                      <label class="hora-chk">
                        <input type="checkbox" data-h={h} /> {h}
                      </label>
                    ))}
                  </div>
                  <div class="editor__actions">
                    <button type="button" class="btn btn--primary btn--sm" data-aplicar={lugar.slug}>Aplicar horarios</button>
                    <button type="button" class="btn btn--ghost btn--sm" data-lleno={lugar.slug}>Marcar lleno</button>
                    <button type="button" class="btn btn--ghost btn--sm" data-quitar={lugar.slug}>Quitar día</button>
                    <button type="button" class="link-btn" data-deselect={lugar.slug}>Deseleccionar</button>
                  </div>
                </div>

                <p class="resumen" data-resumen={lugar.slug}></p>

                <div class="sede-actions">
                  <button class="btn btn--primary btn--sm" data-confirmar={lugar.slug}>Confirmar {lugar.nombre}</button>
                  <button class="btn btn--ghost btn--sm" data-descartar={lugar.slug}>Descartar cambios</button>
                  <span class="sede-msg" data-msg={lugar.slug}></span>
                </div>
              </div>
            ))}
          </section>

          <section class="card">
            <h2>Reservas ({reservas.length})</h2>
            {reservas.length === 0 ? (
              <p class="muted">Todavía no hay reservas.</p>
            ) : (
              <div class="grid-wrap">
                <table class="grid grid--res">
                  <thead>
                    <tr><th>Servicio</th><th>Sede</th><th>Día</th><th>Hora</th><th>Nombre</th><th>WhatsApp</th><th>Estado</th><th></th></tr>
                  </thead>
                  <tbody>
                    {reservas.map((r) => (
                      <tr>
                        <td>{r.modalidad}</td>
                        <td>{r.sede}</td>
                        <td>{r.fecha ?? '—'}</td>
                        <td>{r.hora ?? '—'}</td>
                        <td>{r.nombre}</td>
                        <td>{r.telefono}</td>
                        <td><span class={`badge badge--${r.estado}`}>{r.estado}</span></td>
                        <td><button class="del" data-id={r.id}>Borrar</button></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>
        </div>
      )}
    </div>
  </main>
</Base>

<script>
  const lf = document.getElementById('login-form');
  lf?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = document.getElementById('login-error');
    const pw = (lf.querySelector('input[name="password"]') as HTMLInputElement).value;
    const res = await fetch('/api/admin/login', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ password: pw }),
    });
    if (res.ok) location.reload();
    else {
      const d = await res.json().catch(() => ({}));
      if (err) { err.textContent = d.error || 'No se pudo entrar.'; err.hidden = false; }
    }
  });

  document.getElementById('logout')?.addEventListener('click', async () => {
    await fetch('/api/admin/login', { method: 'DELETE' });
    location.reload();
  });

  // ----- Disponibilidad: seleccionar días + elegir horarios por día -----
  const CORTE = '13:00';
  const INTERVALO: Record<string, number> = { montevideo: 45, 'san-jose': 30, online: 30 };
  function genHoras(step: number): string[] {
    const out: string[] = [];
    for (let t = 8 * 60; t <= 20 * 60 + 30; t += step)
      out.push(`${String(Math.floor(t / 60)).padStart(2, '0')}:${String(t % 60).padStart(2, '0')}`);
    return out;
  }
  const fmtDia = (iso: string) => { const [, m, d] = iso.split('-'); return `${+d}/${+m}`; };
  const cellsDe = (b: HTMLElement) => [...b.querySelectorAll('.acal__cell--btn')] as HTMLElement[];
  const selDe = (b: HTMLElement) => cellsDe(b).filter((c) => c.classList.contains('is-sel'));
  const horasDe = (c: HTMLElement) => (c.dataset.horas ? c.dataset.horas.split(',') : []);

  // Pone el estado de un día: '' (libre), 'horas' (con horarios) o 'lleno'
  function setState(cell: HTMLElement, state: string, horas: string[] = []) {
    cell.classList.remove('is-horas', 'is-lleno');
    cell.dataset.state = state;
    cell.dataset.horas = state === 'horas' ? horas.join(',') : '';
    if (state) cell.classList.add('is-' + state);
  }
  function estaSucio(block: HTMLElement) {
    return cellsDe(block).some(
      (c) => (c.dataset.state || '') !== (c.dataset.savedState || '') || (c.dataset.horas || '') !== (c.dataset.savedHoras || '')
    );
  }
  // Nombre lindo de un set de horas para el resumen
  function etiquetaHoras(sede: string, horas: string[]) {
    const all = genHoras(INTERVALO[sede] ?? 30);
    const man = all.filter((h) => h < CORTE), tar = all.filter((h) => h >= CORTE);
    const eq = (a: string[]) => a.length === horas.length && a.every((h, i) => h === horas[i]);
    if (eq(all)) return 'Todo el día';
    if (eq(man)) return 'Mañana';
    if (eq(tar)) return 'Tarde';
    return `${horas.length} horarios (${horas[0]}–${horas[horas.length - 1]})`;
  }

  function refrescar(block: HTMLElement) {
    const sede = block.dataset.sede!;
    // Agrupar días disponibles por su set de horas (firma)
    const grupos: Record<string, string[]> = {};
    const llenos: string[] = [];
    let turnos = 0;
    for (const c of cellsDe(block)) {
      if (c.dataset.state === 'lleno') { llenos.push(c.dataset.fecha!); continue; }
      if (c.dataset.state === 'horas') {
        const sig = c.dataset.horas || '';
        (grupos[sig] ??= []).push(c.dataset.fecha!);
        turnos += horasDe(c).length;
      }
    }
    const partes: string[] = [];
    for (const sig of Object.keys(grupos).sort()) {
      const horas = sig.split(',');
      const dias = grupos[sig].sort().map(fmtDia).join(', ');
      partes.push(`<b>${etiquetaHoras(sede, horas)}</b> (${grupos[sig].length}): ${dias}`);
    }
    if (llenos.length) partes.push(`<b class="res-lleno">Llenos</b> (${llenos.length}): ${llenos.sort().map(fmtDia).join(', ')}`);

    const res = block.querySelector(`[data-resumen="${sede}"]`) as HTMLElement;
    if (res) res.innerHTML = partes.length
      ? partes.join('<br>') + `<br><span class="resumen__tot">${turnos} turnos para reservar</span>`
      : '<span class="resumen__vacio">Sin días marcados.</span>';

    const flag = block.querySelector(`[data-dirty="${sede}"]`) as HTMLElement;
    if (flag) flag.hidden = !estaSucio(block);
  }

  function actualizarSeleccion(block: HTMLElement) {
    const sede = block.dataset.sede!;
    const sel = selDe(block);
    const cnt = block.querySelector(`[data-count="${sede}"]`) as HTMLElement;
    const checks = [...block.querySelectorAll(`.editor[data-editor="${sede}"] input[data-h]`)] as HTMLInputElement[];
    if (cnt) cnt.textContent = sel.length
      ? `${sel.length} día${sel.length > 1 ? 's' : ''} seleccionado${sel.length > 1 ? 's' : ''}: elegí horarios y tocá Aplicar.`
      : 'Tocá uno o más días para elegir sus horarios.';
    // Si hay un único día seleccionado con horarios, precargarlos para editarlos
    if (sel.length === 1 && sel[0].dataset.state === 'horas') {
      const hs = new Set(horasDe(sel[0]));
      checks.forEach((ch) => (ch.checked = hs.has(ch.dataset.h!)));
    } else if (sel.length === 0) {
      checks.forEach((ch) => (ch.checked = false));
    }
  }

  document.querySelectorAll<HTMLElement>('.sede-block').forEach((block) => {
    const sede = block.dataset.sede!;
    const msg = () => block.querySelector(`[data-msg="${sede}"]`) as HTMLElement;
    const checks = () => [...block.querySelectorAll(`.editor[data-editor="${sede}"] input[data-h]`)] as HTMLInputElement[];

    // Seleccionar/deseleccionar días
    cellsDe(block).forEach((cell) =>
      cell.addEventListener('click', () => {
        cell.classList.toggle('is-sel');
        actualizarSeleccion(block);
      })
    );

    // Atajos: tildan los horarios (no tocan los días)
    block.querySelectorAll<HTMLElement>('.chip[data-quick]').forEach((chip) =>
      chip.addEventListener('click', () => {
        const all = genHoras(INTERVALO[sede] ?? 30);
        const q = chip.dataset.quick;
        checks().forEach((ch) => {
          const h = ch.dataset.h!;
          ch.checked = q === 'dia' ? true : q === 'manana' ? h < CORTE : q === 'tarde' ? h >= CORTE : false;
        });
      })
    );

    // Aplicar horarios a los días seleccionados
    block.querySelector(`[data-aplicar="${sede}"]`)?.addEventListener('click', () => {
      const sel = selDe(block);
      if (!sel.length) { if (msg()) msg().textContent = 'Primero tocá los días a editar.'; return; }
      const horas = checks().filter((ch) => ch.checked).map((ch) => ch.dataset.h!);
      if (!horas.length) { if (msg()) msg().textContent = 'Elegí al menos un horario (o usá “Quitar día”).'; return; }
      sel.forEach((c) => { setState(c, 'horas', horas); c.classList.remove('is-sel'); });
      if (msg()) msg().textContent = '';
      actualizarSeleccion(block); refrescar(block);
    });

    // Marcar seleccionados como llenos
    block.querySelector(`[data-lleno="${sede}"]`)?.addEventListener('click', () => {
      const sel = selDe(block);
      if (!sel.length) { if (msg()) msg().textContent = 'Primero tocá los días.'; return; }
      sel.forEach((c) => { setState(c, 'lleno'); c.classList.remove('is-sel'); });
      actualizarSeleccion(block); refrescar(block);
    });

    // Quitar disponibilidad de los seleccionados (vuelven a libres)
    block.querySelector(`[data-quitar="${sede}"]`)?.addEventListener('click', () => {
      const sel = selDe(block);
      if (!sel.length) { if (msg()) msg().textContent = 'Primero tocá los días.'; return; }
      sel.forEach((c) => { setState(c, ''); c.classList.remove('is-sel'); });
      actualizarSeleccion(block); refrescar(block);
    });

    // Deseleccionar
    block.querySelector(`[data-deselect="${sede}"]`)?.addEventListener('click', () => {
      cellsDe(block).forEach((c) => c.classList.remove('is-sel'));
      actualizarSeleccion(block);
    });

    // Descartar cambios → vuelve a lo último confirmado (no toca la base)
    block.querySelector(`[data-descartar="${sede}"]`)?.addEventListener('click', () => {
      cellsDe(block).forEach((c) => {
        c.classList.remove('is-sel');
        const st = c.dataset.savedState || '';
        setState(c, st, st === 'horas' ? (c.dataset.savedHoras || '').split(',').filter(Boolean) : []);
      });
      if (msg()) msg().textContent = '';
      actualizarSeleccion(block); refrescar(block);
    });

    // Confirmar → guarda la foto completa de la sede
    block.querySelector(`[data-confirmar="${sede}"]`)?.addEventListener('click', async () => {
      const cells = cellsDe(block);
      const dias = cells
        .filter((c) => c.dataset.state === 'horas')
        .map((c) => ({ fecha: c.dataset.fecha, horas: horasDe(c) }));
      const llenas = cells.filter((c) => c.dataset.state === 'lleno').map((c) => c.dataset.fecha);
      if (msg()) msg().textContent = 'Guardando…';
      const res = await fetch('/api/admin/disponibilidad', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ lugar: sede, dias, llenas }),
      });
      const d = await res.json().catch(() => ({}));
      if (res.ok) {
        cells.forEach((c) => { c.dataset.savedState = c.dataset.state || ''; c.dataset.savedHoras = c.dataset.horas || ''; });
        refrescar(block);
        if (msg()) msg().textContent = `✓ Confirmado: ${d.fechas} días · ${d.turnos} turnos${d.llenas ? ` · ${d.llenas} llenos` : ''}`;
      } else if (msg()) {
        msg().textContent = `Error: ${d.error || 'no se pudo'}`;
      }
    });

    actualizarSeleccion(block);
    refrescar(block);
  });

  // Borrar reserva
  document.querySelectorAll('.del').forEach((b) => {
    b.addEventListener('click', async () => {
      if (!confirm('¿Borrar esta reserva? Se libera el cupo.')) return;
      const id = (b as HTMLElement).dataset.id;
      const res = await fetch(`/api/admin/reserva?id=${id}`, { method: 'DELETE' });
      if (res.ok) (b as HTMLElement).closest('tr')?.remove();
      else alert('No se pudo borrar.');
    });
  });
</script>

<style>
  .admin { padding-block: clamp(2rem, 5vw, 3.5rem); }
  .login { max-width: 380px; margin: 2rem auto; text-align: center; }
  .login h1 { margin-bottom: 0.6rem; }
  .login form { display: flex; flex-direction: column; gap: 0.8rem; margin-top: 1.4rem; }
  .login input { font: inherit; padding: 0.7rem 0.9rem; border: 1px solid var(--sand); border-radius: var(--radius-sm); background: var(--white); }
  .login__err { color: var(--clay-deep); font-size: 0.9rem; margin-top: 0.8rem; }

  .panel__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
  .panel__head h1 { font-size: clamp(1.6rem, 3vw, 2rem); }
  .muted { color: var(--ink-soft); font-size: 0.92rem; margin-bottom: 1rem; }
  .card { margin-bottom: 2rem; }
  .card h2 { font-size: 1.4rem; margin-bottom: 0.4rem; }

  .sede-block { margin-top: 1.6rem; padding-top: 1.2rem; border-top: 1px solid var(--sand); }
  .sede-block__top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .sede-block__top h3 { font-size: 1.1rem; }
  .sede-int { font-weight: 400; font-size: 0.82rem; color: var(--ink-soft); }
  .dirty-flag { font-size: 0.8rem; color: var(--clay-deep); font-weight: 600; }
  .btn--sm { padding: 0.45rem 1rem; font-size: 0.88rem; }

  .hint { font-size: 0.84rem; color: var(--ink-soft); margin: 0.9rem 0; line-height: 1.6; }

  .acals { display: flex; flex-wrap: wrap; gap: 1.4rem; margin-top: 0.4rem; }
  .acal { width: 224px; }
  .acal__head { font-family: var(--font-serif); font-size: 0.98rem; text-transform: capitalize; margin-bottom: 0.4rem; color: var(--ink); }
  .acal__grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; }
  .acal__wd { text-align: center; font-size: 0.62rem; font-weight: 600; color: var(--ink-soft); }
  .acal__cell { aspect-ratio: 1; display: grid; place-items: center; font-size: 0.78rem; border-radius: 6px; border: 1px solid transparent; }
