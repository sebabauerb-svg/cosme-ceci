---
export const prerender = false;

import Base from '../layouts/Base.astro';
import { isAdmin } from '../lib/admin';
import { getSql, ensureDuracionMin } from '../lib/db';
import { ensureHorarioSemanal } from '../lib/agenda';

const authed = isAdmin(Astro.cookies);

const SEDES = [
  { slug: 'montevideo', nombre: 'Montevideo', durDefault: 45 },
  { slug: 'san-jose', nombre: 'San José', durDefault: 30 },
  { slug: 'online', nombre: 'Online', durDefault: 30 },
];
// Días de la semana. Convención: 0=domingo … 6=sábado (Date.getUTCDay).
// Se muestran con el lunes primero.
const DIAS = [
  { n: 1, nombre: 'Lunes' },
  { n: 2, nombre: 'Martes' },
  { n: 3, nombre: 'Miércoles' },
  { n: 4, nombre: 'Jueves' },
  { n: 5, nombre: 'Viernes' },
  { n: 6, nombre: 'Sábado' },
  { n: 0, nombre: 'Domingo' },
];

// Fecha legible para la tabla de reservas (ej. "mié 15 jul")
function fmtFechaTabla(iso?: string | null) {
  if (!iso) return '—';
  try {
    return new Date(iso + 'T12:00:00Z').toLocaleDateString('es-UY', {
      weekday: 'short',
      day: 'numeric',
      month: 'short',
      timeZone: 'UTC',
    });
  } catch {
    return iso;
  }
}

let bloques: any[] = []; // { sede, dia, desde, hasta, duracion }
let excepciones: string[] = []; // 'YYYY-MM-DD'
let reservas: any[] = [];
let dbError = '';

if (authed) {
  try {
    const sql = getSql();
    await ensureHorarioSemanal(sql);
    await ensureDuracionMin(sql);
    const nombreASlug: Record<string, string> = { Montevideo: 'montevideo', 'San José': 'san-jose' };
    const hs = (await sql`
      select coalesce(s.nombre, 'Online') as sede, h.dia_semana as dia,
             to_char(h.hora_desde, 'HH24:MI') as desde, to_char(h.hora_hasta, 'HH24:MI') as hasta,
             h.duracion_min as duracion
      from horario_semanal h left join sedes s on s.id = h.sede_id
      order by h.dia_semana, h.hora_desde
    `) as any[];
    bloques = hs.map((r) => ({
      sede: nombreASlug[r.sede] ?? 'online',
      dia: Number(r.dia),
      desde: r.desde,
      hasta: r.hasta,
      duracion: Number(r.duracion),
    }));
    const bl = (await sql`select fecha::text as fecha from bloqueos where fecha >= current_date order by fecha`) as any[];
    excepciones = bl.map((r) => r.fecha);
    reservas = (await sql`
      select r.id, r.modalidad, coalesce(s.nombre, 'Online') as sede,
             r.fecha::text as fecha, to_char(r.hora,'HH24:MI') as hora,
             r.nombre, r.telefono, r.estado
      from reservas r left join sedes s on s.id = r.sede_id
      order by r.created_at desc limit 50
    `) as any[];
  } catch (e) {
    dbError = e instanceof Error ? e.message : String(e);
  }
}
---

<Base title="Panel de Ceci" path="/admin">
  <main class="admin">
    <div class="container">
      {!authed ? (
        <div class="login">
          <h1>Panel de Ceci</h1>
          <p>Ingresá tu contraseña para administrar horarios y ver reservas.</p>
          <form id="login-form">
            <label class="login__label">Contraseña
              <input type="password" name="password" autocomplete="current-password" required />
            </label>
            <button type="submit" class="btn btn--primary">Entrar</button>
          </form>
          <p id="login-error" class="login__err" hidden></p>
        </div>
      ) : (
        <div class="panel">
          <header class="panel__head">
            <h1>Panel de Ceci</h1>
            <button id="logout" class="btn btn--ghost">Salir</button>
          </header>

          {dbError && <p class="login__err">Error de base de datos: {dbError}</p>}

          <section class="card">
            <div class="card__head">
              <div>
                <h2>Tu horario semanal</h2>
                <p class="muted">Definí una vez qué días y horarios atendés en cada lugar. Los turnos se abren solos para las próximas 10 semanas. Marcá abajo los días que no atendés (feriados, viajes).</p>
              </div>
              <button type="button" id="reset-todo" class="link-btn link-btn--danger">Borrar todo</button>
            </div>

            <div id="dias"></div>

            <div class="exc">
              <h3>Días que no atenderás</h3>
              <p class="muted">Se cierran aunque estén en tu horario semanal.</p>
              <div class="exc__row">
                <input type="date" id="exc-fecha" />
                <button type="button" class="btn btn--ghost btn--sm" id="exc-add">Agregar fecha</button>
              </div>
              <div id="exc-chips" class="exc__chips"></div>
            </div>

            <div class="guardar">
              <button type="button" id="guardar" class="btn btn--primary">Guardar horario</button>
              <span id="guardar-msg" class="guardar__msg"></span>
            </div>
          </section>

          <section class="card">
            <h2>Reservas ({reservas.length})</h2>
            {reservas.length === 0 ? (
              <p class="muted">Todavía no hay reservas.</p>
            ) : (
              <div class="grid-wrap">
                <table class="grid grid--res">
                  <thead>
                    <tr><th>Servicio</th><th>Sede</th><th>Día</th><th>Hora</th><th>Nombre</th><th>WhatsApp</th><th>Estado</th><th></th></tr>
                  </thead>
                  <tbody>
                    {reservas.map((r) => (
                      <tr>
                        <td>{r.modalidad}</td>
                        <td>{r.sede}</td>
                        <td>{fmtFechaTabla(r.fecha)}</td>
                        <td>{r.hora ?? '—'}</td>
                        <td>{r.nombre}</td>
                        <td>{r.telefono ? (
                          <a
                            class="tel-link"
                            href={`https://wa.me/598${String(r.telefono).replace(/\D/g, '').replace(/^(598|0)/, '')}`}
                            target="_blank"
                            rel="noopener"
                          >{r.telefono}</a>
                        ) : '—'}</td>
                        <td><span class={`badge badge--${r.estado}`}>{r.estado}</span></td>
                        <td><button class="del" data-id={r.id}>Borrar</button></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>
        </div>
      )}
    </div>
  </main>
</Base>

<script define:vars={{ SEDES, DIAS, bloquesInit: bloques, excepcionesInit: excepciones }}>
  // ---------- Login ----------
  const lf = document.getElementById('login-form');
  lf?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = document.getElementById('login-error');
    const pw = lf.querySelector('input[name="password"]').value;
    const res = await fetch('/api/admin/login', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ password: pw }),
    });
    if (res.ok) location.reload();
    else {
      const d = await res.json().catch(() => ({}));
      if (err) { err.textContent = d.error || 'No se pudo entrar.'; err.hidden = false; }
    }
  });

  document.getElementById('logout')?.addEventListener('click', async () => {
    await fetch('/api/admin/login', { method: 'DELETE' });
    location.reload();
  });

  const diasCont = document.getElementById('dias');
  if (diasCont) {
    // ---------- Estado ----------
    let uid = 1;
    // Cada bloque lleva un _id local para el render; el estado es la fuente de verdad.
    const bloques = (bloquesInit || []).map((b) => ({ _id: uid++, ...b }));
    let excepciones = [...(excepcionesInit || [])];
    const durDefault = Object.fromEntries(SEDES.map((s) => [s.slug, s.durDefault]));
    const nombreSede = Object.fromEntries(SEDES.map((s) => [s.slug, s.nombre]));

    // Cantidad de turnos de un rango (misma lógica que el servidor).
    function contarTurnos(desde, hasta, dur) {
      if (!desde || !hasta || !dur || dur <= 0) return 0;
      const [dh, dm] = desde.split(':').map(Number);
      const [hh, hm] = hasta.split(':').map(Number);
      const fin = hh * 60 + hm;
      let n = 0;
      for (let t = dh * 60 + dm; t + dur <= fin; t += dur) n++;
      return n;
    }

    function marcarSucio() {
      const msg = document.getElementById('guardar-msg');
      if (msg) { msg.textContent = 'Tenés cambios sin guardar.'; msg.className = 'guardar__msg guardar__msg--dirty'; }
    }

    // ---------- Render de los días ----------
    function render() {
      diasCont.innerHTML = '';
      for (const dia of DIAS) {
        const delDia = bloques.filter((b) => b.dia === dia.n);
        const card = document.createElement('div');
        card.className = 'dia' + (delDia.length ? '' : ' dia--vacio');

        const head = document.createElement('div');
        head.className = 'dia__head';
        head.innerHTML = `<span class="dia__nombre">${dia.nombre}</span>`;
        const addBtn = document.createElement('button');
        addBtn.type = 'button';
        addBtn.className = 'btn btn--ghost btn--sm';
        addBtn.textContent = '+ Agregar horario';
        addBtn.addEventListener('click', () => {
          bloques.push({ _id: uid++, sede: 'montevideo', dia: dia.n, desde: '08:00', hasta: '12:00', duracion: durDefault['montevideo'] });
          marcarSucio();
          render();
        });
        head.appendChild(addBtn);
        card.appendChild(head);

        if (!delDia.length) {
          const vacio = document.createElement('p');
          vacio.className = 'dia__sin';
          vacio.textContent = 'Sin atención';
          card.appendChild(vacio);
        } else {
          const cont = document.createElement('div');
          cont.className = 'dia__bloques';
          for (const b of delDia) cont.appendChild(filaBloque(b));
          card.appendChild(cont);
        }
        diasCont.appendChild(card);
      }
    }

    function filaBloque(b) {
      const fila = document.createElement('div');
      fila.className = 'bloque';

      const sel = document.createElement('select');
      sel.className = 'bloque__sede';
      for (const s of SEDES) {
        const op = document.createElement('option');
        op.value = s.slug; op.textContent = s.nombre;
        if (s.slug === b.sede) op.selected = true;
        sel.appendChild(op);
      }
      sel.addEventListener('change', () => { b.sede = sel.value; b.duracion = durDefault[b.sede] || b.duracion; marcarSucio(); render(); });

      const desde = document.createElement('input');
      desde.type = 'time'; desde.step = '300'; desde.value = b.desde; desde.className = 'bloque__t';
      const hasta = document.createElement('input');
      hasta.type = 'time'; hasta.step = '300'; hasta.value = b.hasta; hasta.className = 'bloque__t';
      const dur = document.createElement('input');
      dur.type = 'number'; dur.min = '5'; dur.max = '240'; dur.step = '5'; dur.value = b.duracion; dur.className = 'bloque__dur';

      const count = document.createElement('span');
      count.className = 'bloque__count';
      const actualizarCount = () => {
        const n = contarTurnos(desde.value, hasta.value, Number(dur.value));
        count.textContent = n ? `${n} turno${n > 1 ? 's' : ''}` : '⚠ sin turnos';
        count.classList.toggle('bloque__count--warn', !n);
      };
      desde.addEventListener('input', () => { b.desde = desde.value; actualizarCount(); marcarSucio(); });
      hasta.addEventListener('input', () => { b.hasta = hasta.value; actualizarCount(); marcarSucio(); });
      dur.addEventListener('input', () => { b.duracion = Number(dur.value); actualizarCount(); marcarSucio(); });
      actualizarCount();

      const del = document.createElement('button');
      del.type = 'button'; del.className = 'bloque__del'; del.title = 'Quitar'; del.textContent = '✕';
      del.addEventListener('click', () => {
        const i = bloques.indexOf(b);
        if (i >= 0) bloques.splice(i, 1);
        marcarSucio();
        render();
      });

      fila.append(sel, tag('span', 'bloque__sep', 'de'), desde, tag('span', 'bloque__sep', 'a'), hasta,
        tag('span', 'bloque__sep', '·'), dur, tag('span', 'bloque__sep', 'min'), count, del);
      return fila;
    }

    function tag(t, cls, txt) {
      const el = document.createElement(t);
      el.className = cls; el.textContent = txt;
      return el;
    }

    // ---------- Excepciones ----------
    function renderExc() {
      const cont = document.getElementById('exc-chips');
      cont.innerHTML = '';
      if (!excepciones.length) {
        cont.innerHTML = '<span class="exc__vacio">No hay días cerrados.</span>';
        return;
      }
      for (const f of [...excepciones].sort()) {
        const chip = document.createElement('span');
        chip.className = 'exc__chip';
        const [y, m, d] = f.split('-');
        chip.textContent = `${+d}/${+m}/${y} `;
        const x = document.createElement('button');
        x.type = 'button'; x.textContent = '✕'; x.title = 'Quitar';
        x.addEventListener('click', () => { excepciones = excepciones.filter((e) => e !== f); marcarSucio(); renderExc(); });
        chip.appendChild(x);
        cont.appendChild(chip);
      }
    }
    document.getElementById('exc-add')?.addEventListener('click', () => {
      const inp = document.getElementById('exc-fecha');
      const f = inp.value;
      if (!f) return;
      if (!excepciones.includes(f)) { excepciones.push(f); marcarSucio(); renderExc(); }
      inp.value = '';
    });

    // ---------- Guardar ----------
    document.getElementById('guardar')?.addEventListener('click', async (ev) => {
      const btn = ev.currentTarget;
      const msg = document.getElementById('guardar-msg');
      // Validar que ningún bloque quede sin turnos
      const invalido = bloques.find((b) => contarTurnos(b.desde, b.hasta, b.duracion) === 0);
      if (invalido) {
        if (msg) { msg.textContent = 'Revisá los horarios marcados con ⚠ (no generan turnos).'; msg.className = 'guardar__msg guardar__msg--dirty'; }
        return;
      }
      btn.disabled = true;
      if (msg) { msg.textContent = 'Guardando…'; msg.className = 'guardar__msg'; }
      try {
        const res = await fetch('/api/admin/horario', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            bloques: bloques.map((b) => ({ sede: b.sede, dia: b.dia, desde: b.desde, hasta: b.hasta, duracion: b.duracion })),
            excepciones,
          }),
        });
        const d = await res.json().catch(() => ({}));
        if (res.ok) {
          if (msg) { msg.textContent = '✓ Guardado. Tu agenda ya está publicada.'; msg.className = 'guardar__msg guardar__msg--ok'; }
        } else if (msg) {
          msg.textContent = `Error: ${d.error || 'no se pudo guardar'}${d.detalle ? ' — ' + d.detalle : ''}`;
          msg.className = 'guardar__msg guardar__msg--dirty';
        }
      } catch {
        if (msg) { msg.textContent = 'Sin conexión: no se guardó. Probá de nuevo.'; msg.className = 'guardar__msg guardar__msg--dirty'; }
      } finally {
        btn.disabled = false;
      }
    });

    // ---------- Borrar todo ----------
    document.getElementById('reset-todo')?.addEventListener('click', async (ev) => {
      const btn = ev.currentTarget;
      if (!confirm('¿Borrar TODO tu horario semanal y los días cerrados? Las reservas ya hechas no se tocan.')) return;
      if (prompt('Para confirmar, escribí BORRAR (en mayúsculas):') !== 'BORRAR') { alert('No coincide. No se borró nada.'); return; }
      btn.disabled = true;
      try {
        const res = await fetch('/api/admin/horario', { method: 'DELETE' });
        const d = await res.json().catch(() => ({}));
        if (res.ok) { alert('Listo, se borró todo el horario.'); location.reload(); }
        else alert(`Error: ${d.error || 'no se pudo borrar'}${d.detalle ? '\n\nDetalle: ' + d.detalle : ''}`);
      } catch {
        alert('Sin conexión: no se pudo borrar. Probá de nuevo.');
      } finally {
        btn.disabled = false;
      }
    });

    render();
    renderExc();
  }

  // ---------- Borrar reserva ----------
  document.querySelectorAll('.del').forEach((b) => {
    b.addEventListener('click', async () => {
      if (!confirm('¿Borrar esta reserva? Se libera el cupo y se quita del calendario.')) return;
      const btn = b;
      const id = btn.dataset.id;
      const orig = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Borrando…';
      try {
        const res = await fetch(`/api/admin/reserva?id=${id}`, { method: 'DELETE' });
        if (res.ok) { btn.closest('tr')?.remove(); return; }
        alert('No se pudo borrar. Probá de nuevo.');
      } catch {
        alert('Sin conexión: no se pudo borrar. Probá de nuevo.');
      }
      btn.disabled = false;
      btn.textContent = orig;
    });
  });
</script>

<style>
  .admin { padding-block: clamp(2rem, 5vw, 3.5rem); }
  .login { max-width: 380px; margin: 2rem auto; text-align: center; }
  .login h1 { margin-bottom: 0.6rem; }
  .login form { display: flex; flex-direction: column; gap: 0.8rem; margin-top: 1.4rem; }
  .login input { font: inherit; padding: 0.7rem 0.9rem; border: 1px solid var(--sand); border-radius: var(--radius-sm); background: var(--white); }
  .login__label { display: grid; gap: 0.35rem; font-size: 0.9rem; font-weight: 600; color: var(--ink); text-align: left; }
  .login__err { color: var(--clay-deep); font-size: 0.9rem; margin-top: 0.8rem; }

  .panel__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
  .panel__head h1 { font-size: clamp(1.6rem, 3vw, 2rem); }
  .muted { color: var(--ink-soft); font-size: 0.9rem; margin: 0.3rem 0 0; line-height: 1.6; }
  .card { margin-bottom: 2rem; }
  .card h2 { font-size: 1.4rem; margin-bottom: 0.2rem; }
  .card__head { display: flex; flex-wrap: wrap; align-items: start; justify-content: space-between; gap: 0.8rem; margin-bottom: 1.4rem; }
  .card__head > div { max-width: 60ch; }

  /* Día */
  .dia { background: var(--white); border: 1px solid var(--sand); border-radius: var(--radius); padding: 0.85rem 1rem; margin-bottom: 0.7rem; }
  .dia--vacio { background: transparent; border-style: dashed; }
  .dia__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .dia__nombre { font-weight: 600; font-size: 1rem; color: var(--ink); }
  .dia__sin { font-size: 0.85rem; color: var(--ink-soft); margin: 0.4rem 0 0; }
  .dia__bloques { display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.7rem; }

  /* Bloque horario */
  .bloque { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.5rem; background: var(--cream-deep); border-radius: var(--radius-sm); padding: 0.5rem 0.7rem; }
  .bloque__sede { font: inherit; padding: 0.35rem 0.5rem; border: 1px solid var(--sand); border-radius: var(--radius-sm); background: var(--white); color: var(--ink); }
  .bloque__t { font: inherit; padding: 0.35rem 0.4rem; border: 1px solid var(--sand); border-radius: var(--radius-sm); background: var(--white); color: var(--ink); }
  .bloque__dur { font: inherit; width: 4em; padding: 0.35rem 0.4rem; border: 1px solid var(--sand); border-radius: var(--radius-sm); background: var(--white); color: var(--ink); }
  .bloque__sep { font-size: 0.85rem; color: var(--ink-soft); }
  .bloque__count { font-size: 0.8rem; color: var(--sage-deep); font-weight: 600; margin-left: auto; }
  .bloque__count--warn { color: var(--clay-deep); }
  .bloque__del { background: none; border: 0; color: var(--ink-soft); cursor: pointer; font-size: 0.9rem; padding: 0.2rem 0.4rem; }
  .bloque__del:hover { color: var(--clay-deep); }

  /* Excepciones */
  .exc { margin-top: 1.5rem; padding-top: 1.3rem; border-top: 1px solid var(--sand); }
  .exc h3 { font-size: 1.05rem; margin-bottom: 0.1rem; }
  .exc__row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.7rem; }
  .exc__row input { font: inherit; padding: 0.45rem 0.6rem; border: 1px solid var(--sand); border-radius: var(--radius-sm); background: var(--white); color: var(--ink); }
  .exc__chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.8rem; }
  .exc__chip { display: inline-flex; align-items: center; gap: 0.3rem; background: color-mix(in srgb, var(--clay) 14%, var(--cream)); color: var(--clay-deep); font-size: 0.85rem; padding: 0.3rem 0.7rem; border-radius: 999px; }
  .exc__chip button { background: none; border: 0; color: var(--clay-deep); cursor: pointer; font-size: 0.85rem; padding: 0; }
  .exc__vacio { font-size: 0.85rem; color: var(--ink-soft); }

  /* Guardar */
  .guardar { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 1.6rem; }
  .guardar__msg { font-size: 0.88rem; color: var(--ink-soft); }
  .guardar__msg--ok { color: var(--sage-deep); font-weight: 600; }
  .guardar__msg--dirty { color: var(--clay-deep); }

  .btn--sm { padding: 0.4rem 0.85rem; font-size: 0.85rem; }
  .link-btn { background: none; border: 0; color: var(--ink-soft); cursor: pointer; font-size: 0.84rem; text-decoration: underline; white-space: nowrap; }
  .link-btn:hover { color: var(--ink); }
  .link-btn--danger { color: var(--clay-deep); }

  /* Tabla reservas */
  .grid-wrap { overflow-x: auto; }
  .grid { border-collapse: collapse; font-size: 0.85rem; width: 100%; }
  .grid th, .grid td { border: 1px solid var(--sand); padding: 0.4rem 0.6rem; text-align: left; }
  .grid th { background: var(--cream-deep); font-weight: 600; }
  .badge { font-size: 0.75rem; padding: 0.15rem 0.5rem; border-radius: 999px; background: var(--sand); color: var(--ink); }
  .badge--confirmada { background: color-mix(in srgb, var(--sage) 35%, var(--cream)); color: var(--sage-deep); }
  .badge--cancelada, .badge--expirada { background: color-mix(in srgb, var(--clay) 30%, var(--cream)); color: var(--clay-deep); }
  .del { background: none; border: 0; color: var(--clay-deep); cursor: pointer; font-size: 0.82rem; text-decoration: underline; }
  .del:hover { color: var(--ink); }
  .tel-link { color: var(--sage-deep); text-decoration: underline; white-space: nowrap; }
  .tel-link:hover { color: var(--ink); }
</style>
