  /* Día que se está viendo: anillo. */
  .cal__cell--sel { box-shadow: inset 0 0 0 2px var(--ink); }
  .cal__cell--on.cal__cell--sel { box-shadow: inset 0 0 0 2px var(--cream); }
  /* Con reserva: punto. */
  .cal__cell--res::after { content: ''; position: absolute; bottom: 6px; left: 50%; transform: translateX(-50%); width: 5px; height: 5px; border-radius: 50%; background: var(--clay); }
  .cal__cell--on.cal__cell--res::after { background: var(--cream); }
  .cal__leg { display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; margin-top: 0.9rem; padding-top: 0.8rem; border-top: 1px solid var(--sand); font-size: 0.75rem; color: var(--ink-soft); }
  .cal__leg span { display: inline-flex; align-items: center; gap: 0.4rem; }
