---
export const prerender = false;

import Base from '../layouts/Base.astro';
import { isAdmin } from '../lib/admin';
import { getSql, ensureFranjas, ensureDuracionMin } from '../lib/db';

const authed = isAdmin(Astro.cookies);

const SEDES = [
  { slug: 'montevideo', nombre: 'Montevideo', dur: 45 },
  { slug: 'san-jose', nombre: 'San José', dur: 30 },
  { slug: 'online', nombre: 'Online', dur: 30 },
];

// Horas para los selectores (formato 24 h, cada 15 min, 06:00–23:00).
const pad2 = (n: number) => String(n).padStart(2, '0');
const HORAS_SEL: string[] = [];
for (let t = 6 * 60; t <= 23 * 60; t += 15) HORAS_SEL.push(`${pad2(Math.floor(t / 60))}:${pad2(t % 60)}`);
const DURACIONES = [15, 20, 30, 45, 60, 90];

function fmtFechaTabla(iso?: string | null) {
  if (!iso) return '—';
  try {
    return new Date(iso + 'T12:00:00Z').toLocaleDateString('es-UY', {
      weekday: 'short',
      day: 'numeric',
      month: 'short',
      timeZone: 'UTC',
    });
  } catch {
    return iso;
  }
}

let reservas: any[] = [];
let dbError = '';

if (authed) {
  try {
    const sql = getSql();
    await ensureFranjas(sql);
    await ensureDuracionMin(sql);
    reservas = (await sql`
      select r.id, r.modalidad, coalesce(s.nombre, 'Online') as sede,
             r.fecha::text as fecha, to_char(r.hora,'HH24:MI') as hora,
             r.nombre, r.telefono, r.estado
      from reservas r left join sedes s on s.id = r.sede_id
      order by r.created_at desc limit 60
    `) as any[];
  } catch (e) {
    dbError = e instanceof Error ? e.message : String(e);
  }
}
---

<Base title="Panel de Ceci" path="/admin">
  <main class="admin">
    <div class="container">
      {!authed ? (
        <div class="login">
          <h1>Panel de Ceci</h1>
          <p>Ingresá tu contraseña para administrar horarios y ver reservas.</p>
          <form id="login-form">
            <label class="login__label">Contraseña
              <input type="password" name="password" autocomplete="current-password" required />
            </label>
            <button type="submit" class="btn btn--primary">Entrar</button>
          </form>
          <p id="login-error" class="login__err" hidden></p>
        </div>
      ) : (
        <div class="panel">
          <header class="panel__head">
            <h1>Panel de Ceci</h1>
            <button id="logout" class="btn btn--ghost">Salir</button>
          </header>

          {dbError && <p class="login__err">Error de base de datos: {dbError}</p>}

          <section class="card">
            <h2>Tu disponibilidad</h2>
            <p class="muted">Elegí un lugar, tocá los días del calendario y abrí tus horarios. Las clientas solo verán lo que dejes abierto.</p>

            <div class="sedes-tabs" id="sedes-tabs">
              {SEDES.map((s, i) => (
                <button type="button" class:list={['sede-tab', i === 0 && 'is-active']} data-sede={s.slug} data-dur={s.dur}>{s.nombre}</button>
              ))}
            </div>

            <div class="disp">
              <!-- Columna izquierda: franja + calendario -->
              <div class="disp__cal">
                <div class="franja">
                  <span class="franja__lbl">Horario a abrir</span>
                  <div class="franja__ctrl">
                    <select id="f-desde" aria-label="Desde">
                      {HORAS_SEL.map((h) => <option value={h} selected={h === '08:00'}>{h}</option>)}
                    </select>
                    <span class="franja__sep">a</span>
                    <select id="f-hasta" aria-label="Hasta">
                      {HORAS_SEL.map((h) => <option value={h} selected={h === '12:00'}>{h}</option>)}
                    </select>
                    <span class="franja__sep">· cada</span>
                    <select id="f-dur" aria-label="Duración de la consulta">
                      {DURACIONES.map((d) => <option value={d} selected={d === 45}>{d} min</option>)}
                    </select>
                    <span class="franja__prev" id="f-prev"></span>
                  </div>
                </div>
                <div class="atajo">
                  <span class="atajo__lbl">Atajo:</span>
                  <button type="button" class="btn btn--ghost btn--sm" id="atajo-btn">Repetir cada</button>
                  <select id="atajo-dia">
                    <option value="1">lunes</option>
                    <option value="2">martes</option>
                    <option value="3">miércoles</option>
                    <option value="4">jueves</option>
                    <option value="5">viernes</option>
                    <option value="6">sábado</option>
                    <option value="0">domingo</option>
                  </select>
                  <span class="atajo__lbl">por</span>
                  <input type="number" id="atajo-n" min="1" max="26" step="1" value="10" />
                  <span class="atajo__lbl">semanas</span>
                </div>

                <div class="cal">
                  <div class="cal__head">
                    <button type="button" class="cal__nav" id="cal-prev" aria-label="Mes anterior">‹</button>
                    <span class="cal__mes" id="cal-mes"></span>
                    <button type="button" class="cal__nav" id="cal-next" aria-label="Mes siguiente">›</button>
                  </div>
                  <div class="cal__wd"><span>L</span><span>M</span><span>X</span><span>J</span><span>V</span><span>S</span><span>D</span></div>
                  <div class="cal__grid" id="cal-grid"></div>
                  <div class="cal__leg">
                    <span><i class="lg lg--on"></i> abierto</span>
                    <span><i class="lg lg--res"></i> con reserva</span>
                    <span><i class="lg lg--sel"></i> viendo</span>
                  </div>
                </div>
              </div>

              <!-- Columna derecha: detalle del día -->
              <div class="disp__dia" id="dia-panel">
                <p class="dia-vacio">Tocá un día del calendario para abrir o gestionar sus turnos.</p>
              </div>
            </div>

            <div class="guardar">
              <button type="button" id="guardar" class="btn btn--primary">Guardar</button>
              <span id="guardar-msg" class="guardar__msg"></span>
            </div>
          </section>

          <section class="card">
            <div class="card__head">
              <div>
                <h2>Agenda de las próximas semanas</h2>
                <p class="muted">Todo lo que tenés abierto y reservado, junto.</p>
              </div>
              <div class="ag-leg">
                <span class="ag-leg__i"><i class="ag-dot ag--mv"></i> Montevideo</span>
                <span class="ag-leg__i"><i class="ag-dot ag--on"></i> Online</span>
                <span class="ag-leg__i"><i class="ag-dot ag--sj"></i> San José</span>
              </div>
            </div>
            <div id="agenda"><p class="muted">Cargando…</p></div>
          </section>

          <section class="card">
            <h2>Reservas ({reservas.length})</h2>
            {reservas.length === 0 ? (
              <p class="muted">Todavía no hay reservas.</p>
            ) : (
              <div class="grid-wrap">
                <table class="grid grid--res">
                  <thead>
                    <tr><th>Servicio</th><th>Sede</th><th>Día</th><th>Hora</th><th>Nombre</th><th>WhatsApp</th><th>Estado</th><th></th></tr>
                  </thead>
                  <tbody>
                    {reservas.map((r) => (
                      <tr>
                        <td>{r.modalidad === 'manual' ? 'Reserva manual' : r.modalidad}</td>
                        <td>{r.sede}</td>
                        <td>{fmtFechaTabla(r.fecha)}</td>
                        <td>{r.hora ?? '—'}</td>
                        <td>{r.nombre}</td>
                        <td>{r.telefono && r.telefono !== '—' ? (
                          <a class="tel-link" href={`https://wa.me/598${String(r.telefono).replace(/\D/g, '').replace(/^(598|0)/, '')}`} target="_blank" rel="noopener">{r.telefono}</a>
                        ) : '—'}</td>
                        <td><span class={`badge badge--${r.estado}`}>{r.estado}</span></td>
                        <td><button class="del" data-id={r.id}>Borrar</button></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>
        </div>
      )}
    </div>
  </main>
</Base>

<script>
  // ---------- Login ----------
  const lf = document.getElementById('login-form') as HTMLFormElement | null;
  lf?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = document.getElementById('login-error');
    const pw = (lf.querySelector('input[name="password"]') as HTMLInputElement).value;
    const res = await fetch('/api/admin/login', {
      method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ password: pw }),
    });
    if (res.ok) location.reload();
    else { const d = await res.json().catch(() => ({})); if (err) { err.textContent = d.error || 'No se pudo entrar.'; err.hidden = false; } }
  });
  document.getElementById('logout')?.addEventListener('click', async () => {
    await fetch('/api/admin/login', { method: 'DELETE' });
    location.reload();
  });

  const panel = document.getElementById('dia-panel');
  if (panel) {
    const $ = (id: string) => document.getElementById(id)!;
    const MESES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
    const pad = (n: number) => String(n).padStart(2, '0');
    const hoyUY = new Date(Date.now() - 3 * 3600 * 1000).toISOString().slice(0, 10);

    // ---------- Estado ----------
    let sede = 'montevideo';
    let durSede: Record<string, number> = { montevideo: 45, 'san-jose': 30, online: 30 };
    // dias: fecha -> { horas:Set<string>, duracion:number }
    let dias = new Map<string, { horas: Set<string>; duracion: number }>();
    // reservas: 'fecha hora' -> { nombre, modalidad }
    let reservasMap = new Map<string, { nombre: string; modalidad: string }>();
    let sel: string | null = null; // fecha seleccionada
    let sucio = false;
    const base = new Date(hoyUY + 'T12:00:00Z');
    let vy = base.getUTCFullYear(), vm = base.getUTCMonth();

    function rangoHoras(desde: string, hasta: string, dur: number): string[] {
      if (!desde || !hasta || !dur || dur <= 0) return [];
      const [dh, dm] = desde.split(':').map(Number);
      const [hh, hm] = hasta.split(':').map(Number);
      const fin = hh * 60 + hm;
      const out: string[] = [];
      for (let t = dh * 60 + dm; t + dur <= fin; t += dur) out.push(`${pad(Math.floor(t / 60))}:${pad(t % 60)}`);
      return out;
    }
    function franjaActual() {
      return {
        desde: ($('f-desde') as HTMLInputElement).value,
        hasta: ($('f-hasta') as HTMLInputElement).value,
        dur: Number(($('f-dur') as HTMLInputElement).value),
      };
    }
    function marcarSucio() { sucio = true; setMsg('Tenés cambios sin guardar.', 'dirty'); }
    function setMsg(txt: string, cls = '') { const m = $('guardar-msg'); m.textContent = txt; m.className = 'guardar__msg' + (cls ? ' guardar__msg--' + cls : ''); }
    // Si la sesión expiró (12 h), los fetch devuelven 401: avisar claro y ofrecer recargar.
    function sesionExpirada(res: Response): boolean {
      if (res.status !== 401) return false;
      setMsg('Tu sesión expiró. Recargá la página e ingresá de nuevo.', 'dirty');
      if (confirm('Tu sesión expiró. ¿Recargar para ingresar de nuevo?')) location.reload();
      return true;
    }

    // ---------- Cargar sede ----------
    async function cargarSede(s: string) {
      sede = s;
      sel = null; sucio = false; setMsg('');
      ($('f-dur') as HTMLInputElement).value = String(durSede[s]);
      try {
        const res = await fetch(`/api/admin/horario?sede=${s}`);
        if (sesionExpirada(res)) return;
        const d = await res.json();
        dias = new Map();
        reservasMap = new Map();
        if (d.ok) {
          for (const f of d.franjas) {
            const dia = dias.get(f.fecha) ?? { horas: new Set<string>(), duracion: Number(f.duracion) || 30 };
            dia.horas.add(f.hora); dia.duracion = Number(f.duracion) || dia.duracion;
            dias.set(f.fecha, dia);
          }
          for (const r of d.reservas) reservasMap.set(`${r.fecha} ${r.hora}`, { nombre: r.nombre, modalidad: r.modalidad });
        }
      } catch { setMsg('No se pudo cargar. Probá de nuevo.', 'dirty'); }
      renderCal(); renderDia(); actualizarPrev();
    }

    // ---------- Preview de la franja ----------
    function actualizarPrev() {
      const { desde, hasta, dur } = franjaActual();
      const n = rangoHoras(desde, hasta, dur).length;
      $('f-prev').textContent = n ? `${n} turno${n > 1 ? 's' : ''}` : '⚠ sin turnos';
      $('f-prev').className = 'franja__prev' + (n ? '' : ' franja__prev--warn');
    }
    ['f-desde', 'f-hasta', 'f-dur'].forEach((id) => $(id).addEventListener('input', actualizarPrev));

    // ---------- Calendario ----------
    function renderCal() {
      $('cal-mes').textContent = `${MESES[vm]} ${vy}`;
      const grid = $('cal-grid');
      grid.innerHTML = '';
      const first = new Date(Date.UTC(vy, vm, 1)).getUTCDay(); // 0=dom
      const offset = (first + 6) % 7; // lunes primero
      for (let i = 0; i < offset; i++) grid.appendChild(cel(''));
      const ndays = new Date(Date.UTC(vy, vm + 1, 0)).getUTCDate();
      for (let d = 1; d <= ndays; d++) {
        const iso = `${vy}-${pad(vm + 1)}-${pad(d)}`;
        grid.appendChild(cel(iso, d));
      }
    }
    function cel(iso: string, day?: number) {
      const el = document.createElement(iso && iso >= hoyUY ? 'button' : 'div');
      el.className = 'cal__cell';
      if (!iso) { el.className += ' cal__cell--empty'; return el; }
      el.textContent = String(day);
      if (iso < hoyUY) { el.className += ' cal__cell--past'; return el; }
      (el as HTMLButtonElement).type = 'button';
      const dia = dias.get(iso);
      if (dia && dia.horas.size) {
        el.className += ' cal__cell--on';
        const conRes = [...dia.horas].some((h) => reservasMap.has(`${iso} ${h}`));
        if (conRes) el.className += ' cal__cell--res';
      }
      if (iso === sel) el.className += ' cal__cell--sel';
      el.addEventListener('click', () => { sel = iso; renderCal(); renderDia(); });
      return el;
    }
    $('cal-prev').addEventListener('click', () => { if (vm === 0) { vm = 11; vy--; } else vm--; renderCal(); });
    $('cal-next').addEventListener('click', () => { if (vm === 11) { vm = 0; vy++; } else vm++; renderCal(); });

    // ---------- Panel del día ----------
    function renderDia() {
      if (!sel) { panel.innerHTML = '<p class="dia-vacio">Tocá un día del calendario para abrir o gestionar sus turnos.</p>'; return; }
      const [y, m, d] = sel.split('-');
      const titulo = new Date(sel + 'T12:00:00Z').toLocaleDateString('es-UY', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
      const dia = dias.get(sel);
      panel.innerHTML = '';

      const h = document.createElement('div'); h.className = 'dia-panel__head';
      h.innerHTML = `<strong>${titulo}</strong>`;
      panel.appendChild(h);

      if (!dia || !dia.horas.size) {
        const p = document.createElement('p'); p.className = 'dia-vacio';
        p.textContent = 'Este día está cerrado. Abrilo con el horario de la izquierda:';
        panel.appendChild(p);
        panel.appendChild(btnAbrir());
        return;
      }

      const horas = [...dia.horas].sort();
      const wrap = document.createElement('div'); wrap.className = 'turnos';
      for (const hora of horas) {
        const key = `${sel} ${hora}`;
        const res = reservasMap.get(key);
        const t = document.createElement('div');
        t.className = 'turno' + (res ? ' turno--res' : '');
        const lbl = document.createElement('span'); lbl.className = 'turno__h'; lbl.textContent = hora;
        t.appendChild(lbl);
        if (res) {
          const n = document.createElement('span'); n.className = 'turno__nom';
          n.textContent = res.modalidad === 'manual' ? res.nombre : `${res.nombre} (web)`;
          t.appendChild(n);
          if (res.modalidad === 'manual') {
            const lib = document.createElement('button'); lib.className = 'turno__lib'; lib.textContent = 'Liberar';
            lib.addEventListener('click', () => liberar(hora));
            t.appendChild(lib);
          }
        } else {
          const marc = document.createElement('button'); marc.className = 'turno__marc'; marc.textContent = 'Marcar reservado';
          marc.addEventListener('click', () => marcarReservado(hora));
          t.appendChild(marc);
          const quitar = document.createElement('button'); quitar.className = 'turno__x'; quitar.setAttribute('aria-label', 'Quitar este turno'); quitar.title = 'Quitar este turno'; quitar.textContent = '✕';
          quitar.addEventListener('click', () => { dia.horas.delete(hora); if (!dia.horas.size) dias.delete(sel!); marcarSucio(); renderCal(); renderDia(); });
          t.appendChild(quitar);
        }
        wrap.appendChild(t);
      }
      panel.appendChild(wrap);

      const acc = document.createElement('div'); acc.className = 'dia-panel__acc';
      acc.appendChild(btnAbrir('Agregar otro horario'));
      const cerrar = document.createElement('button'); cerrar.className = 'btn btn--ghost btn--sm';
      cerrar.textContent = 'Cerrar este día';
      cerrar.addEventListener('click', () => {
        const conRes = horas.some((hh) => reservasMap.has(`${sel} ${hh}`));
        if (conRes && !confirm('Este día tiene reservas. Si lo cerrás, las reservas siguen pero no se ofrecen más turnos nuevos. ¿Seguir?')) return;
        dias.delete(sel!); marcarSucio(); renderCal(); renderDia();
      });
      acc.appendChild(cerrar);
      panel.appendChild(acc);
    }

    function btnAbrir(txt = 'Abrir con este horario') {
      const b = document.createElement('button'); b.className = 'btn btn--primary btn--sm'; b.textContent = txt;
      b.addEventListener('click', () => {
        const { desde, hasta, dur } = franjaActual();
        const horas = rangoHoras(desde, hasta, dur);
        if (!horas.length) { setMsg('Ese horario no genera turnos: revisá desde/hasta/duración.', 'dirty'); return; }
        const dia = dias.get(sel!) ?? { horas: new Set<string>(), duracion: dur };
        horas.forEach((h) => dia.horas.add(h));
        dia.duracion = dur;
        dias.set(sel!, dia);
        marcarSucio(); renderCal(); renderDia();
      });
      return b;
    }

    // ---------- Reserva manual (acción inmediata) ----------
    async function marcarReservado(hora: string) {
      const nombre = prompt('¿A nombre de quién? (nombre de la persona que reservó)');
      if (!nombre || !nombre.trim()) return;
      const res = await fetch('/api/admin/reserva-manual', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ sede, fecha: sel, hora, nombre: nombre.trim() }),
      });
      if (sesionExpirada(res)) return;
      const d = await res.json().catch(() => ({}));
      if (res.ok) { reservasMap.set(`${sel} ${hora}`, { nombre: nombre.trim(), modalidad: 'manual' }); renderCal(); renderDia(); }
      else alert(d.error || 'No se pudo marcar el turno.');
    }
    async function liberar(hora: string) {
      if (!confirm('¿Liberar este turno? Vuelve a quedar disponible para reservar.')) return;
      const res = await fetch(`/api/admin/reserva-manual?sede=${sede}&fecha=${sel}&hora=${hora}`, { method: 'DELETE' });
      if (res.ok) { reservasMap.delete(`${sel} ${hora}`); renderCal(); renderDia(); }
      else alert('No se pudo liberar el turno.');
    }

    // ---------- Atajo repetir (toggle: si ya está aplicado, lo quita) ----------
    let ultimoAtajo: { firma: string; fechas: string[] } | null = null;
    $('atajo-btn').addEventListener('click', () => {
      const { desde, hasta, dur } = franjaActual();
      const horas = rangoHoras(desde, hasta, dur);
      if (!horas.length) { setMsg('Ese horario no genera turnos: revisá desde/hasta/duración.', 'dirty'); return; }
      const dow = Number(($('atajo-dia') as HTMLInputElement).value); // 0=dom
      const n = Math.max(1, Math.min(26, Number(($('atajo-n') as HTMLInputElement).value)));
      const firma = `${dow}|${n}|${desde}|${hasta}|${dur}`;

      // Fechas objetivo: los próximos N días con ese día de la semana.
      let cur = new Date(hoyUY + 'T12:00:00Z');
      while (cur.getUTCDay() !== dow) cur = new Date(cur.getTime() + 86400000);
      const fechas: string[] = [];
      for (let i = 0; i < n; i++) { fechas.push(cur.toISOString().slice(0, 10)); cur = new Date(cur.getTime() + 7 * 86400000); }

      // ¿Ya está aplicado exactamente esto? Entonces este click lo DESHACE.
      const yaAplicado = ultimoAtajo?.firma === firma &&
        fechas.every((f) => { const d = dias.get(f); return d && horas.every((h) => d.horas.has(h)); });

      if (yaAplicado) {
        for (const f of fechas) { const d = dias.get(f); if (d) { horas.forEach((h) => d.horas.delete(h)); if (!d.horas.size) dias.delete(f); } }
        ultimoAtajo = null;
        setMsg(`Quitado de ${fechas.length} días. Tocá "Repetir" otra vez para volver a agregarlo.`, 'dirty');
      } else {
        for (const f of fechas) { const d = dias.get(f) ?? { horas: new Set<string>(), duracion: dur }; horas.forEach((h) => d.horas.add(h)); d.duracion = dur; dias.set(f, d); }
        ultimoAtajo = { firma, fechas };
        setMsg(`Agregado a ${fechas.length} días. Tocá "Repetir" otra vez para deshacerlo, o Guardar para publicar.`, 'dirty');
      }
      sucio = true; renderCal(); renderDia();
    });

    // ---------- Guardar ----------
    $('guardar').addEventListener('click', async (ev) => {
      const btn = ev.currentTarget as HTMLButtonElement;
      const payload = { sede, dias: [...dias.entries()].map(([fecha, d]) => ({ fecha, horas: [...d.horas], duracion: d.duracion })) };
      btn.disabled = true; setMsg('Guardando…');
      try {
        const res = await fetch('/api/admin/horario', {
          method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload),
        });
        if (sesionExpirada(res)) { btn.disabled = false; return; }
        const d = await res.json().catch(() => ({}));
        if (res.ok) { sucio = false; setMsg(`✓ Guardado (${d.turnos} turnos en ${d.dias} días). Ya está publicado.`, 'ok'); }
        else setMsg(`Error: ${d.error || 'no se pudo'}${d.detalle ? ' — ' + d.detalle : ''}`, 'dirty');
      } catch { setMsg('Sin conexión: no se guardó. Probá de nuevo.', 'dirty'); }
      finally { btn.disabled = false; }
    });

    // ---------- Tabs de sede ----------
    document.querySelectorAll<HTMLButtonElement>('.sede-tab').forEach((tab) => {
      durSede[tab.dataset.sede!] = Number(tab.dataset.dur);
      tab.addEventListener('click', async () => {
        if (sucio && !confirm('Tenés cambios sin guardar en esta sede. ¿Cambiar igual y perderlos?')) return;
        document.querySelectorAll('.sede-tab').forEach((t) => t.classList.remove('is-active'));
        tab.classList.add('is-active');
        await cargarSede(tab.dataset.sede!);
      });
    });

    cargarSede('montevideo');
  }

  // ---------- Agenda consolidada (todas las sedes) ----------
  (async function cargarAgenda() {
    const cont = document.getElementById('agenda');
    if (!cont) return;
    const CLS: Record<string, string> = { Montevideo: 'mv', 'San José': 'sj', Online: 'on' };
    try {
      const res = await fetch('/api/admin/resumen');
      if (res.status === 401) { cont.innerHTML = '<p class="muted">Ingresá de nuevo para ver la agenda.</p>'; return; }
      const d = await res.json();
      if (!d.ok) { cont.innerHTML = '<p class="muted">No se pudo cargar la agenda.</p>'; return; }

      // Consolidar: fecha → sede → Map<hora, {reservado, nombre}>
      const porFecha = new Map<string, Map<string, Map<string, any>>>();
      const getSede = (fecha: string, sede: string) => {
        let f = porFecha.get(fecha); if (!f) { f = new Map(); porFecha.set(fecha, f); }
        let s = f.get(sede); if (!s) { s = new Map(); f.set(sede, s); }
        return s;
      };
      for (const fr of d.franjas) { const s = getSede(fr.fecha, fr.sede); if (!s.has(fr.hora)) s.set(fr.hora, { reservado: false }); }
      for (const r of d.reservas) getSede(r.fecha, r.sede).set(r.hora, { reservado: true, nombre: r.nombre });

      const fechas = [...porFecha.keys()].sort();
      if (!fechas.length) { cont.innerHTML = '<p class="muted">No hay turnos abiertos ni reservas todavía. Cargalos arriba en “Tu disponibilidad”.</p>'; return; }
      cont.innerHTML = '';
      for (const fecha of fechas) {
        const titulo = new Date(fecha + 'T12:00:00Z').toLocaleDateString('es-UY', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
        const bloque = document.createElement('div'); bloque.className = 'ag-dia';
        const h = document.createElement('div'); h.className = 'ag-dia__fecha'; h.textContent = titulo; bloque.appendChild(h);
        const sedes = porFecha.get(fecha)!;
        for (const sedeNombre of ['Montevideo', 'San José', 'Online']) {
          const turnos = sedes.get(sedeNombre); if (!turnos) continue;
          const row = document.createElement('div'); row.className = 'ag-sede ag--' + CLS[sedeNombre];
          const lbl = document.createElement('span'); lbl.className = 'ag-sede__nom'; lbl.textContent = sedeNombre; row.appendChild(lbl);
          const chips = document.createElement('div'); chips.className = 'ag-chips';
          for (const hora of [...turnos.keys()].sort()) {
            const t = turnos.get(hora);
            const c = document.createElement('span'); c.className = 'ag-chip' + (t.reservado ? ' ag-chip--res' : '');
            c.textContent = t.reservado ? `${hora} · ${t.nombre}` : hora;
            chips.appendChild(c);
          }
          row.appendChild(chips);
          bloque.appendChild(row);
        }
        cont.appendChild(bloque);
      }
    } catch { cont.innerHTML = '<p class="muted">No se pudo cargar la agenda.</p>'; }
  })();

  // ---------- Borrar reserva (tabla) ----------
  document.querySelectorAll('.del').forEach((b) => {
    b.addEventListener('click', async () => {
      if (!confirm('¿Borrar esta reserva? Se libera el cupo y se quita del calendario.')) return;
      const btn = b as HTMLButtonElement;
      const orig = btn.textContent;
      btn.disabled = true; btn.textContent = 'Borrando…';
      try {
        const res = await fetch(`/api/admin/reserva?id=${btn.dataset.id}`, { method: 'DELETE' });
        if (res.ok) { btn.closest('tr')?.remove(); return; }
        alert('No se pudo borrar. Probá de nuevo.');
      } catch { alert('Sin conexión: no se pudo borrar.'); }
      btn.disabled = false; btn.textContent = orig;
    });
  });
</script>

<style>
