  /* Calendario — limpio, estilo moderno (el estado se marca con fondo, no con cajas) */
  .cal { background: var(--white); border: 1px solid var(--sand); border-radius: var(--radius); padding: 1.1rem 1.2rem 1.2rem; }
  .cal__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
  .cal__mes { font-family: var(--font-serif); font-size: 1.2rem; font-weight: 500; text-transform: capitalize; color: var(--ink); }
  .cal__nav { display: grid; place-items: center; font-size: 1.15rem; line-height: 1; background: none; border: 1px solid var(--sand); border-radius: 50%; width: 34px; height: 34px; cursor: pointer; color: var(--ink-soft); transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease; }
  .cal__nav:hover { border-color: var(--sage); color: var(--sage-deep); background: color-mix(in srgb, var(--sage) 8%, var(--white)); }
  .cal__nav:focus-visible { outline: 2px solid var(--sage); outline-offset: 2px; }
  .cal__wd { display: grid; grid-template-columns: repeat(7, 1fr); margin-bottom: 0.5rem; }
  .cal__wd span { text-align: center; font-size: 0.66rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); }
  .cal__grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; }
  .cal__cell { aspect-ratio: 1; display: grid; place-items: center; font-size: 0.9rem; font-variant-numeric: tabular-nums; border: 0; background: none; color: var(--ink); border-radius: 10px; position: relative; }
  .cal__cell--empty { visibility: hidden; }
  /* Días pasados: caja gris muy tenue, no interactivos. */
  .cal__cell--past { color: color-mix(in srgb, var(--ink-soft) 45%, var(--cream)); background: color-mix(in srgb, var(--sand) 28%, var(--cream)); }
  /* Días futuros disponibles: número nítido, hover suave. */
  button.cal__cell { cursor: pointer; font-weight: 500; transition: background 0.15s ease, color 0.15s ease; }
  button.cal__cell:hover { background: color-mix(in srgb, var(--sage) 14%, var(--white)); color: var(--sage-deep); }
  button.cal__cell:focus-visible { outline: 2px solid var(--sage); outline-offset: 1px; }
  /* Día abierto: fondo salvia pleno. */
