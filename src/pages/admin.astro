---
export const prerender = false;

import Base from '../layouts/Base.astro';
import { isAdmin } from '../lib/admin';
import { getSql, ensureFranjas } from '../lib/db';

const authed = isAdmin(Astro.cookies);

const LUGARES = [
  { slug: 'montevideo', nombre: 'Montevideo' },
  { slug: 'san-jose', nombre: 'San José' },
  { slug: 'online', nombre: 'Online (Virtual / Skincare Inteligente)' },
];
// Intervalo de turnos por sede (minutos) — se muestra como referencia
const SEDE_INTERVALO: Record<string, number> = { montevideo: 45, 'san-jose': 30, online: 30 };

// Calendario de los próximos meses para que Ceci marque sus días
const HOY_ISO = new Date().toISOString().slice(0, 10);
const WD = ['L', 'M', 'X', 'J', 'V', 'S', 'D'];
type Celda = { iso: string; day: number; sel: boolean } | null;
function calMeses(cant: number) {
  const out: { label: string; cells: Celda[] }[] = [];
  const base = new Date();
  let y = base.getUTCFullYear();
  let mo = base.getUTCMonth();
  for (let i = 0; i < cant; i++) {
    const firstDow = new Date(Date.UTC(y, mo, 1)).getUTCDay();
    const offset = (firstDow + 6) % 7;
    const ndays = new Date(Date.UTC(y, mo + 1, 0)).getUTCDate();
    const cells: Celda[] = [];
    for (let k = 0; k < offset; k++) cells.push(null);
    for (let day = 1; day <= ndays; day++) {
      const iso = `${y}-${String(mo + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
      cells.push({ iso, day, sel: iso >= HOY_ISO });
    }
    out.push({
      label: new Date(Date.UTC(y, mo, 1)).toLocaleDateString('es-UY', { month: 'long', year: 'numeric', timeZone: 'UTC' }),
      cells,
    });
    mo++; if (mo > 11) { mo = 0; y++; }
  }
  return out;
}
const CAL = calMeses(3);

// Corte Mañana / Tarde (debe coincidir con el del endpoint)
const CORTE = '13:00';
type Bloque = 'manana' | 'tarde' | 'dia';
const config: Record<string, { dias: Record<string, Bloque>; llenas: Set<string> }> = {
  montevideo: { dias: {}, llenas: new Set() },
  'san-jose': { dias: {}, llenas: new Set() },
  online: { dias: {}, llenas: new Set() },
};
let reservas: any[] = [];
let dbError = '';

if (authed) {
  try {
    const sql = getSql();
    await ensureFranjas(sql);
    const fr = await sql`
      select coalesce(s.nombre, 'Online') as lugar, f.fecha::text as fecha, to_char(f.hora,'HH24:MI') as hora
      from franjas f left join sedes s on s.id = f.sede_id
      where f.fecha >= current_date
    `;
    const map: Record<string, string> = { Montevideo: 'montevideo', 'San José': 'san-jose', Online: 'online' };
    // Reconstruir el bloque (mañana/tarde/día) de cada fecha a partir de sus horas guardadas
    const horasPorFecha: Record<string, Record<string, Set<string>>> = { montevideo: {}, 'san-jose': {}, online: {} };
    for (const r of fr as any[]) {
      const slug = map[r.lugar] ?? 'online';
      (horasPorFecha[slug][r.fecha] ??= new Set()).add(r.hora);
    }
    for (const slug of Object.keys(horasPorFecha)) {
      for (const [fecha, horas] of Object.entries(horasPorFecha[slug])) {
        const arr = [...horas];
        const m = arr.some((h) => h < CORTE);
        const t = arr.some((h) => h >= CORTE);
        config[slug].dias[fecha] = m && t ? 'dia' : t ? 'tarde' : 'manana';
      }
    }
    const bl = await sql`
      select coalesce(s.nombre, 'Online') as lugar, b.fecha::text as fecha
      from bloqueos b left join sedes s on s.id = b.sede_id
      where b.fecha >= current_date
    `;
    for (const r of bl as any[]) {
      const slug = map[r.lugar] ?? 'online';
      config[slug].llenas.add(r.fecha);
    }
    reservas = (await sql`
      select r.id, r.modalidad, coalesce(s.nombre, 'Online') as sede,
             r.fecha::text as fecha, to_char(r.hora,'HH24:MI') as hora,
             r.nombre, r.telefono, r.estado
      from reservas r left join sedes s on s.id = r.sede_id
      order by r.created_at desc limit 50
    `) as any[];
  } catch (e) {
    dbError = e instanceof Error ? e.message : String(e);
  }
}
---

<Base title="Panel de Ceci" path="/admin">
  <main class="admin">
    <div class="container">
      {!authed ? (
        <div class="login">
          <h1>Panel de Ceci</h1>
          <p>Ingresá tu contraseña para administrar horarios y ver reservas.</p>
          <form id="login-form">
            <input type="password" name="password" placeholder="Contraseña" autocomplete="current-password" required />
            <button type="submit" class="btn btn--primary">Entrar</button>
          </form>
          <p id="login-error" class="login__err" hidden></p>
        </div>
      ) : (
        <div class="panel">
          <header class="panel__head">
            <h1>Panel de Ceci</h1>
            <button id="logout" class="btn btn--ghost">Salir</button>
          </header>

          {dbError && <p class="login__err">Error de base de datos: {dbError}</p>}

          <section class="card">
            <h2>Tu disponibilidad</h2>
            <p class="muted">Elegí un <strong>pincel</strong> y tocá los días en cada lugar. Podés combinar mañana, tarde, todo el día y días llenos sin perder lo anterior. Las clientas solo verán los días y horarios que marques. <strong>Nada se guarda hasta que tocás “Confirmar”.</strong></p>

            {LUGARES.map((lugar) => (
              <div class="sede-block" data-sede={lugar.slug} data-brush="manana">
                <div class="sede-block__top">
                  <h3>{lugar.nombre} <span class="sede-int">· turnos cada {SEDE_INTERVALO[lugar.slug]} min</span></h3>
                  <span class="dirty-flag" data-dirty={lugar.slug} hidden>● Cambios sin confirmar</span>
                </div>

                <div class="brushes" role="group" aria-label="Pincel para marcar días">
                  <button type="button" class="brush brush--manana is-active" data-brush="manana">Mañana</button>
                  <button type="button" class="brush brush--tarde" data-brush="tarde">Tarde</button>
                  <button type="button" class="brush brush--dia" data-brush="dia">Todo el día</button>
                  <button type="button" class="brush brush--lleno" data-brush="lleno">Lleno</button>
                  <button type="button" class="brush brush--borrar" data-brush="borrar">Borrar</button>
                </div>

                <div class="acals">
                  {CAL.map((mes) => (
                    <div class="acal">
                      <div class="acal__head">{mes.label}</div>
                      <div class="acal__grid">
                        {WD.map((w) => <div class="acal__wd">{w}</div>)}
                        {mes.cells.map((c) => {
                          if (!c) return <div class="acal__cell acal__cell--empty"></div>;
                          if (!c.sel) return <div class="acal__cell acal__cell--past">{c.day}</div>;
                          const saved = config[lugar.slug].llenas.has(c.iso)
                            ? 'lleno'
                            : (config[lugar.slug].dias[c.iso] ?? '');
                          return (
                            <button
                              type="button"
                              class:list={['acal__cell', 'acal__cell--btn', saved && `is-${saved}`]}
                              data-lugar={lugar.slug}
                              data-fecha={c.iso}
                              data-saved={saved}
                              data-state={saved}
                            >{c.day}</button>
                          );
                        })}
                      </div>
                    </div>
                  ))}
                </div>

                <p class="resumen" data-resumen={lugar.slug}></p>

                <div class="sede-actions">
                  <button class="btn btn--primary btn--sm" data-confirmar={lugar.slug}>Confirmar {lugar.nombre}</button>
                  <button class="btn btn--ghost btn--sm" data-limpiar={lugar.slug}>Limpiar selección</button>
                  <span class="sede-msg" data-msg={lugar.slug}></span>
                </div>
              </div>
            ))}
          </section>

          <section class="card">
            <h2>Reservas ({reservas.length})</h2>
            {reservas.length === 0 ? (
              <p class="muted">Todavía no hay reservas.</p>
            ) : (
              <div class="grid-wrap">
                <table class="grid grid--res">
                  <thead>
                    <tr><th>Servicio</th><th>Sede</th><th>Día</th><th>Hora</th><th>Nombre</th><th>WhatsApp</th><th>Estado</th><th></th></tr>
                  </thead>
                  <tbody>
                    {reservas.map((r) => (
                      <tr>
                        <td>{r.modalidad}</td>
                        <td>{r.sede}</td>
                        <td>{r.fecha ?? '—'}</td>
                        <td>{r.hora ?? '—'}</td>
                        <td>{r.nombre}</td>
                        <td>{r.telefono}</td>
                        <td><span class={`badge badge--${r.estado}`}>{r.estado}</span></td>
                        <td><button class="del" data-id={r.id}>Borrar</button></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>
        </div>
      )}
    </div>
  </main>
</Base>

<script>
  const lf = document.getElementById('login-form');
  lf?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = document.getElementById('login-error');
    const pw = (lf.querySelector('input[name="password"]') as HTMLInputElement).value;
    const res = await fetch('/api/admin/login', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ password: pw }),
    });
    if (res.ok) location.reload();
    else {
      const d = await res.json().catch(() => ({}));
      if (err) { err.textContent = d.error || 'No se pudo entrar.'; err.hidden = false; }
    }
  });

  document.getElementById('logout')?.addEventListener('click', async () => {
    await fetch('/api/admin/login', { method: 'DELETE' });
    location.reload();
  });

  // ----- Disponibilidad: pinceles + confirmar todo -----
  const ETIQ: Record<string, string> = { manana: 'Mañana', tarde: 'Tarde', dia: 'Todo el día', lleno: 'Llenos' };
  // Cantidad de turnos que genera cada bloque, por sede (intervalo en min, corte 13:00)
  const INTERVALO: Record<string, number> = { montevideo: 45, 'san-jose': 30, online: 30 };
  function nSlots(sede: string, bloque: string): number {
    const step = INTERVALO[sede] ?? 30;
    let manana = 0, tarde = 0;
    for (let t = 8 * 60; t <= 20 * 60 + 30; t += step) (t < 13 * 60 ? manana++ : tarde++);
    if (bloque === 'manana') return manana;
    if (bloque === 'tarde') return tarde;
    return manana + tarde; // dia
  }
  const fmtDia = (iso: string) => { const [, m, d] = iso.split('-'); return `${+d}/${+m}`; };

  function cellsDe(block: HTMLElement) {
    return [...block.querySelectorAll('.acal__cell--btn')] as HTMLElement[];
  }
  function pintar(cell: HTMLElement, state: string) {
    cell.classList.remove('is-manana', 'is-tarde', 'is-dia', 'is-lleno');
    cell.dataset.state = state;
    if (state) cell.classList.add('is-' + state);
  }
  function estaSucio(block: HTMLElement) {
    return cellsDe(block).some((c) => (c.dataset.state || '') !== (c.dataset.saved || ''));
  }
  function refrescar(block: HTMLElement) {
    const sede = block.dataset.sede!;
    const grupos: Record<string, string[]> = { manana: [], tarde: [], dia: [], lleno: [] };
    for (const c of cellsDe(block)) { const s = c.dataset.state || ''; if (grupos[s]) grupos[s].push(c.dataset.fecha!); }
    let turnos = 0;
    const partes: string[] = [];
    for (const k of ['manana', 'tarde', 'dia', 'lleno']) {
      const dias = grupos[k];
      if (!dias.length) continue;
      if (k !== 'lleno') turnos += dias.reduce((acc) => acc + nSlots(sede, k), 0);
      const lista = dias.sort().map(fmtDia).join(', ');
      partes.push(`<b>${ETIQ[k]}</b> (${dias.length}): ${lista}`);
    }
    const res = block.querySelector(`[data-resumen="${sede}"]`) as HTMLElement;
    if (res) {
      res.innerHTML = partes.length
        ? partes.join(' &nbsp;·&nbsp; ') + ` &nbsp;·&nbsp; <span class="resumen__tot">${turnos} turnos para reservar</span>`
        : '<span class="resumen__vacio">Sin días marcados. Elegí un pincel y tocá los días.</span>';
    }
    const flag = block.querySelector(`[data-dirty="${sede}"]`) as HTMLElement;
    if (flag) flag.hidden = !estaSucio(block);
  }

  document.querySelectorAll<HTMLElement>('.sede-block').forEach((block) => {
    const sede = block.dataset.sede!;

    // Elegir pincel
    block.querySelectorAll<HTMLElement>('.brush').forEach((b) =>
      b.addEventListener('click', () => {
        block.dataset.brush = b.dataset.brush;
        block.querySelectorAll('.brush').forEach((x) => x.classList.toggle('is-active', x === b));
      })
    );

    // Pintar días con el pincel activo
    cellsDe(block).forEach((cell) =>
      cell.addEventListener('click', () => {
        const brush = block.dataset.brush || 'manana';
        pintar(cell, brush === 'borrar' ? '' : brush);
        refrescar(block);
      })
    );

    // Limpiar selección → vuelve a lo último confirmado (no toca la base)
    block.querySelector(`[data-limpiar="${sede}"]`)?.addEventListener('click', () => {
      cellsDe(block).forEach((c) => pintar(c, c.dataset.saved || ''));
      const msg = block.querySelector(`[data-msg="${sede}"]`) as HTMLElement;
      if (msg) msg.textContent = '';
      refrescar(block);
    });

    // Confirmar → guarda la foto completa de la sede
    block.querySelector(`[data-confirmar="${sede}"]`)?.addEventListener('click', async () => {
      const cells = cellsDe(block);
      const dias = cells
        .filter((c) => ['manana', 'tarde', 'dia'].includes(c.dataset.state || ''))
        .map((c) => ({ fecha: c.dataset.fecha, bloque: c.dataset.state }));
      const llenas = cells.filter((c) => c.dataset.state === 'lleno').map((c) => c.dataset.fecha);
      const msg = block.querySelector(`[data-msg="${sede}"]`) as HTMLElement;
      if (msg) msg.textContent = 'Guardando…';
      const res = await fetch('/api/admin/disponibilidad', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ lugar: sede, dias, llenas }),
      });
      const d = await res.json().catch(() => ({}));
      if (res.ok) {
        cells.forEach((c) => (c.dataset.saved = c.dataset.state || ''));
        refrescar(block);
        if (msg) msg.textContent = `✓ Confirmado: ${d.fechas} días · ${d.turnos} turnos${d.llenas ? ` · ${d.llenas} llenos` : ''}`;
      } else if (msg) {
        msg.textContent = `Error: ${d.error || 'no se pudo'}`;
      }
    });

    refrescar(block);
  });

  // Borrar reserva
  document.querySelectorAll('.del').forEach((b) => {
    b.addEventListener('click', async () => {
      if (!confirm('¿Borrar esta reserva? Se libera el cupo.')) return;
      const id = (b as HTMLElement).dataset.id;
      const res = await fetch(`/api/admin/reserva?id=${id}`, { method: 'DELETE' });
      if (res.ok) (b as HTMLElement).closest('tr')?.remove();
      else alert('No se pudo borrar.');
    });
  });
</script>

<style>
  .admin { padding-block: clamp(2rem, 5vw, 3.5rem); }
  .login { max-width: 380px; margin: 2rem auto; text-align: center; }
  .login h1 { margin-bottom: 0.6rem; }
  .login form { display: flex; flex-direction: column; gap: 0.8rem; margin-top: 1.4rem; }
  .login input { font: inherit; padding: 0.7rem 0.9rem; border: 1px solid var(--sand); border-radius: var(--radius-sm); background: var(--white); }
  .login__err { color: var(--clay-deep); font-size: 0.9rem; margin-top: 0.8rem; }

  .panel__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
  .panel__head h1 { font-size: clamp(1.6rem, 3vw, 2rem); }
  .muted { color: var(--ink-soft); font-size: 0.92rem; margin-bottom: 1rem; }
  .card { margin-bottom: 2rem; }
  .card h2 { font-size: 1.4rem; margin-bottom: 0.4rem; }

  .sede-block { margin-top: 1.6rem; padding-top: 1.2rem; border-top: 1px solid var(--sand); }
  .sede-block__top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .sede-block__top h3 { font-size: 1.1rem; }
  .sede-int { font-weight: 400; font-size: 0.82rem; color: var(--ink-soft); }
  .dirty-flag { font-size: 0.8rem; color: var(--clay-deep); font-weight: 600; }
  .btn--sm { padding: 0.45rem 1rem; font-size: 0.88rem; }

  .brushes { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0 0.9rem; }
  .brush { font: inherit; font-size: 0.84rem; font-weight: 600; padding: 0.4rem 0.85rem; border-radius: 999px; border: 1.5px solid var(--sand); background: var(--white); color: var(--ink); cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem; transition: border-color 0.12s, box-shadow 0.12s; }
  .brush::before { content: ''; width: 11px; height: 11px; border-radius: 6px; background: var(--swatch, var(--sand)); }
  .brush--manana { --swatch: color-mix(in srgb, var(--sage) 38%, var(--cream)); }
  .brush--tarde { --swatch: var(--sage); }
  .brush--dia { --swatch: var(--sage-deep); }
  .brush--lleno { --swatch: #c0392b; }
  .brush--borrar::before { border: 1px solid var(--sand); background: var(--white); }
  .brush.is-active { border-color: var(--ink); box-shadow: 0 0 0 1px var(--ink); }

  .acals { display: flex; flex-wrap: wrap; gap: 1.4rem; margin-top: 0.4rem; }
  .acal { width: 224px; }
  .acal__head { font-family: var(--font-serif); font-size: 0.98rem; text-transform: capitalize; margin-bottom: 0.4rem; color: var(--ink); }
  .acal__grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; }
  .acal__wd { text-align: center; font-size: 0.62rem; font-weight: 600; color: var(--ink-soft); }
  .acal__cell { aspect-ratio: 1; display: grid; place-items: center; font-size: 0.78rem; border-radius: 6px; border: 1px solid transparent; }
  .acal__cell--empty { border: 0; }
  .acal__cell--past { color: color-mix(in srgb, var(--ink-soft) 35%, var(--cream)); }
  .acal__cell--btn { background: var(--white); border-color: var(--sand); color: var(--ink); cursor: pointer; transition: background 0.1s, border-color 0.1s, color 0.1s; }
  .acal__cell--btn:hover { border-color: var(--sage); }
  .acal__cell--btn.is-manana { background: color-mix(in srgb, var(--sage) 38%, var(--cream)); color: var(--sage-deep); border-color: color-mix(in srgb, var(--sage) 55%, var(--cream)); font-weight: 600; }
  .acal__cell--btn.is-tarde { background: var(--sage); color: var(--cream); border-color: var(--sage); font-weight: 600; }
  .acal__cell--btn.is-dia { background: var(--sage-deep); color: var(--cream); border-color: var(--sage-deep); font-weight: 600; }
  .acal__cell--btn.is-lleno { background: #c0392b; color: #fff; border-color: #c0392b; font-weight: 600; }

  .resumen { font-size: 0.84rem; color: var(--ink-soft); line-height: 1.7; margin: 0.4rem 0 0.9rem; }
  .resumen b { color: var(--ink); }
  .resumen__tot { color: var(--sage-deep); font-weight: 600; }

  .sede-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem; }
  .sede-msg { font-size: 0.85rem; color: var(--sage-deep); min-height: 1.2em; }

  .grid-wrap { overflow-x: auto; }
  .grid { border-collapse: collapse; font-size: 0.85rem; width: 100%; }
  .grid th, .grid td { border: 1px solid var(--sand); padding: 0.4rem 0.6rem; text-align: left; }
  .grid th { background: var(--cream-deep); font-weight: 600; }
  .badge { font-size: 0.75rem; padding: 0.15rem 0.5rem; border-radius: 999px; background: var(--sand); color: var(--ink); }
  .badge--confirmada { background: color-mix(in srgb, var(--sage) 35%, var(--cream)); color: var(--sage-deep); }
  .badge--cancelada, .badge--expirada { background: color-mix(in srgb, var(--clay) 30%, var(--cream)); color: var(--clay-deep); }
  .del { background: none; border: 0; color: var(--clay-deep); cursor: pointer; font-size: 0.82rem; text-decoration: underline; }
  .del:hover { color: var(--ink); }
</style>
