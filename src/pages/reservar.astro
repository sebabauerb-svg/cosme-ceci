---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsappFloat from '../components/WhatsappFloat.astro';
import { modalidades } from '../data/modalidades';
import { site, whatsappLink } from '../data/site';

const waReprogramar = whatsappLink('Hola Ceci! Necesito reprogramar mi turno reservado por la web.');

const items = modalidades.map((m) => ({
  id: m.id,
  nombre: m.nombre,
  subtitulo: m.subtitulo,
  precio: m.precio ?? 'A coordinar',
  precioNota: m.precioNota ?? '',
  esMembresia: m.id === 'club', // el Club es membresía anual, no turno suelto
}));
---

<Base title="Reservá tu turno" description="Reservá tu consulta con Cecilia Gutiérrez: presencial en Montevideo y San José, o virtual. Pago simple y seguro con MercadoPago." path="/reservar" noindex>
  <Nav />

  <main id="contenido" class="section booking">
    <div class="container booking__wrap">
      <header class="booking__head">
        <span class="eyebrow">Reservá tu turno</span>
        <h1>Coordinemos tu atención</h1>
        <p class="booking__lead">Elegí la modalidad y el horario que mejor te queden. Te toma un minuto.</p>
        <ol class="booking__steps" aria-hidden="true">
          <li data-ind="1" class="is-active">Modalidad</li>
          <li data-ind="2">Fecha y hora</li>
          <li data-ind="3">Tus datos</li>
          <li data-ind="4">Pago</li>
        </ol>
      </header>

      <div id="booking-alert" class="booking__alert" role="alert" hidden></div>

      <!-- Paso 1: Modalidad (renderizado en el servidor → estilos aplican) -->
      <section class="step is-active" data-step="1" aria-label="Elegí la modalidad">
        <h2 class="step__title">¿Qué querés reservar?</h2>
        <div class="opts">
          {items.map((m) => (
            <button class="opt" data-id={m.id}>
              <span class="opt__head">
                <span class="opt__name">{m.nombre}</span>
                <span class="opt__price">{m.precio}</span>
              </span>
              <span class="opt__sub">{m.subtitulo}</span>
              {m.precioNota && <span class="opt__nota">{m.precioNota}</span>}
              <span class="opt__cta" aria-hidden="true">Elegir →</span>
            </button>
          ))}
        </div>
      </section>

      <!-- Paso 2: Fecha y hora -->
      <section class="step" data-step="2" hidden aria-label="Elegí fecha y hora">
        <h2 class="step__title">Elegí día y horario</h2>

        <!-- Sede: solo para Consulta Presencial -->
        <div class="sede" id="sede" hidden>
          <p class="cal__label">¿Dónde preferís atenderte?</p>
          <div class="sede__opts">
            <button class="sede__btn" data-sede="Montevideo" aria-pressed="false">Montevideo</button>
            <button class="sede__btn" data-sede="San José" aria-pressed="false">San José</button>
          </div>
        </div>

        <div id="agenda" hidden>
          <p class="cal__label" id="dias-label">Días disponibles</p>
          <div class="cal__days" id="dias"></div>
          <p class="cal__label" id="slots-label" hidden>Horarios</p>
          <div class="cal__slots" id="horarios"></div>
        </div>

        <div class="step__nav">
          <button class="btn btn--ghost" data-back>← Volver</button>
        </div>
      </section>

      <!-- Paso 3: Datos -->
      <section class="step" data-step="3" hidden aria-label="Tus datos">
        <h2 class="step__title">Tus datos</h2>
        <form id="form" class="form" novalidate>
          <label>Nombre y apellido
            <input type="text" name="nombre" required autocomplete="name" placeholder="Tu nombre" />
          </label>
          <label>WhatsApp
            <input type="tel" name="tel" required autocomplete="tel" placeholder="09x xxx xxx" />
          </label>
          <label>Email (opcional)
            <input type="email" name="email" autocomplete="email" placeholder="tu@email.com" />
          </label>
          <p class="form__note">Tus datos se usan solo para coordinar tu atención.</p>
          <div class="step__nav">
            <button type="button" class="btn btn--ghost" data-back>← Volver</button>
            <button type="submit" class="btn btn--primary">Continuar al pago</button>
          </div>
        </form>
      </section>

      <!-- Paso 4: Resumen + pago -->
      <section class="step" data-step="4" hidden aria-label="Confirmar reserva">
        <h2 class="step__title">Confirmá tu reserva</h2>
        <div class="resumen" id="resumen"></div>
        <ul class="trust">
          <li>Pagando con MercadoPago tu turno queda confirmado al instante</li>
          <li>O reservás y coordinás con Ceci: te guardamos el cupo 2 h</li>
          <li>¿Necesitás reprogramar? <a href={waReprogramar} target="_blank" rel="noopener">Escribinos por WhatsApp</a> y lo vemos sin problema</li>
        </ul>
        <button class="btn btn--primary pay" id="confirmar">Pagar ahora con MercadoPago</button>
        <p class="step__hint center" id="hint-mp">Pago seguro con MercadoPago. Tu turno queda confirmado al instante.</p>
        <div class="pay-sep" id="pay-sep"><span>o</span></div>
        <button class="btn btn--ghost pay" id="coordinar">Reservar y coordinar con Ceci</button>
        <p class="step__hint center" id="hint-coord">Te guardamos el cupo 2 h y Ceci confirma tu turno. Le avisás por WhatsApp.</p>
        <div class="step__nav center">
          <button class="btn btn--ghost" data-back>← Volver</button>
        </div>
      </section>

      <!-- Paso 5: Confirmación -->
      <section class="step step--done" data-step="5" hidden aria-label="Reserva confirmada">
        <div class="done">
          <span class="done__check" aria-hidden="true">✓</span>
          <h2>¡Casi listo!</h2>
          <p id="done-text"></p>
          <p class="step__hint" id="done-hint">Para confirmar tu turno, aboná tu reserva y avisale a Ceci por WhatsApp. El cupo queda reservado mientras tanto.</p>
          <a id="pago-link" class="btn btn--primary pay" target="_blank" rel="noopener" hidden>Pagar mi reserva</a>
          <a id="wa-link" class="btn btn--ghost" target="_blank" rel="noopener" hidden>Avisar a Ceci por WhatsApp</a>
          <a href="/reservar" class="btn btn--ghost">Hacer otra reserva</a>
        </div>
      </section>
    </div>
  </main>

  <Footer />
  <WhatsappFloat />
</Base>

<script define:vars={{ items, whatsapp: site.contacto.whatsapp, pago: site.enlaces.pagoMercadoPago }}>
  const state = { modalidad: null, sedeSlug: 'online', lugar: null, fecha: null, fechaLabel: null, hora: null, nombre: '', tel: '', email: '' };
  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => [...r.querySelectorAll(s)];

  // Banner de aviso en la paleta (en lugar de alert() nativo)
  function showAlert(msg) {
    const el = $('#booking-alert');
    if (!el) return;
    el.textContent = msg;
    el.hidden = false;
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  function clearAlert() {
    const el = $('#booking-alert');
    if (el) el.hidden = true;
  }

  function goTo(step) {
    clearAlert();
    let activo = null;
    $$('.step').forEach((el) => {
      const active = Number(el.dataset.step) === step;
      el.toggleAttribute('hidden', !active);
      el.classList.toggle('is-active', active);
      if (active) activo = el;
    });
    $$('.booking__steps li').forEach((li) =>
      li.classList.toggle('is-active', Number(li.dataset.ind) <= step)
    );
    // Mover el foco al título del paso: sin esto, teclado y lector de pantalla
    // quedan sobre un botón ahora oculto y no se anuncia el cambio de paso.
    const titulo = activo?.querySelector('.step__title, h2');
    if (titulo) {
      titulo.setAttribute('tabindex', '-1');
      titulo.focus({ preventScroll: true });
    }
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  const slugSede = (lugar) =>
    lugar === 'Montevideo' ? 'montevideo' : lugar === 'San José' ? 'san-jose' : 'online';

  // Paso 1: opciones
  $$('.opt').forEach((b) =>
    b.addEventListener('click', () => {
      const m = items.find((i) => i.id === b.dataset.id);
      state.modalidad = m;
      state.lugar = null;
      // El Club no agenda turno: ocultamos el paso "Fecha y hora" del indicador.
      const stepFecha = $('.booking__steps li[data-ind="2"]');
      if (stepFecha) stepFecha.hidden = m.esMembresia;
      if (m.esMembresia) return goTo(3);
      const presencial = m.id === 'presencial';
      $('#sede').hidden = !presencial;
      $('#agenda').hidden = true;
      $$('.sede__btn').forEach((s) => s.classList.remove('is-sel'));
      goTo(2);
      if (!presencial) {
        // virtual / skincare = online: cargamos disponibilidad directo
        state.sedeSlug = 'online';
        $('#dias-label').textContent = 'Días disponibles';
        $('#agenda').hidden = false;
        cargarDisponibilidad('online');
      }
    })
  );

  // Sede (presencial): al elegir, cargamos la disponibilidad de esa sede
  $$('.sede__btn').forEach((s) =>
    s.addEventListener('click', () => {
      $$('.sede__btn').forEach((x) => {
        x.classList.remove('is-sel');
        x.setAttribute('aria-pressed', 'false');
      });
      s.classList.add('is-sel');
      s.setAttribute('aria-pressed', 'true');
      state.lugar = s.dataset.sede;
      state.sedeSlug = slugSede(state.lugar);
      $('#agenda').hidden = false;
      $('#dias-label').textContent = `Días disponibles en ${state.lugar}`;
      cargarDisponibilidad(state.sedeSlug);
    })
  );

  // Paso 2: disponibilidad real desde la API (excluye turnos ya tomados)
  async function cargarDisponibilidad(sedeSlug) {
    const dias = $('#dias');
    dias.innerHTML = '<p class="cal__msg">Buscando fechas…</p>';
    $('#horarios').innerHTML = '';
    $('#slots-label').hidden = true;
    try {
      const res = await fetch(`/api/disponibilidad?sede=${encodeURIComponent(sedeSlug)}`);
      const data = await res.json();
      if (!data.ok) throw new Error(data.error || 'error');
      renderCalendario(data);
    } catch (e) {
      dias.innerHTML = '<p class="cal__msg">No pudimos cargar las fechas. Probá de nuevo.</p>';
    }
  }

  const MESES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
  const WD = ['L', 'M', 'X', 'J', 'V', 'S', 'D'];
  const pad2 = (n) => String(n).padStart(2, '0');

  function renderCalendario(data) {
    const slots = data.slots || [];
    const llenas = new Set(data.llenas || []);
    const cont = $('#dias');
    cont.innerHTML = '';
    $('#horarios').innerHTML = '';
    $('#slots-label').hidden = true;
    if (!slots.length && !llenas.size) {
      cont.innerHTML = `<p class="cal__msg">No hay fechas disponibles para esta opción por ahora. <a href="https://wa.me/${whatsapp}" target="_blank" rel="noopener" style="color:var(--sage-deep);font-weight:600">Escribinos por WhatsApp</a> y coordinamos.</p>`;
      return;
    }
    const byFecha = {};
    slots.forEach((s) => (byFecha[s.fecha] = s));
    const disp = new Set(slots.map((s) => s.fecha));

    const todas = [...disp, ...llenas].sort();
    // Mes inicial: el de la primera fecha con datos (la fecha del navegador en UTC
    // corre un día después de las 21:00 de Uruguay y saltearía el mes en curso).
    const [hy, hm] = todas[0].split('-').map(Number);
    const [ly, lm] = todas[todas.length - 1].split('-').map(Number);
    const meses = [];
    let y = hy, m = hm;
    for (let i = 0; i < 6; i++) {
      meses.push({ y, m });
      if (y === ly && m === lm) break;
      m++; if (m > 12) { m = 1; y++; }
    }

    meses.forEach(({ y, m }) => {
      const wrap = document.createElement('div');
      wrap.className = 'cal2';
      const head = document.createElement('div');
      head.className = 'cal2__head';
      head.textContent = `${MESES[m - 1]} ${y}`;
      wrap.appendChild(head);
      const grid = document.createElement('div');
      grid.className = 'cal2__grid';
      WD.forEach((w) => {
        const e = document.createElement('div');
        e.className = 'cal2__wd';
        e.textContent = w;
        grid.appendChild(e);
      });
      const firstDow = new Date(Date.UTC(y, m - 1, 1)).getUTCDay();
      const offset = (firstDow + 6) % 7;
      for (let i = 0; i < offset; i++) {
        const e = document.createElement('div');
        e.className = 'cal2__cell cal2__cell--empty';
        grid.appendChild(e);
      }
      const ndays = new Date(Date.UTC(y, m, 0)).getUTCDate();
      for (let day = 1; day <= ndays; day++) {
        const iso = `${y}-${pad2(m)}-${pad2(day)}`;
        const on = disp.has(iso);
        const full = !on && llenas.has(iso);
        const cell = document.createElement(on ? 'button' : 'div');
        cell.className = 'cal2__cell ' + (on ? 'cal2__cell--on' : full ? 'cal2__cell--full' : 'cal2__cell--off');
        cell.textContent = String(day);
        if (on) {
          cell.type = 'button';
          cell.setAttribute('aria-pressed', 'false');
          cell.setAttribute('aria-label', byFecha[iso].label || iso);
          cell.addEventListener('click', () => {
            $$('.cal2__cell--sel').forEach((x) => {
              x.classList.remove('cal2__cell--sel');
              x.setAttribute('aria-pressed', 'false');
            });
            cell.classList.add('cal2__cell--sel');
            cell.setAttribute('aria-pressed', 'true');
            state.fecha = iso;
            state.fechaLabel = byFecha[iso].label;
            renderSlots(byFecha[iso].horas);
          });
        }
        grid.appendChild(cell);
      }
      wrap.appendChild(grid);
      cont.appendChild(wrap);
    });
    const leg = document.createElement('div');
    leg.className = 'cal2__leg';
    leg.innerHTML =
      '<span><i class="cal2__lg cal2__lg--on"></i> Disponible</span><span><i class="cal2__lg cal2__lg--full"></i> Lleno</span>';
    cont.appendChild(leg);
  }

  function renderSlots(horas) {
    const cont = $('#horarios');
    cont.innerHTML = '';
    $('#slots-label').hidden = false;
    const grupo = (titulo, hs) => {
      if (!hs.length) return;
      const g = document.createElement('div');
      g.className = 'slots-group';
      const t = document.createElement('p');
      t.className = 'slots-group__t';
      t.textContent = titulo;
      g.appendChild(t);
      const row = document.createElement('div');
      row.className = 'slots-row';
      hs.forEach((h) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'cal__slot';
        b.textContent = h;
        b.setAttribute('aria-pressed', 'false');
        b.addEventListener('click', () => {
          $$('.cal__slot').forEach((x) => x.setAttribute('aria-pressed', 'false'));
          b.setAttribute('aria-pressed', 'true');
          state.hora = h;
          goTo(3);
        });
        row.appendChild(b);
      });
      g.appendChild(row);
      cont.appendChild(g);
    };
    grupo('Mañana', horas.filter((h) => h < '13:00'));
    grupo('Tarde', horas.filter((h) => h >= '13:00'));
  }

  // Paso 3: datos
  $('#form').addEventListener('submit', (e) => {
    e.preventDefault();
    const f = e.target;
    if (!f.nombre.value.trim() || !f.tel.value.trim()) return f.reportValidity();
    state.nombre = f.nombre.value.trim();
    state.tel = f.tel.value.trim();
    state.email = f.email.value.trim();
    renderResumen();
    goTo(4);
  });

  // Paso 4: resumen
  function renderResumen() {
    const m = state.modalidad;
    const cuando = m.esMembresia
      ? 'Membresía anual (coordinamos la primera consulta al sumarte)'
      : `${state.fechaLabel} · ${state.hora} h`;
    const filas = [`<div class="resumen__row"><span>Servicio</span><strong>${m.nombre}</strong></div>`];
    if (state.lugar)
      filas.push(`<div class="resumen__row"><span>Dónde</span><strong>${state.lugar}</strong></div>`);
    filas.push(`<div class="resumen__row"><span>Cuándo</span><strong>${cuando}</strong></div>`);
    filas.push(`<div class="resumen__row"><span>A nombre de</span><strong>${state.nombre}</strong></div>`);
    filas.push(`<div class="resumen__row resumen__row--total"><span>Total a pagar</span><strong>${m.precio}</strong></div>`);
    $('#resumen').innerHTML = filas.join('');

    // El Club (membresía anual) no tiene pago online: solo el camino de coordinar.
    const esMemb = !!m.esMembresia;
    const mpBtn = $('#confirmar'), mpHint = $('#hint-mp'), sep = $('#pay-sep');
    if (mpBtn) mpBtn.hidden = esMemb;
    if (mpHint) mpHint.hidden = esMemb;
    if (sep) sep.hidden = esMemb;
    const coordHint = $('#hint-coord');
    if (coordHint) coordHint.textContent = esMemb
      ? 'Registramos tu interés y Ceci coordina con vos. Le avisás por WhatsApp.'
      : 'Te guardamos el cupo 2 h y Ceci confirma tu turno. Le avisás por WhatsApp.';
  }

  function waMensajeCompartir() {
    const m = state.modalidad;
    const l = m.esMembresia
      ? ['Hola Ceci! Me gustaría sumarme al Club de las Estaciones:', `• ${m.nombre}`]
      : ['Hola Ceci! Me gustaría agendar este turno por la web:', `• ${m.nombre}`];
    if (state.lugar) l.push(`• Sede: ${state.lugar}`);
    if (!m.esMembresia) l.push(`• Día y hora: ${state.fechaLabel} · ${state.hora} h`);
    l.push(`• A nombre de: ${state.nombre}`);
    if (state.email) l.push(`• Email: ${state.email}`);
    l.push('Queda sujeto a tu confirmación. ¡Gracias!');
    return l.join('\n');
  }

  function waMensaje() {
    const m = state.modalidad;
    const l = ['Hola Ceci! Acabo de reservar por la web:', `• ${m.nombre}`];
    if (state.lugar) l.push(`• Sede: ${state.lugar}`);
    if (!m.esMembresia) l.push(`• Día y hora: ${state.fechaLabel} · ${state.hora} h`);
    l.push(`• A nombre de: ${state.nombre}`);
    if (state.email) l.push(`• Email: ${state.email}`);
    l.push('¿Coordinamos el pago para confirmarla?');
    return l.join('\n');
  }

  // Mensaje para cuando el pago YA se acreditó (al volver de MercadoPago).
  // Los datos vienen de sessionStorage porque el redirect de MP borra el estado.
  function waMensajePagado() {
    let info = {};
    try { info = JSON.parse(sessionStorage.getItem('reservaPago') || '{}'); } catch { /* modo privado */ }
    const l = ['Hola Ceci! PAGO CONFIRMADO ✅ vía MercadoPago:'];
    if (info.modalidad) l.push(`• ${info.modalidad}`);
    if (info.lugar) l.push(`• Sede: ${info.lugar}`);
    if (info.fechaLabel && !info.esMembresia) l.push(`• Día y hora: ${info.fechaLabel} · ${info.hora} h`);
    if (info.nombre) l.push(`• A nombre de: ${info.nombre}`);
    l.push('¡Nos vemos!');
    return l.join('\n');
  }

  // Registra la reserva y BLOQUEA el cupo. via='pagar' (MercadoPago) o
  // via='coordinar' (sin pago, queda a confirmar por Ceci). Devuelve los datos
  // de la reserva, o null si hubo un problema (ya deja el botón/alertas listos).
  async function enviarReserva(via, btn) {
    const orig = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Reservando…';
    const m = state.modalidad;
    try {
      const res = await fetch('/api/reservar', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          modalidad: m.id,
          sede: state.sedeSlug,
          fecha: m.esMembresia ? null : state.fecha,
          hora: m.esMembresia ? null : state.hora,
          nombre: state.nombre,
          telefono: state.tel,
          email: state.email,
          via,
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.status === 409) {
        btn.disabled = false; btn.textContent = orig;
        cargarDisponibilidad(state.sedeSlug);
        goTo(2);
        showAlert('Ese horario se ocupó recién. Elegí otro de los disponibles.');
        return null;
      }
      if (res.status === 429) {
        btn.disabled = false; btn.textContent = orig;
        showAlert(data.error || 'Hay muchas reservas sin confirmar ahora. Probá de nuevo en un rato.');
        return null;
      }
      if (!res.ok || !data.ok) throw new Error(data.error || 'error');
      return data;
    } catch (e) {
      btn.disabled = false; btn.textContent = orig;
      showAlert('No pudimos registrar la reserva. Probá de nuevo en un momento.');
      return null;
    }
  }

  // Camino PAGAR: al confirmar, vamos directo al checkout de MercadoPago.
  $('#confirmar').addEventListener('click', async () => {
    const m = state.modalidad;
    const data = await enviarReserva('pagar', $('#confirmar'));
    if (!data) return;
    // Guardamos el detalle para armar el mensaje "PAGO CONFIRMADO" al volver de MP.
    try {
      sessionStorage.setItem('reservaPago', JSON.stringify({
        rid: data.id, nombre: state.nombre, modalidad: m.nombre,
        lugar: state.lugar, fechaLabel: state.fechaLabel, hora: state.hora, esMembresia: !!m.esMembresia,
      }));
    } catch { /* sessionStorage puede fallar en modo privado */ }
    if (data.initPoint) { window.location.href = data.initPoint; return; }

    // Fallback (MercadoPago sin configurar): link de pago manual + WhatsApp.
    const waLink = $('#wa-link');
    if (waLink) { waLink.href = `https://wa.me/${whatsapp}?text=${encodeURIComponent(waMensaje())}`; waLink.hidden = false; }
    $('#done-text').textContent = m.esMembresia
      ? `${state.nombre}, registramos tu interés en ${m.nombre}.`
      : `${state.nombre}, tu ${m.nombre}${state.lugar ? ' en ' + state.lugar : ''} quedó reservada para el ${state.fechaLabel} a las ${state.hora} h.`;
    const hint = $('#done-hint');
    if (hint) hint.textContent = m.esMembresia
      ? 'Coordinamos la primera consulta al sumarte. Avisale a Ceci por WhatsApp con el botón de abajo.'
      : 'Tu cupo queda reservado. Coordiná el pago con Ceci por WhatsApp para confirmarlo.';
    const pagoLink = $('#pago-link');
    if (pago && pagoLink) { pagoLink.href = pago; pagoLink.hidden = false; }
    goTo(5);
  });

  // Camino COORDINAR: reserva sin pagar → queda a confirmar por Ceci (cupo 2 h).
  $('#coordinar').addEventListener('click', async () => {
    const m = state.modalidad;
    const data = await enviarReserva('coordinar', $('#coordinar'));
    if (!data) return;
    const waLink = $('#wa-link');
    if (waLink) {
      waLink.href = `https://wa.me/${whatsapp}?text=${encodeURIComponent(waMensajeCompartir())}`;
      waLink.textContent = 'Avisar a Ceci por WhatsApp';
      waLink.hidden = false;
    }
    $('#pago-link').hidden = true;
    $('#done-text').textContent = m.esMembresia
      ? `${state.nombre}, registramos tu interés en ${m.nombre}.`
      : `${state.nombre}, tu ${m.nombre}${state.lugar ? ' en ' + state.lugar : ''} quedó pre-reservada para el ${state.fechaLabel} a las ${state.hora} h.`;
    const hint = $('#done-hint');
    if (hint) hint.textContent = m.esMembresia
      ? 'Ceci coordina con vos a la brevedad. Avisale por WhatsApp con el botón de abajo.'
      : 'Te guardamos el cupo 2 horas. Ceci confirma tu turno a la brevedad; avisale por WhatsApp con el botón de abajo.';
    goTo(5);
  });

  // Volver
  $$('[data-back]').forEach((b) =>
    b.addEventListener('click', () => {
      const cur = Number(b.closest('.step').dataset.step);
      goTo(cur === 3 && state.modalidad?.esMembresia ? 1 : cur - 1);
    })
  );

  // Al volver de MercadoPago con "atrás", el bfcache restaura la página con el
  // botón deshabilitado en "Reservando…": lo reactivamos para poder reintentar.
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) {
      const btn = $('#confirmar');
      if (btn) {
        btn.disabled = false;
        btn.textContent = 'Proceder al pago';
      }
    }
  });

  // Regreso desde MercadoPago (back_urls): mostramos el estado del pago.
  const qsRetorno = new URLSearchParams(location.search);
  const pagoEstado = qsRetorno.get('pago');
  const reservaRid = qsRetorno.get('rid');
  if (pagoEstado) {
    const done = $('#done-text');
    const check = $('.done__check');
    const titulo = $('.done h2');
    const hint = $('#done-hint');
    if (hint) hint.hidden = true; // el aviso de WhatsApp no aplica cuando hay pago online
    if (pagoEstado === 'ok') {
      // El query param solo dice que MP redirigió: la confirmación real la hace
      // el webhook. Mostramos "confirmado" recién cuando la reserva lo está.
      if (titulo) titulo.textContent = 'Pago recibido';
      if (done) done.textContent = 'Estamos confirmando tu turno…';
      if (reservaRid) {
        (async () => {
          for (let i = 0; i < 5; i++) {
            try {
              const r = await fetch(`/api/reserva-estado?id=${encodeURIComponent(reservaRid)}`);
              const d = await r.json().catch(() => ({}));
              if (d.ok && d.estado === 'confirmada') {
                if (titulo) titulo.textContent = '¡Turno confirmado!';
                if (done) done.textContent = 'Recibimos tu pago y tu turno quedó confirmado. Te enviamos la confirmación por email. ¡Te esperamos!';
                const waLink = $('#wa-link');
                if (waLink) {
                  waLink.href = `https://wa.me/${whatsapp}?text=${encodeURIComponent(waMensajePagado())}`;
                  waLink.textContent = 'Avisar a Ceci: pago confirmado';
                  waLink.hidden = false;
                }
                return;
              }
            } catch { /* reintenta */ }
            await new Promise((r2) => setTimeout(r2, 2500));
          }
          if (titulo) titulo.textContent = 'Pago en acreditación';
          if (check) check.textContent = '⏳';
          if (done) done.textContent = 'Recibimos tu pago y lo estamos acreditando. En unos minutos te llega la confirmación por email. Si no llega, escribinos por WhatsApp.';
        })();
      } else {
        if (titulo) titulo.textContent = '¡Gracias!';
        if (done) done.textContent = 'Recibimos tu pago. En unos minutos te llega la confirmación por email.';
      }
    } else if (pagoEstado === 'pendiente') {
      if (titulo) titulo.textContent = 'Pago en proceso';
      if (check) check.textContent = '⏳';
      if (done) done.textContent = 'Tu pago está pendiente de acreditación. Cuando se confirme te llega el aviso por email y el turno queda reservado.';
    } else {
      if (titulo) titulo.textContent = 'No se completó el pago';
      if (check) { check.textContent = '!'; check.classList.add('done__check--error'); }
      if (done) done.textContent = 'El pago no se completó, así que el turno no quedó confirmado. Podés intentarlo de nuevo cuando quieras.';
    }
    history.replaceState(null, '', '/reservar'); // limpiamos los parámetros de la URL
    goTo(5);
  }

  // Preselección desde la home (?modalidad=presencial|virtual|skincare-inteligente).
  // Reusa el click del paso 1: muestra la sede/agenda o salta al paso del Club.
  if (!pagoEstado) {
    const pre = new URLSearchParams(location.search).get('modalidad');
    if (pre) {
      const btn = $$('.opt').find((b) => b.dataset.id === pre);
      if (btn) {
        btn.click();
        history.replaceState(null, '', '/reservar'); // limpiamos el query
      }
    }
  }
</script>

