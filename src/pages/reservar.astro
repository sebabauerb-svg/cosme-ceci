---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsappFloat from '../components/WhatsappFloat.astro';
import { modalidades } from '../data/modalidades';
import { site } from '../data/site';

// PROTOTIPO (sandbox): flujo de reserva visual. Sin backend ni pagos reales.
const items = modalidades.map((m) => ({
  id: m.id,
  nombre: m.nombre,
  subtitulo: m.subtitulo,
  precio: m.precio ?? 'A coordinar',
  precioNota: m.precioNota ?? '',
  esMembresia: m.id === 'club', // el Club es membresía anual, no turno suelto
}));
---

<Base title="Reservar (demo)" description="Flujo de reserva — versión de prueba." path="/reservar">
  <Nav />

  <main id="contenido" class="section booking">
    <div class="container booking__wrap">
      <header class="booking__head">
        <span class="eyebrow">Reservá tu turno</span>
        <h1>Coordinemos tu atención</h1>
        <p class="booking__lead">Elegí la modalidad y el horario que mejor te queden. Te toma un minuto.</p>
        <ol class="booking__steps" aria-hidden="true">
          <li data-ind="1" class="is-active">Modalidad</li>
          <li data-ind="2">Fecha y hora</li>
          <li data-ind="3">Tus datos</li>
          <li data-ind="4">Pago</li>
        </ol>
      </header>

      <!-- Paso 1: Modalidad (renderizado en el servidor → estilos aplican) -->
      <section class="step is-active" data-step="1" aria-label="Elegí la modalidad">
        <h2 class="step__title">¿Qué querés reservar?</h2>
        <div class="opts">
          {items.map((m) => (
            <button class="opt" data-id={m.id}>
              <span class="opt__head">
                <span class="opt__name">{m.nombre}</span>
                <span class="opt__price">{m.precio}</span>
              </span>
              <span class="opt__sub">{m.subtitulo}</span>
              {m.precioNota && <span class="opt__nota">{m.precioNota}</span>}
              <span class="opt__cta" aria-hidden="true">Elegir →</span>
            </button>
          ))}
        </div>
      </section>

      <!-- Paso 2: Fecha y hora -->
      <section class="step" data-step="2" hidden aria-label="Elegí fecha y hora">
        <h2 class="step__title">Elegí día y horario</h2>
        <p class="step__hint">Disponibilidad de ejemplo. En la versión final saldrá de la agenda real de Ceci.</p>

        <!-- Sede: solo para Consulta Presencial -->
        <div class="sede" id="sede" hidden>
          <p class="cal__label">¿Dónde preferís atenderte?</p>
          <div class="sede__opts">
            <button class="sede__btn" data-sede="Montevideo">Montevideo</button>
            <button class="sede__btn" data-sede="San José">San José</button>
          </div>
        </div>

        <div id="agenda" hidden>
          <p class="cal__label" id="dias-label">Días disponibles</p>
          <div class="cal__days" id="dias"></div>
          <p class="cal__label" id="slots-label" hidden>Horarios</p>
          <div class="cal__slots" id="horarios"></div>
        </div>

        <div class="step__nav">
          <button class="btn btn--ghost" data-back>← Volver</button>
        </div>
      </section>

      <!-- Paso 3: Datos -->
      <section class="step" data-step="3" hidden aria-label="Tus datos">
        <h2 class="step__title">Tus datos</h2>
        <form id="form" class="form" novalidate>
          <label>Nombre y apellido
            <input type="text" name="nombre" required autocomplete="name" placeholder="Tu nombre" />
          </label>
          <label>WhatsApp
            <input type="tel" name="tel" required autocomplete="tel" placeholder="09x xxx xxx" />
          </label>
          <label>Email (opcional)
            <input type="email" name="email" autocomplete="email" placeholder="tu@email.com" />
          </label>
          <p class="form__note">Tus datos se usan solo para coordinar tu atención.</p>
          <div class="step__nav">
            <button type="button" class="btn btn--ghost" data-back>← Volver</button>
            <button type="submit" class="btn btn--primary">Continuar al pago</button>
          </div>
        </form>
      </section>

      <!-- Paso 4: Resumen + pago -->
      <section class="step" data-step="4" hidden aria-label="Confirmar reserva">
        <h2 class="step__title">Confirmá tu reserva</h2>
        <div class="resumen" id="resumen"></div>
        <ul class="trust">
          <li>Confirmás tu turno con Ceci por WhatsApp</li>
          <li>Coordinás el pago de forma simple y segura</li>
          <li>¿Necesitás reprogramar? Lo vemos sin problema</li>
        </ul>
        <button class="btn btn--wa pay" id="confirmar">Confirmar por WhatsApp</button>
        <p class="step__hint center">Te abrimos WhatsApp con tu reserva lista para enviarle a Ceci.</p>
        <div class="step__nav center">
          <button class="btn btn--ghost" data-back>← Volver</button>
        </div>
      </section>

      <!-- Paso 5: Confirmación -->
      <section class="step step--done" data-step="5" hidden aria-label="Reserva confirmada">
        <div class="done">
          <span class="done__check" aria-hidden="true">✓</span>
          <h2>¡Casi listo!</h2>
          <p id="done-text"></p>
          <p class="step__hint">Para confirmar tu turno, aboná tu reserva y avisale a Ceci por WhatsApp (te abrimos el chat). El cupo queda reservado mientras tanto.</p>
          <a id="pago-link" class="btn btn--primary pay" target="_blank" rel="noopener" hidden>Pagar mi reserva</a>
          <a href="/reservar" class="btn btn--ghost">Hacer otra reserva</a>
        </div>
      </section>
    </div>
  </main>

  <Footer />
  <WhatsappFloat />
</Base>

<script define:vars={{ items, whatsapp: site.contacto.whatsapp, pago: site.enlaces.pagoMercadoPago }}>
  const state = { modalidad: null, sedeSlug: 'online', lugar: null, fecha: null, fechaLabel: null, hora: null, nombre: '', tel: '', email: '' };
  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => [...r.querySelectorAll(s)];

  function goTo(step) {
    $$('.step').forEach((el) => {
      const active = Number(el.dataset.step) === step;
      el.toggleAttribute('hidden', !active);
      el.classList.toggle('is-active', active);
    });
    $$('.booking__steps li').forEach((li) =>
      li.classList.toggle('is-active', Number(li.dataset.ind) <= step)
    );
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  const slugSede = (lugar) =>
    lugar === 'Montevideo' ? 'montevideo' : lugar === 'San José' ? 'san-jose' : 'online';

  // Paso 1: opciones
  $$('.opt').forEach((b) =>
    b.addEventListener('click', () => {
      const m = items.find((i) => i.id === b.dataset.id);
      state.modalidad = m;
      state.lugar = null;
      if (m.esMembresia) return goTo(3); // el Club no agenda turno
      const presencial = m.id === 'presencial';
      $('#sede').hidden = !presencial;
      $('#agenda').hidden = true;
      $$('.sede__btn').forEach((s) => s.classList.remove('is-sel'));
      goTo(2);
      if (!presencial) {
        // virtual / skincare = online: cargamos disponibilidad directo
        state.sedeSlug = 'online';
        $('#dias-label').textContent = 'Días disponibles';
        $('#agenda').hidden = false;
        cargarDisponibilidad('online');
      }
    })
  );

  // Sede (presencial): al elegir, cargamos la disponibilidad de esa sede
  $$('.sede__btn').forEach((s) =>
    s.addEventListener('click', () => {
      $$('.sede__btn').forEach((x) => x.classList.remove('is-sel'));
      s.classList.add('is-sel');
      state.lugar = s.dataset.sede;
      state.sedeSlug = slugSede(state.lugar);
      $('#agenda').hidden = false;
      $('#dias-label').textContent = `Días disponibles en ${state.lugar}`;
      cargarDisponibilidad(state.sedeSlug);
    })
  );

  // Paso 2: disponibilidad real desde la API (excluye turnos ya tomados)
  async function cargarDisponibilidad(sedeSlug) {
    const dias = $('#dias');
    dias.innerHTML = '<p class="cal__msg">Buscando fechas…</p>';
    $('#horarios').innerHTML = '';
    $('#slots-label').hidden = true;
    try {
      const res = await fetch(`/api/disponibilidad?sede=${encodeURIComponent(sedeSlug)}`);
      const data = await res.json();
      if (!data.ok) throw new Error(data.error || 'error');
      renderCalendario(data);
    } catch (e) {
      dias.innerHTML = '<p class="cal__msg">No pudimos cargar las fechas. Probá de nuevo.</p>';
    }
  }

  const MESES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
  const WD = ['L', 'M', 'X', 'J', 'V', 'S', 'D'];
  const pad2 = (n) => String(n).padStart(2, '0');

  function renderCalendario(data) {
    const slots = data.slots || [];
    const llenas = new Set(data.llenas || []);
    const cont = $('#dias');
    cont.innerHTML = '';
    $('#horarios').innerHTML = '';
    $('#slots-label').hidden = true;
    if (!slots.length && !llenas.size) {
      cont.innerHTML = `<p class="cal__msg">No hay fechas disponibles para esta opción por ahora. <a href="https://wa.me/${whatsapp}" target="_blank" rel="noopener" style="color:var(--sage-deep);font-weight:600">Escribinos por WhatsApp</a> y coordinamos.</p>`;
      return;
    }
    const byFecha = {};
    slots.forEach((s) => (byFecha[s.fecha] = s));
    const disp = new Set(slots.map((s) => s.fecha));

    const todas = [...disp, ...llenas].sort();
    const [hy, hm] = new Date().toISOString().slice(0, 10).split('-').map(Number);
    const [ly, lm] = todas[todas.length - 1].split('-').map(Number);
    const meses = [];
    let y = hy, m = hm;
    for (let i = 0; i < 6; i++) {
      meses.push({ y, m });
      if (y === ly && m === lm) break;
      m++; if (m > 12) { m = 1; y++; }
    }

    meses.forEach(({ y, m }) => {
      const wrap = document.createElement('div');
      wrap.className = 'cal2';
      const head = document.createElement('div');
      head.className = 'cal2__head';
      head.textContent = `${MESES[m - 1]} ${y}`;
      wrap.appendChild(head);
      const grid = document.createElement('div');
      grid.className = 'cal2__grid';
      WD.forEach((w) => {
        const e = document.createElement('div');
        e.className = 'cal2__wd';
        e.textContent = w;
        grid.appendChild(e);
      });
      const firstDow = new Date(Date.UTC(y, m - 1, 1)).getUTCDay();
      const offset = (firstDow + 6) % 7;
      for (let i = 0; i < offset; i++) {
        const e = document.createElement('div');
        e.className = 'cal2__cell cal2__cell--empty';
        grid.appendChild(e);
      }
      const ndays = new Date(Date.UTC(y, m, 0)).getUTCDate();
      for (let day = 1; day <= ndays; day++) {
        const iso = `${y}-${pad2(m)}-${pad2(day)}`;
        const on = disp.has(iso);
        const full = !on && llenas.has(iso);
        const cell = document.createElement(on ? 'button' : 'div');
        cell.className = 'cal2__cell ' + (on ? 'cal2__cell--on' : full ? 'cal2__cell--full' : 'cal2__cell--off');
        cell.textContent = String(day);
        if (on) {
          cell.addEventListener('click', () => {
            $$('.cal2__cell--sel').forEach((x) => x.classList.remove('cal2__cell--sel'));
            cell.classList.add('cal2__cell--sel');
            state.fecha = iso;
            state.fechaLabel = byFecha[iso].label;
            renderSlots(byFecha[iso].horas);
          });
        }
        grid.appendChild(cell);
      }
      wrap.appendChild(grid);
      cont.appendChild(wrap);
    });
    const leg = document.createElement('div');
    leg.className = 'cal2__leg';
    leg.innerHTML =
      '<span><i class="cal2__lg cal2__lg--on"></i> Disponible</span><span><i class="cal2__lg cal2__lg--full"></i> Lleno</span>';
    cont.appendChild(leg);
  }

  function renderSlots(horas) {
    const cont = $('#horarios');
    cont.innerHTML = '';
    $('#slots-label').hidden = false;
    const grupo = (titulo, hs) => {
      if (!hs.length) return;
      const g = document.createElement('div');
      g.className = 'slots-group';
      const t = document.createElement('p');
      t.className = 'slots-group__t';
      t.textContent = titulo;
      g.appendChild(t);
      const row = document.createElement('div');
      row.className = 'slots-row';
      hs.forEach((h) => {
        const b = document.createElement('button');
        b.className = 'cal__slot';
        b.textContent = h;
        b.addEventListener('click', () => {
          state.hora = h;
          goTo(3);
        });
        row.appendChild(b);
      });
      g.appendChild(row);
      cont.appendChild(g);
    };
    grupo('Mañana', horas.filter((h) => h < '13:00'));
    grupo('Tarde', horas.filter((h) => h >= '13:00'));
  }

  // Paso 3: datos
  $('#form').addEventListener('submit', (e) => {
    e.preventDefault();
    const f = e.target;
    if (!f.nombre.value.trim() || !f.tel.value.trim()) return f.reportValidity();
    state.nombre = f.nombre.value.trim();
    state.tel = f.tel.value.trim();
    state.email = f.email.value.trim();
    renderResumen();
    goTo(4);
  });

  // Paso 4: resumen
  function renderResumen() {
    const m = state.modalidad;
    const cuando = m.esMembresia
      ? 'Membresía anual (coordinamos la primera consulta al sumarte)'
      : `${state.fechaLabel} · ${state.hora} h`;
    const filas = [`<div class="resumen__row"><span>Servicio</span><strong>${m.nombre}</strong></div>`];
    if (state.lugar)
      filas.push(`<div class="resumen__row"><span>Dónde</span><strong>${state.lugar}</strong></div>`);
    filas.push(`<div class="resumen__row"><span>Cuándo</span><strong>${cuando}</strong></div>`);
    filas.push(`<div class="resumen__row"><span>A nombre de</span><strong>${state.nombre}</strong></div>`);
    filas.push(`<div class="resumen__row resumen__row--total"><span>Total a pagar</span><strong>${m.precio}</strong></div>`);
    $('#resumen').innerHTML = filas.join('');
  }

  function waMensaje() {
    const m = state.modalidad;
    const l = ['Hola Ceci! Acabo de reservar por la web:', `• ${m.nombre}`];
    if (state.lugar) l.push(`• Sede: ${state.lugar}`);
    if (!m.esMembresia) l.push(`• Día y hora: ${state.fechaLabel} · ${state.hora} h`);
    l.push(`• A nombre de: ${state.nombre}`);
    if (state.email) l.push(`• Email: ${state.email}`);
    l.push('¿Coordinamos el pago para confirmarla?');
    return l.join('\n');
  }

  // Confirmar: registra la reserva (BLOQUEA el cupo), abre WhatsApp y muestra el pago
  $('#confirmar').addEventListener('click', async () => {
    const btn = $('#confirmar');
    const orig = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Reservando…';
    const m = state.modalidad;
    try {
      const res = await fetch('/api/reservar', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          modalidad: m.id,
          sede: state.sedeSlug,
          fecha: m.esMembresia ? null : state.fecha,
          hora: m.esMembresia ? null : state.hora,
          nombre: state.nombre,
          telefono: state.tel,
          email: state.email,
          precio: m.precio,
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.status === 409) {
        btn.disabled = false;
        btn.textContent = orig;
        alert('Ese horario se ocupó recién. Te muestro los disponibles para elegir otro.');
        cargarDisponibilidad(state.sedeSlug);
        goTo(2);
        return;
      }
      if (!res.ok || !data.ok) throw new Error(data.error || 'error');

      // Reserva creada y cupo bloqueado: abrimos WhatsApp y mostramos el pago.
      window.open(`https://wa.me/${whatsapp}?text=${encodeURIComponent(waMensaje())}`, '_blank', 'noopener');
      $('#done-text').textContent = m.esMembresia
        ? `${state.nombre}, registramos tu interés en ${m.nombre}.`
        : `${state.nombre}, tu ${m.nombre}${state.lugar ? ' en ' + state.lugar : ''} quedó reservada para el ${state.fechaLabel} a las ${state.hora} h.`;
      const pagoLink = $('#pago-link');
      if (pago && pagoLink) {
        pagoLink.href = pago;
        pagoLink.hidden = false;
      }
      goTo(5);
    } catch (e) {
      btn.disabled = false;
      btn.textContent = orig;
      alert('No pudimos registrar la reserva. Probá de nuevo en un momento.');
    }
  });

  // Volver
  $$('[data-back]').forEach((b) =>
    b.addEventListener('click', () => {
      const cur = Number(b.closest('.step').dataset.step);
      goTo(cur === 3 && state.modalidad?.esMembresia ? 1 : cur - 1);
    })
  );
</script>

<style>
  .demo {
    background: var(--clay);
    color: var(--cream);
    text-align: center;
    font-size: 0.9rem;
    padding: 0.6rem 1rem;
  }
  .booking__wrap { max-width: 660px; margin-inline: auto; }
  .booking__head { text-align: center; margin-bottom: 2.5rem; }
  .booking__head h1 {
    margin: 0.3rem 0 0.6rem;
    font-size: clamp(1.6rem, 3.2vw, 2.1rem);
    text-wrap: balance;
  }
  .booking__lead {
    max-width: 44ch;
    margin: 0 auto 1.6rem;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }
  /* Reaseguro en el paso de pago */
  .trust { list-style: none; display: grid; gap: 0.55rem; max-width: 460px; margin: 0 auto 1.4rem; }
  .trust li { display: flex; gap: 0.55rem; align-items: flex-start; font-size: 0.88rem; color: var(--ink-soft); }
  .trust li::before { content: '✓'; color: var(--sage); font-weight: 700; flex: none; }
  .booking__steps {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.1rem;
    list-style: none; font-size: 0.82rem; color: var(--ink-soft); counter-reset: s;
  }
  .booking__steps li { counter-increment: s; display: flex; align-items: center; gap: 0.4rem; }
  .booking__steps li::before {
    content: counter(s); width: 22px; height: 22px; border-radius: 50%;
    background: var(--sand); color: var(--ink-soft); display: grid; place-items: center;
    font-weight: 600; font-size: 0.72rem;
  }
  .booking__steps li.is-active { color: var(--ink); }
  .booking__steps li.is-active::before { background: var(--sage); color: var(--cream); }

  .step { animation: fade 0.4s ease both; }
  .step__title { font-size: 1.45rem; margin-bottom: 0.4rem; text-align: center; }
  .step__hint { font-size: 0.9rem; color: var(--ink-soft); text-align: center; margin-bottom: 1.4rem; }
  .step__hint.center, .step__nav.center { justify-content: center; }
  .step__nav { display: flex; gap: 0.8rem; margin-top: 1.6rem; }
  @keyframes fade { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .step { animation: none; } }

  /* Opciones de modalidad (server-side → estilos scoped OK) */
  .opts { display: grid; gap: 0.85rem; margin-top: 1.8rem; }
  .opt {
    display: grid; gap: 0.25rem; text-align: left;
    background: var(--white); border: 1px solid var(--sand); border-radius: var(--radius);
    padding: 1.15rem 1.35rem; cursor: pointer;
    transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }
  .opt:hover { border-color: var(--sage); transform: translateY(-2px); box-shadow: var(--shadow); }
  .opt__head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .opt__name { font-family: var(--font-serif); font-size: 1.22rem; font-weight: 500; color: var(--ink); }
  .opt__price { font-family: var(--font-serif); font-size: 1.18rem; color: var(--ink); white-space: nowrap; flex: none; }
  .opt__sub { font-size: 0.92rem; color: var(--ink-soft); font-weight: 400; }
  .opt__nota { font-size: 0.8rem; color: var(--ink-soft); font-weight: 400; opacity: 0.85; }
  .opt__cta { justify-self: end; font-size: 0.85rem; font-weight: 600; color: var(--clay); margin-top: 0.35rem; }
  .opt:hover .opt__cta { text-decoration: underline; }

  .cal__label { font-weight: 600; font-size: 0.9rem; margin: 0 0 0.7rem; color: var(--ink); }
  #slots-label { margin-top: 1.5rem; }
  .cal__msg { color: var(--ink-soft); font-size: 0.92rem; margin: 0.3rem 0; }

  /* Selector de sede (solo presencial) */
  .sede { margin-bottom: 1.6rem; }
  .sede__opts { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .sede__btn {
    background: var(--white); border: 1px solid var(--sand); border-radius: 999px;
    padding: 0.7rem 1.4rem; cursor: pointer; font-weight: 600; color: var(--ink);
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .sede__btn:hover { border-color: var(--sage); }
  .sede__btn.is-sel { background: var(--sage); color: var(--cream); border-color: var(--sage); }

  /* Formulario */
  .form { display: grid; gap: 1rem; max-width: 460px; margin-inline: auto; }
  .form label { display: grid; gap: 0.35rem; font-size: 0.9rem; font-weight: 600; color: var(--ink); }
  .form input {
    font: inherit; font-weight: 400; padding: 0.7rem 0.9rem; border: 1px solid var(--sand);
    border-radius: var(--radius-sm); background: var(--white); color: var(--ink);
  }
  .form input:focus-visible { outline: 2px solid var(--sage); outline-offset: 1px; border-color: var(--sage); }
  .form__note { font-size: 0.82rem; color: var(--ink-soft); }

  .resumen {
    background: var(--white); border: 1px solid var(--sand); border-radius: var(--radius);
    padding: 1.4rem 1.6rem; margin-bottom: 1.4rem; max-width: 460px; margin-inline: auto;
  }
  .pay { width: 100%; max-width: 460px; margin-inline: auto; justify-content: center; }
  .pay:disabled { opacity: 0.7; cursor: default; }

  .done { text-align: center; padding: 2rem 0; }
  .done__check {
    width: 64px; height: 64px; border-radius: 50%; background: var(--sage); color: var(--cream);
    display: grid; place-items: center; font-size: 2rem; margin: 0 auto 1.2rem;
  }
  .done h2 small { color: var(--ink-soft); font-size: 0.9rem; }
  .done p { margin-bottom: 1rem; }
</style>

<!-- Estilos para elementos creados por JS (globales solo en esta página → sí aplican) -->
<style is:global>
  .cal__days { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .cal__day {
    background: var(--white); border: 1px solid var(--sand); border-radius: 999px;
    padding: 0.7rem 1.05rem; cursor: pointer; font-size: 0.88rem; text-transform: capitalize;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .cal__day:hover { border-color: var(--sage); }
  .cal__day.is-sel { background: var(--sage); color: var(--cream); border-color: var(--sage); }
  .cal__slots { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .cal__slot {
    background: var(--cream-deep); border: 1px solid var(--sand); border-radius: var(--radius-sm);
    padding: 0.6rem 1.1rem; cursor: pointer; font-weight: 600; color: var(--ink);
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .cal__slot:hover { background: var(--sage); color: var(--cream); border-color: var(--sage); }
  /* Calendario mensual */
  .cal2 { max-width: 340px; margin: 0 auto 1.6rem; }
  .cal2__head {
    font-family: var(--font-serif); font-size: 1.1rem; text-transform: capitalize;
    text-align: center; margin-bottom: 0.7rem; color: var(--ink);
  }
  .cal2__grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; }
  .cal2__wd { text-align: center; font-size: 0.72rem; font-weight: 600; color: var(--ink-soft); padding-bottom: 2px; }
  .cal2__cell {
    aspect-ratio: 1; display: grid; place-items: center; font-size: 0.88rem;
    border-radius: 9px; border: 1px solid transparent; font-family: inherit;
  }
  .cal2__cell--empty { border: 0; }
  .cal2__cell--off { color: color-mix(in srgb, var(--ink-soft) 38%, var(--cream)); }
  .cal2__cell--on {
    background: color-mix(in srgb, var(--sage) 20%, var(--cream));
    border-color: color-mix(in srgb, var(--sage) 45%, var(--cream));
    color: var(--sage-deep); cursor: pointer; font-weight: 600;
    transition: background 0.12s ease, color 0.12s ease, border-color 0.12s ease, transform 0.12s ease;
  }
  .cal2__cell--on:hover { background: color-mix(in srgb, var(--sage) 32%, var(--cream)); transform: translateY(-1px); }
  .cal2__cell--sel { background: var(--sage); color: var(--cream); border-color: var(--sage); }
  .cal2__cell--full {
    background: color-mix(in srgb, #c0392b 11%, var(--cream));
    border-color: color-mix(in srgb, #c0392b 26%, var(--cream));
    color: #a23226; text-decoration: line-through;
  }
  .cal2__leg { display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; font-size: 0.78rem; color: var(--ink-soft); margin-top: 0.6rem; justify-content: center; }
  .cal2__leg span { display: inline-flex; align-items: center; gap: 0.35rem; }
  .cal2__lg { width: 13px; height: 13px; border-radius: 4px; display: inline-block; }
  .cal2__lg--on { background: color-mix(in srgb, var(--sage) 20%, var(--cream)); border: 1px solid color-mix(in srgb, var(--sage) 45%, var(--cream)); }
  .cal2__lg--full { background: color-mix(in srgb, #c0392b 11%, var(--cream)); border: 1px solid color-mix(in srgb, #c0392b 26%, var(--cream)); }
  /* Horarios agrupados (Mañana / Tarde) */
  .slots-group { margin-bottom: 1rem; }
  .slots-group__t {
    font-size: 0.78rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--sage-deep); margin: 0 0 0.5rem;
  }
  .slots-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .resumen__row { display: flex; justify-content: space-between; gap: 1rem; padding: 0.55rem 0; }
  .resumen__row span { color: var(--ink-soft); }
  .resumen__row strong { color: var(--ink); text-align: right; }
  .resumen__row--total { border-top: 1px solid var(--sand); margin-top: 0.4rem; padding-top: 0.9rem; }
  .resumen__row--total strong { font-family: var(--font-serif); font-size: 1.3rem; }
</style>
