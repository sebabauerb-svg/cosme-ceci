---
import { modalidades } from '../data/modalidades';
---

<section class="section section--alt" id="modalidades">
  <div class="container">
    <div class="mod__head reveal">
      <h2>Cuatro formas de cuidar tu piel</h2>
      <p class="lead mx-auto text-center">
        El cuidado de la piel ocurre en dos planos: el abordaje clínico en camilla y la
        disciplina diaria en casa. Estas modalidades articulan ambos, según tu estilo de vida
        y tus objetivos.
      </p>
    </div>

    <div class="mod__grid" tabindex="0" aria-label="Modalidades de atención (deslizá para recorrerlas)">
      {modalidades.map((m) => {
        // El Club tiene su propia sección detallada más abajo: la tarjeta lleva ahí.
        // El resto lleva al flujo de reserva con la modalidad ya preseleccionada.
        const esClub = m.id === 'club';
        const href = esClub ? '#club' : `/reservar?modalidad=${m.id}`;
        return (
          <article class={`card mod__card reveal ${m.destacado ? 'mod__card--feat' : ''}`}>
            <header class="mod__top">
              <h3>{m.nombre}</h3>
              <p class="mod__sub">{m.subtitulo}</p>
            </header>

            <p class="mod__desc">{m.descripcion}</p>

            <p class="mod__alcance"><strong>Incluye:</strong> {m.alcance}</p>

            <div class="mod__foot">
              <div class="mod__precio">
                {m.precio && <span class="mod__monto">{m.precio}</span>}
                {m.precioNota && <span class="mod__nota">{m.precioNota}</span>}
              </div>
              <a href={href} class={`btn ${m.destacado ? 'btn--primary' : 'btn--ghost'}`}>
                {m.ctaTexto}
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <div class="mod__dots">
      {modalidades.map((m, i) => (
        <button type="button" class={`mod__dot ${i === 0 ? 'is-active' : ''}`} aria-label={`Ir a ${m.nombre}`}></button>
      ))}
    </div>
  </div>
</section>

<!-- Sincroniza los puntos del carrusel mobile; en desktop los puntos no se muestran. -->
<script is:inline>
  (() => {
    const scroller = document.querySelector('#modalidades .mod__grid');
    const dots = Array.from(document.querySelectorAll('#modalidades .mod__dot'));
    if (!scroller || !dots.length) return;
    const cards = Array.from(scroller.querySelectorAll('.mod__card'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const setActive = (i) => dots.forEach((d, j) => d.classList.toggle('is-active', i === j));
    let ticking = false;
    scroller.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          const mid = scroller.scrollLeft + scroller.clientWidth / 2;
          let best = 0;
          let bestDist = Infinity;
          cards.forEach((c, i) => {
            const dist = Math.abs(c.offsetLeft + c.offsetWidth / 2 - mid);
            if (dist < bestDist) { bestDist = dist; best = i; }
          });
          setActive(best);
        });
      },
      { passive: true }
    );
    // scrollTo explícito: scrollIntoView(smooth) se aborta en contenedores con snap mandatory.
    dots.forEach((d, i) =>
      d.addEventListener('click', () => {
        const card = cards[i];
        const left = card.offsetLeft - (scroller.clientWidth - card.offsetWidth) / 2;
        scroller.scrollTo({ left, behavior: reduce ? 'auto' : 'smooth' });
        setActive(i);
      })
    );
  })();
</script>

<style>
  .mod__head { text-align: center; max-width: 760px; margin-inline: auto; }
  .mod__head h2 { margin: 0.4rem 0 1rem; }
  .mod__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }
  .mod__card { display: flex; flex-direction: column; }
  .mod__card--feat { border-color: var(--sage); box-shadow: var(--shadow); }
  .mod__top { margin-bottom: 1rem; }
  .mod__sub {
    color: var(--sage-deep);
    font-weight: 600;
    font-size: 0.92rem;
    margin-top: 0.2rem;
  }
  .mod__desc { margin-bottom: 1rem; }
  .mod__alcance {
    font-size: 0.92rem;
    color: var(--ink-soft);
    background: var(--cream);
    border-radius: var(--radius-sm);
    padding: 0.9rem 1.1rem;
    margin-bottom: 1.4rem;
  }
  .mod__alcance strong { color: var(--ink); }
  .mod__foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .mod__precio { display: flex; flex-direction: column; }
  .mod__monto { font-family: var(--font-serif); font-size: 1.7rem; color: var(--ink); }
  .mod__nota { font-size: 0.82rem; color: var(--ink-soft); max-width: 22ch; }
  .mod__dots { display: none; }

  /* Mobile: carrusel horizontal con snap — una modalidad por vista, la siguiente asoma. */
  @media (max-width: 760px) {
    .mod__grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 86%;
      gap: 0.9rem;
      margin-top: 2rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(-1 * clamp(1.25rem, 5vw, 2.5rem));
      padding-inline: clamp(1.25rem, 5vw, 2.5rem);
      padding-bottom: 0.4rem;
      scrollbar-width: none;
    }
    .mod__grid::-webkit-scrollbar { display: none; }
    .mod__card { scroll-snap-align: center; padding: 1.25rem; }
    .mod__desc { font-size: 0.97rem; }
    .mod__alcance { font-size: 0.88rem; padding: 0.8rem 0.95rem; margin-bottom: 1.1rem; }
    .mod__monto { font-size: 1.5rem; }
    .mod__dots {
      display: flex;
      justify-content: center;
      gap: 0.35rem;
      margin-top: 0.9rem;
    }
    .mod__dot {
      width: 32px;
      height: 32px;
      display: grid;
      place-items: center;
      background: transparent;
      border: 0;
      padding: 0;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .mod__dot::after {
      content: '';
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--sand);
      transition: background 0.2s ease, transform 0.2s ease;
    }
    .mod__dot.is-active::after {
      background: var(--sage-deep);
      transform: scale(1.35);
    }
    @media (prefers-reduced-motion: reduce) {
      .mod__dot::after { transition: none; }
    }
  }
</style>
