---
import { site, whatsappLink } from '../data/site';
const anio = 2026; // CONFIRMAR: actualizar el año al publicar
const { contacto } = site;
---

<footer class="footer">
  <div class="container footer__top">
    <div class="footer__brand">
      <span class="footer__name">{site.marca.nombre}</span>
      <span class="footer__sub">{site.marca.subtitulo}</span>
      <p class="footer__tag">{site.tagline}</p>
    </div>

    <nav class="footer__nav" aria-label="Pie de página">
      <h4>Navegación</h4>
      <a href="/#filosofia">Filosofía</a>
      <a href="/#modalidades">Modalidades</a>
      <a href="/#tratamientos">Tratamientos</a>
      <a href="/#sobre-ceci">Sobre mí</a>
      <a href="/blog">Blog</a>
    </nav>

    <div class="footer__contacto">
      <h4>Contacto</h4>
      <a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp {contacto.whatsappDisplay}</a>
      {contacto.email && <a href={`mailto:${contacto.email}`}>{contacto.email}</a>}
      {contacto.instagramUrl && (
        <a href={contacto.instagramUrl} target="_blank" rel="noopener">Instagram @{contacto.instagram}</a>
      )}
      <span class="footer__zonas">Montevideo · San José, Uruguay</span>
    </div>
  </div>

  <div class="container footer__legal">
    <div class="footer__bottom">
      <span>© {anio} {site.marca.nombre} · {site.marca.subtitulo}. Todos los derechos reservados.</span>
      <a href="/aviso-legal">Aviso legal</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--sand);
    padding-block: clamp(3rem, 6vw, 4.5rem) 2rem;
  }
  .footer__top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(250, 246, 240, 0.12);
  }
  .footer__name {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--cream);
    display: block;
  }
  .footer__sub {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--clay);
    font-weight: 600;
    display: block;
    margin-bottom: 0.8rem;
  }
  .footer__tag { color: var(--sand); opacity: 0.85; max-width: 36ch; }
  .footer h4 {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--clay);
    margin-bottom: 1rem;
  }
  .footer__nav, .footer__contacto { display: flex; flex-direction: column; gap: 0.6rem; }
  .footer__nav a, .footer__contacto a { color: var(--sand); font-size: 0.95rem; }
  .footer__nav a:hover, .footer__contacto a:hover { color: var(--cream); }
  .footer__zonas { font-size: 0.88rem; opacity: 0.7; }
  .footer__legal { padding-top: 1.8rem; }
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.82rem;
    color: rgba(231, 220, 205, 0.78);
  }
  .footer__bottom a { color: var(--sand); text-decoration: underline; }
  @media (max-width: 760px) {
    .footer__top { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
