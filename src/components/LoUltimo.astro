---
// "Lo último": las 3 entradas más recientes del blog (novedades, tips y notas).
// Si todavía no hay ninguna publicada, la sección no se muestra.
import { getEntradas, fmtFecha, TIPOS } from '../lib/blog';

const entradas = (await getEntradas()).slice(0, 3);
---

{entradas.length > 0 && (
  <section class="section section--alt ultimo" id="novedades">
    <div class="container">
      <header class="ultimo__head reveal">
        <h2>Lo último</h2>
        <a class="ultimo__all" href="/blog">Ver todas las novedades →</a>
      </header>

      <ul class="ultimo__list stagger">
        {entradas.map((e) => (
          <li class="ultimo__item reveal">
            <p class="ultimo__meta">
              <span class={`ultimo__tipo ultimo__tipo--${e.data.tipo}`}>{TIPOS[e.data.tipo].label}</span>
              {!e.data.publicado && <span class="ultimo__draft">Borrador</span>}
              <time datetime={e.data.fecha.toISOString()}>{fmtFecha(e.data.fecha)}</time>
            </p>
            <h3><a href={`/blog/${e.id}`}>{e.data.titulo}</a></h3>
            <p class="ultimo__desc">{e.data.descripcion}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .ultimo__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
    margin-bottom: clamp(1.6rem, 4vw, 2.4rem);
  }
  .ultimo__all { color: var(--clay-deep); font-weight: 600; }
  .ultimo__all:hover { color: var(--sage-deep); }

  .ultimo__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }
  .ultimo__item {
    position: relative;
    background: var(--white);
    border: 1px solid var(--sand);
    border-radius: var(--radius);
    padding: clamp(1.4rem, 2.5vw, 1.8rem);
    transition: border-color 0.18s ease;
  }
  .ultimo__item:hover { border-color: var(--sage); }
  .ultimo__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.6rem;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }
  .ultimo__tipo,
  .ultimo__draft {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sage-deep);
  }
  .ultimo__tipo--tip { color: var(--clay-deep); }
  .ultimo__draft {
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--cream);
  }
  .ultimo__item h3 {
    font-size: clamp(1.15rem, 1.8vw, 1.3rem);
    line-height: 1.3;
    margin: 0.6rem 0 0.5rem;
    overflow-wrap: anywhere;
  }
  /* Toda la tarjeta es clickeable, pero el link accesible es el título. */
  .ultimo__item h3 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .ultimo__desc { font-size: 0.95rem; margin: 0; }

  @media (max-width: 900px) and (min-width: 761px) {
    .ultimo__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* Mobile: carrusel horizontal con la siguiente tarjeta asomando (igual que Testimonios). */
  @media (max-width: 760px) {
    .ultimo__list {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 82%;
      gap: 0.9rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(-1 * clamp(1.25rem, 5vw, 2.5rem));
      padding-inline: clamp(1.25rem, 5vw, 2.5rem);
      padding-bottom: 0.4rem;
      scrollbar-width: none;
    }
    .ultimo__list::-webkit-scrollbar { display: none; }
    .ultimo__item { scroll-snap-align: center; }
    /* Con una sola entrada no hay carrusel: ocupa todo el ancho. */
    .ultimo__list:has(> :only-child) { grid-auto-columns: 100%; }
  }
</style>
