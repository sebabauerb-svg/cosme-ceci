---
// ⚠️ PLACEHOLDER — testimonios de EJEMPLO, NO reales. Es OBLIGATORIO reemplazarlos por
// testimonios reales y con autorización de la persona ANTES de exponer el sitio a tráfico
// o publicidad (publicar testimonios ficticios como reales es publicidad engañosa).
// Foco permitido: experiencia, trato y personalización. Nunca curas ni resultados garantizados.
const testimonios = [
  {
    texto:
      'Esperaba que me vendiera productos y fue al revés: primero entendió mi piel y hasta me ' +
      'sacó pasos que no necesitaba. Se nota el criterio, no es un combo armado.',
    autora: 'Carolina M.',
    detalle: 'Montevideo',
  },
  {
    texto:
      'Por primera vez entiendo qué le pasa a mi piel y por qué. Me explicó cada activo y me ' +
      'ordenó una rutina que puedo sostener en el día a día.',
    autora: 'Valentina S.',
    detalle: 'San José',
  },
  {
    texto:
      'El trato es de otro nivel: te escucha, ajusta sobre la marcha y te acompaña entre ' +
      'consultas. En ningún momento te sentís una más.',
    autora: 'Lucía P.',
    detalle: 'Montevideo',
  },
];

const [destacado, ...resto] = testimonios;
---

<section class="section testi" id="testimonios">
  <div class="container">
    <header class="testi__head reveal">
      <h2>Atención cercana, resultados cuidados</h2>
    </header>

    <div class="testi__grid">
      <figure class="testi__feature reveal">
        <p class="testi__quote">{destacado.texto}</p>
        <figcaption class="testi__by">
          <strong>{destacado.autora}</strong>
          <span>{destacado.detalle}</span>
        </figcaption>
      </figure>

      <div class="testi__rest stagger">
        {resto.map((t) => (
          <figure class="testi__item reveal">
            <p>{t.texto}</p>
            <figcaption class="testi__by">
              <strong>{t.autora}</strong>
              <span>{t.detalle}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .testi__head {
    max-width: 640px;
    margin-bottom: clamp(2.4rem, 5vw, 3.4rem);
  }

  .testi__grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  /* Cita destacada: un solo bloque con presencia, no una card repetida */
  .testi__feature {
    position: relative;
    margin: 0;
    background: color-mix(in srgb, var(--clay) 7%, var(--cream));
    border-radius: var(--radius);
    padding: clamp(2.4rem, 4vw, 3.2rem) clamp(1.8rem, 4vw, 3rem) clamp(1.8rem, 4vw, 2.4rem);
  }
  .testi__feature::before {
    content: '\201C';
    position: absolute;
    top: clamp(0.2rem, 1vw, 0.8rem);
    left: clamp(1.1rem, 3vw, 1.9rem);
    font-family: var(--font-serif);
    font-size: clamp(4.5rem, 9vw, 7rem);
    line-height: 1;
    color: var(--clay);
    opacity: 0.28;
    pointer-events: none;
  }
  .testi__quote {
    position: relative;
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.6vw, 1.9rem);
    line-height: 1.35;
    color: var(--ink);
    text-wrap: pretty;
    margin: clamp(1.4rem, 3vw, 2rem) 0 1.4rem;
  }

  .testi__by {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .testi__by strong {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--ink);
  }
  .testi__by span {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  /* Dos citas de apoyo: sin caja, separadas por una hairline */
  .testi__rest {
    display: grid;
    gap: clamp(1.3rem, 3vw, 1.9rem);
    align-content: start;
  }
  .testi__item {
    margin: 0;
    padding-top: clamp(1.3rem, 3vw, 1.7rem);
    border-top: 1px solid var(--sand);
  }
  .testi__item:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .testi__item p {
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 1.6vw, 1.18rem);
    line-height: 1.45;
    color: var(--ink);
    text-wrap: pretty;
    margin-bottom: 0.85rem;
  }

  @media (max-width: 820px) {
    .testi__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
