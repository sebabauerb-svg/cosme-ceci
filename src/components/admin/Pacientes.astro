  .pc-select-sm { font: inherit; font-size: 0.85rem; padding: 0.3rem 0.5rem; border: 1px solid var(--sand); border-radius: var(--radius-sm); background: var(--white); color: var(--ink); margin-left: 0.3rem; }
  .pc-resumen { font-size: 0.85rem; color: var(--ink-soft); }
  .pc-eyebrow { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--clay-deep); font-weight: 600; }
  .pc-nombre { font-size: 1.45rem; margin: 0.1rem 0 0; overflow-wrap: anywhere; }
  .pc-sub { font-size: 1.1rem; margin: 0.6rem 0 0; }
  .pc-vacio { color: var(--ink-soft); font-size: 0.9rem; }
  .pc-pre { white-space: pre-line; overflow-wrap: anywhere; }

  /* Filtros y orden */
  .pc-filtros { display: flex; gap: 0.4rem; overflow-x: auto; padding-bottom: 2px; scrollbar-width: none; }
  .pc-filtros button { flex: none; font: inherit; font-size: 0.82rem; font-weight: 500; padding: 0.4rem 0.8rem; border: 1px solid var(--sand); border-radius: 999px; background: var(--white); color: var(--ink-soft); cursor: pointer; }
  .pc-filtros button[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--cream); }
  .pc-n { margin-left: 0.3rem; opacity: 0.7; font-variant-numeric: tabular-nums; }
