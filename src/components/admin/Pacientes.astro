  .pc-sesion__dl { margin: 0; display: grid; gap: 0.45rem; font-size: 0.9rem; }
  .pc-sesion__dl dt { font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); font-weight: 600; }
  .pc-sesion__dl dd { margin: 0; }
  .pc-linea { border-top: 1px solid var(--sand); padding-top: 0.9rem; }
  .pc-linea summary { cursor: pointer; font-weight: 600; font-size: 0.9rem; color: var(--sage-deep); }
