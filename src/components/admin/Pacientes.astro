---
/**
 * Pestaña "Pacientes" del panel: lista con buscador y filtros, y la ficha de
 * seguimiento de cada paciente (maqueta aprobada por Sebas y Ceci, oct-2026):
 *  - arriba, un resumen para leer en 5 segundos (alertas, motivo y objetivos,
 *    tratamiento en curso "sesión N de M", última y próxima visita, piel,
 *    consentimiento y recordatorio);
 *  - pestañas Anamnesis · Plan · Sesiones · Fotos · Datos;
 *  - "Registrar sesión": hoja pensada para cargar desde el celular.
 * Datos: /api/admin/pacientes (ficha, contacto, recordatorio) y
 * /api/admin/seguimiento (todo lo clínico; exige el consentimiento cargado).
 * Opciones de anamnesis y demás: src/data/ficha.ts.
 */
import { categoriasTratamientos } from '../../data/tratamientos';
import {
  ANTECEDENTES, CONDICIONES, ESTADOS_PLAN, ETIQUETAS_FOTO, FOTOTIPOS, HABITOS, OBJETIVOS, TIPOS_PIEL, TOLERANCIAS,
} from '../../data/ficha';
import { site } from '../../data/site';

const config = {
  catalogo: categoriasTratamientos.map((c) => ({
    grupo: `${c.grupo} · ${c.titulo}`,
    items: c.tratamientos.map((t) => ({ id: t.id, nombre: t.nombre })),
  })),
  antecedentes: ANTECEDENTES, condiciones: CONDICIONES, fototipos: FOTOTIPOS, habitos: HABITOS,
  objetivos: OBJETIVOS, tiposPiel: TIPOS_PIEL, tolerancias: TOLERANCIAS, etiquetasFoto: ETIQUETAS_FOTO,
  estadosPlan: ESTADOS_PLAN,
};
---

<section class="card pc" data-tab="pacientes">
  <!-- ============ LISTA ============ -->
  <div id="pc-lista-vista" class="pc-col">
    <div class="pc-fila-top">
      <div>
        <h2>Pacientes</h2>
        <p class="muted">Una ficha de seguimiento por paciente. Se crea sola con cada reserva.</p>
      </div>
      <button type="button" class="btn btn--primary btn--sm" id="pc-nueva">Nueva ficha</button>
    </div>
    <label>
      <span class="sr-only">Buscar paciente</span>
      <input type="search" id="pc-buscar" class="pc-input" placeholder="Buscar por nombre, teléfono o email" autocomplete="off" />
    </label>
    <div class="pc-filtros" role="group" aria-label="Filtrar pacientes" id="pc-filtros">
      <button type="button" aria-pressed="true" data-f="todas">Todas<span class="pc-n" data-n="todas"></span></button>
      <button type="button" aria-pressed="false" data-f="toca">Le toca volver<span class="pc-n" data-n="toca"></span></button>
      <button type="button" aria-pressed="false" data-f="activo">En tratamiento<span class="pc-n" data-n="activo"></span></button>
      <button type="button" aria-pressed="false" data-f="alertas">Con alertas<span class="pc-n" data-n="alertas"></span></button>
      <button type="button" aria-pressed="false" data-f="consent">Sin consentimiento<span class="pc-n" data-n="consent"></span></button>
    </div>
    <div class="pc-orden">
      <span class="pc-resumen" id="pc-resumen"></span>
      <label class="pc-resumen">Ordenar
        <select id="pc-ordenar" class="pc-select-sm">
          <option value="nombre">Nombre</option>
          <option value="proxima">Próxima visita</option>
          <option value="ultima">Última visita</option>
        </select>
      </label>
    </div>
    <div id="pc-lista"><p class="ag-vacia">Cargando…</p></div>
  </div>

  <!-- ============ FICHA ============ -->
  <div id="pc-ficha-vista" class="pc-col" hidden>
    <button type="button" class="pc-volver" id="pc-volver">← Todas las pacientes</button>
    <div id="pc-cabecera" class="pc-col"></div>

    <div class="pc-tabs" role="tablist" aria-label="Secciones de la ficha" id="pc-tabs">
      <button type="button" role="tab" aria-selected="false" data-t="anamnesis">Anamnesis</button>
      <button type="button" role="tab" aria-selected="false" data-t="plan">Plan</button>
      <button type="button" role="tab" aria-selected="false" data-t="sesiones">Sesiones</button>
      <button type="button" role="tab" aria-selected="false" data-t="fotos">Fotos</button>
      <button type="button" role="tab" aria-selected="true" data-t="datos">Datos</button>
    </div>

    <p class="pc-gate" id="pc-gate" hidden>Para cargar la anamnesis, el plan, las sesiones y las fotos, primero poné en <button type="button" class="pc-link" data-ir-tab="datos">Datos</button> la fecha en que firmó el consentimiento.</p>

    <div class="pc-panel" data-p="anamnesis" hidden><div id="pc-anamnesis" class="pc-col"></div></div>
    <div class="pc-panel" data-p="plan" hidden><div id="pc-plan" class="pc-col"></div></div>
    <div class="pc-panel" data-p="sesiones" hidden><div id="pc-sesiones" class="pc-col"></div></div>
    <div class="pc-panel" data-p="fotos" hidden><div id="pc-fotos" class="pc-col"></div></div>

    <div class="pc-panel" data-p="datos">
      <form id="pc-form" class="pc-col" novalidate>
        <div class="pc-dos">
          <label class="nv-campo">Nombre y apellido
            <input type="text" name="nombre" maxlength="120" required autocomplete="off" />
          </label>
          <label class="nv-campo">Fecha de nacimiento <span class="nv-ayuda">(opcional)</span>
            <input type="date" name="fecha_nacimiento" />
          </label>
          <label class="nv-campo">Teléfono
            <input type="tel" name="telefono" maxlength="40" inputmode="tel" autocomplete="off" />
          </label>
          <label class="nv-campo">Email
            <input type="email" name="email" maxlength="160" autocomplete="off" />
          </label>
          <label class="nv-campo">Consentimiento firmado <span class="nv-ayuda">(fecha)</span>
            <input type="date" name="consentimiento_fecha" />
          </label>
        </div>
        <label class="nv-campo">Notas de contacto <span class="nv-ayuda">(cómo prefiere que le escriban, qué días puede)</span>
          <textarea name="notas" rows="2" maxlength="1000"></textarea>
        </label>
        <label class="nv-check pc-check">
          <input type="checkbox" name="recordatorio_activo" checked />
          <span>Mandarle el recordatorio para volver a consultar</span>
        </label>
        <p class="pc-baja-aviso" id="pc-baja-aviso" hidden></p>
        <div class="nv-acciones">
          <button type="submit" class="btn btn--primary" id="pc-guardar">Guardar</button>
          <span id="pc-msg" class="guardar__msg" role="status"></span>
        </div>
      </form>
      <div class="pc-bloque" id="pc-vuelta-bloque" hidden>
        <h3>Recordatorio para volver</h3>
        <div id="pc-vuelta"></div>
      </div>
    </div>
  </div>

  <!-- ============ REGISTRAR SESIÓN ============ -->
  <div id="pc-sesion-vista" class="pc-col" hidden>
    <button type="button" class="pc-volver" id="pc-sesion-volver">← Volver a la ficha</button>
    <form id="pc-sesion" class="pc-hoja pc-col" novalidate>
      <div class="pc-fila-top"><h3 id="pc-sesion-tit">Registrar sesión</h3><span class="pc-resumen" id="pc-sesion-nombre"></span></div>
      <label class="nv-campo">Turno
        <select id="ps-turno"></select>
      </label>
      <label class="nv-campo" id="ps-fecha-campo" hidden>Fecha de la sesión
        <input type="date" id="ps-fecha" />
      </label>
      <label class="nv-campo">Tratamiento
        <select id="ps-trat"></select>
        <span class="nv-ayuda" id="ps-trat-ayuda"></span>
      </label>
      <label class="nv-campo" id="ps-otro-campo" hidden>¿Cuál?
        <input type="text" id="ps-otro" maxlength="80" />
      </label>
      <label class="nv-campo">Qué se hizo <span class="nv-ayuda">(activos o equipo, concentración, tiempo, parámetros)</span>
        <textarea id="ps-hizo" rows="3" maxlength="2000"></textarea>
      </label>
      <div class="nv-campo"><span>Tolerancia</span>
        <div class="pc-ops" id="ps-tol" data-uno></div>
      </div>
      <label class="nv-campo">Indicaciones para casa
        <textarea id="ps-casa" rows="2" maxlength="2000"></textarea>
      </label>
      <label class="nv-campo">Cómo encontraste la piel <span class="nv-ayuda">(evolución desde la sesión anterior)</span>
        <textarea id="ps-evo" rows="2" maxlength="4000"></textarea>
      </label>
      <label class="nv-campo pc-mitad">Próxima sesión sugerida
        <input type="date" id="ps-prox" />
      </label>
      <div class="pc-acciones">
        <button type="submit" class="btn btn--primary" id="ps-guardar">Guardar sesión</button>
        <button type="button" class="btn btn--ghost" id="ps-cancelar">Cancelar</button>
      </div>
      <span id="ps-msg" class="guardar__msg" role="status"></span>
    </form>
  </div>
</section>

<script type="application/json" id="pc-config" set:html={JSON.stringify(config)} />
<script type="application/json" id="pc-wa" set:html={JSON.stringify(site.contacto.whatsapp)} />

<script>
  (() => {
    const lista = document.getElementById('pc-lista');
    const form = document.getElementById('pc-form') as HTMLFormElement | null;
    if (!lista || !form) return;
    const cfg: any = JSON.parse(document.getElementById('pc-config')?.textContent || '{}');
    const $ = (id: string) => document.getElementById(id)!;
    const vistaLista = $('pc-lista-vista');
    const vistaFicha = $('pc-ficha-vista');
    const vistaSesion = $('pc-sesion-vista');
    const buscar = $('pc-buscar') as HTMLInputElement;
    const msg = $('pc-msg');
    const bajaAviso = $('pc-baja-aviso');

    type Estado = { tipo: string; fecha?: string | null; desde?: string; consulta?: string };
    let filas: any[] = [];
    let cargada = false;
    let filtro = 'todas';
    let fichaId: string | null = null;
    let ficha: any = null;      // /api/admin/pacientes?id=
    let seg: any = null;        // /api/admin/seguimiento?id=
    let tab = 'datos';
    let bajaDesde: string | null = null;
    let reactivar = false;
    let editandoSesion: any = null;

    const campo = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
    const fmt = (f?: string | null, anio = true) => f ? new Date(f.slice(0, 10) + 'T12:00:00Z').toLocaleDateString('es-UY', { day: 'numeric', month: 'short', ...(anio ? { year: 'numeric' } : {}), timeZone: 'UTC' }) : '—';
    const sinAcentos = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    const hoyUY = () => new Date(Date.now() - 3 * 3600 * 1000).toISOString().slice(0, 10);
    const edad = (nac?: string | null) => {
      if (!nac) return null;
      const h = hoyUY(); let e = Number(h.slice(0, 4)) - Number(nac.slice(0, 4));
      if (h.slice(5) < nac.slice(5)) e--;
      return e;
    };

    async function llamar(url: string, body?: unknown) {
      const res = await fetch(url, body
        ? { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }
        : undefined);
      if (res.status === 401) throw new Error('Tu sesión expiró. Recargá la página e ingresá de nuevo.');
      const d = await res.json().catch(() => ({}));
      if (!res.ok || !d.ok) throw Object.assign(new Error(d.error || 'No se pudo completar. Probá de nuevo.'), { id: d.id });
      return d;
    }
    const api = (body?: unknown, qs = '') => llamar('/api/admin/pacientes' + qs, body);
    const apiSeg = (body?: unknown, qs = '') => llamar('/api/admin/seguimiento' + qs, body);

    /** Botón con confirmación de dos toques (el navegador del panel bloquea confirm()). */
    function dosToques(btn: HTMLButtonElement, textoConfirmar: string, accion: () => Promise<void>) {
      const orig = btn.textContent;
      let armado = false;
      btn.addEventListener('click', async () => {
        if (!armado) {
          armado = true; btn.textContent = textoConfirmar;
          setTimeout(() => { if (armado && !btn.disabled) { armado = false; btn.textContent = orig; } }, 4000);
          return;
        }
        armado = false; btn.disabled = true;
        try { await accion(); } finally { btn.disabled = false; btn.textContent = orig; }
      });
    }

    // ---------- Recordatorio "volvé a consultar" ----------
    function chipVuelta(e: Estado): [string, string] | null {
      switch (e.tipo) {
        case 'listo': return ['Le toca volver', 'is-hoy'];
        case 'baja': return ['Pidió no recibir recordatorios', 'is-off'];
        default: return null;
      }
    }
    function explicar(e: Estado | null): string {
      if (!e) return '';
      switch (e.tipo) {
        case 'sin-consulta': return 'Todavía no tiene consultas realizadas. Un mes después de la primera le llega la invitación a volver.';
        case 'turno': return `No hace falta: ya tiene un turno${e.fecha ? ' el ' + fmt(e.fecha) : ''}.`;
        case 'programado': return `Se manda el ${fmt(e.desde)} (un mes después de la consulta del ${fmt(e.consulta)}), si para entonces no agendó otro turno.`;
        case 'listo': return `Le toca: pasó un mes desde la consulta del ${fmt(e.consulta)} y no tiene otro turno. Sale con el próximo envío automático, o podés mandarlo ahora.`;
        case 'enviado': return `Ya se le mandó el ${fmt(e.fecha)} por la consulta del ${fmt(e.consulta)}.`;
        case 'vencido': return `No se manda: su última consulta (${fmt(e.consulta)}) fue hace más de dos meses.`;
        case 'apagado': return 'Apagado para esta paciente.';
        case 'baja': return `Ella pidió no recibirlo (${fmt(e.desde)}).`;
        case 'sin-contacto': return 'No se puede mandar: la ficha no tiene email.';
        default: return '';
      }
    }
    const cortoVuelta = (e: Estado | null) => {
      if (!e) return '—';
      return ({
        'sin-consulta': 'Después de la primera consulta', turno: 'No hace falta: tiene turno', programado: `Sale el ${fmt(e.desde, false)}`,
        listo: 'Le toca ahora', enviado: `Enviado el ${fmt(e.fecha, false)}`, vencido: 'No corresponde', apagado: 'Apagado',
        baja: 'Pidió no recibirlo', 'sin-contacto': 'Falta el email',
      } as Record<string, string>)[e.tipo] ?? '—';
    };

    // ---------- LISTA ----------
    const pasaFiltro = (p: any, f: string) =>
      f === 'todas' || (f === 'toca' && p.estado.tipo === 'listo') || (f === 'activo' && !!p.plan)
      || (f === 'alertas' && p.alertas) || (f === 'consent' && !p.consentimiento);

    function pintarLista() {
      document.querySelectorAll<HTMLElement>('#pc-filtros [data-n]').forEach((n) => {
        n.textContent = String(filas.filter((p) => pasaFiltro(p, n.dataset.n!)).length);
      });
      const q = sinAcentos(buscar.value.trim());
      const qTel = q.replace(/\D/g, '');
      const orden = ($('pc-ordenar') as HTMLSelectElement).value;
      const vis = filas.filter((p) => pasaFiltro(p, filtro) && (!q
        || sinAcentos(p.nombre).includes(q)
        || (p.email ?? '').toLowerCase().includes(q)
        || (qTel.length >= 3 && (p.telefono ?? '').replace(/\D/g, '').includes(qTel))));
      const clave = (p: any) => orden === 'proxima' ? (p.proximo || '9999') : orden === 'ultima' ? (p.ultima || '0000') : '';
      vis.sort((a, b) => orden === 'nombre' ? a.nombre.localeCompare(b.nombre, 'es')
        : orden === 'proxima' ? clave(a).localeCompare(clave(b)) : clave(b).localeCompare(clave(a)));
      $('pc-resumen').textContent = `${vis.length} de ${filas.length}`;
      if (!filas.length) { lista!.innerHTML = '<p class="ag-vacia">Todavía no hay fichas. Se crean solas con cada reserva, o tocá "Nueva ficha".</p>'; return; }
      if (!vis.length) { lista!.innerHTML = '<p class="ag-vacia">Nadie coincide con esa búsqueda o filtro.</p>'; return; }
      lista!.innerHTML = vis.map((p) => {
        const chips: string[] = [];
        const c = chipVuelta(p.estado);
        if (c) chips.push(`<span class="pc-chip ${c[1]}">${esc(c[0])}</span>`);
        if (p.alertas) chips.push('<span class="pc-chip is-alerta">Alertas</span>');
        if (!p.consentimiento) chips.push('<span class="pc-chip is-warn">Sin consentimiento</span>');
        const ini = p.nombre.split(/\s+/).slice(0, 2).map((x: string) => x[0] || '').join('').toUpperCase();
        const plan = p.plan
          ? `<span class="pc-prog"><span class="pc-bar"><i style="width:${p.plan.de ? Math.min(100, Math.round(p.plan.hechas / p.plan.de * 100)) : 0}%"></i></span><span>${esc(p.plan.tratamiento)} · ${p.plan.hechas}${p.plan.de ? ' de ' + p.plan.de : ''}</span></span>`
          : `<span class="pc-item__sub">${p.ultima ? 'Última visita: ' + fmt(p.ultima) : 'Sin consultas todavía'}</span>`;
        return `<button type="button" class="pc-item" data-id="${esc(p.id)}">
          <span class="pc-avatar" aria-hidden="true">${esc(ini)}</span>
          <span class="pc-item__top"><strong>${esc(p.nombre)}</strong>${chips.join('')}</span>
          ${plan}
          <span class="pc-item__sub">${p.proximo ? 'Próximo turno: ' + fmt(p.proximo) : 'Sin turno agendado'}</span>
        </button>`;
      }).join('');
    }

    async function cargarLista() {
      lista!.innerHTML = '<p class="ag-vacia">Cargando…</p>';
      try {
        filas = (await api()).pacientes;
        cargada = true;
        pintarLista();
      } catch (err) {
        lista!.innerHTML = `<p class="ag-vacia">${esc((err as Error).message)} <button type="button" class="btn btn--ghost btn--sm" id="pc-reintentar">Reintentar</button></p>`;
        document.getElementById('pc-reintentar')?.addEventListener('click', cargarLista);
      }
    }

    // ---------- FICHA: cabecera y resumen ----------
    const MOD_LBL: Record<string, string> = {
      presencial: 'Presencial', virtual: 'Virtual', 'skincare-inteligente': 'Skincare Inteligente', club: 'Club de las Estaciones', manual: 'Cargado a mano',
    };
    const ESTADO_LBL: Record<string, string> = {
      confirmada: 'Confirmado', a_confirmar: 'A confirmar', pendiente_pago: 'Esperando pago', cancelada: 'Cancelado', expirada: 'Vencido',
    };
    const conConsent = () => !!ficha?.ficha?.consentimiento_fecha;
    const planActivo = () => (seg?.planes ?? []).find((p: any) => p.estado === 'en_curso') ?? null;

    function puntos(hechas: number, de: number | null) {
      if (!de) return `<span class="pc-resumen">${hechas} ${hechas === 1 ? 'sesión hecha' : 'sesiones hechas'}</span>`;
      return `<div class="pc-puntos" aria-label="${hechas} de ${de} sesiones">${Array.from({ length: de }, (_, i) => `<i class="${i < hechas ? 'ok' : ''}"></i>`).join('')}</div>`;
    }

    function pintarCabecera() {
      const f = ficha.ficha;
      const a = seg?.anamnesis ?? {};
      const e = edad(f.fecha_nacimiento);
      const alertas = [
        ...(a.antecedentes ?? []),
        a.alergias ? `Alergia: ${a.alergias}` : '',
        a.medicacion ? `Medicación: ${a.medicacion}` : '',
      ].filter(Boolean);
      const hist = ficha.historial as any[];
      const hoy = ficha.hoy;
      const ultima = hist.find((r) => r.estado === 'confirmada' && r.fecha && r.fecha <= hoy);
      const proxima = [...hist].reverse().find((r) => ['confirmada', 'a_confirmar', 'pendiente_pago'].includes(r.estado) && r.fecha && r.fecha > hoy);
      const sugerida = (seg?.sesiones ?? []).find((s: any) => s.proxima_fecha)?.proxima_fecha;
      const plan = planActivo();
      const ultSes = ultima && (seg?.sesiones ?? []).find((s: any) => s.id === ultima.id);
      const nSes = ultSes?.tratamientos?.[0]?.sesion;
      const desde = new Date(f.created_at).toLocaleDateString('es-UY', { month: 'long', year: 'numeric' });
      const wa = ficha.waTel;

      $('pc-cabecera').innerHTML = `
        <div class="pc-fila-top">
          <div>
            <span class="pc-eyebrow">Paciente desde ${esc(desde)}</span>
            <h3 class="pc-nombre">${esc(f.nombre)}</h3>
          </div>
          ${f.consentimiento_fecha ? `<span class="pc-chip is-ok">Consentimiento ✓ ${esc(fmt(f.consentimiento_fecha, false))}</span>` : '<span class="pc-chip is-warn">Sin consentimiento</span>'}
        </div>
        <div class="pc-contacto">
          ${e != null ? `<span><b>${e} años</b> · ${esc(fmt(f.fecha_nacimiento))}</span>` : ''}
          ${f.telefono ? `<span>${esc(f.telefono)}</span>` : ''}
          ${f.email ? `<span>${esc(f.email)}</span>` : ''}
        </div>
        ${alertas.length ? `<div class="pc-alertas" role="note"><strong>Tener en cuenta</strong><ul>${alertas.map((x) => `<li>${esc(x)}</li>`).join('')}</ul></div>` : ''}
        <div class="pc-resumen-grid">
          <div class="pc-dato pc-dato--ancho">
            <span class="pc-lbl">Motivo y objetivos</span>
            ${seg?.motivo || seg?.objetivos?.length
              ? `<span>${esc(seg.motivo ?? '')}</span>${seg.objetivos?.length ? `<span class="pc-ops pc-ops--ver">${seg.objetivos.map((o: string) => `<span class="pc-chip">${esc(o)}</span>`).join('')}</span>` : ''}`
              : '<span class="pc-vacio">Sin cargar (pestaña Plan)</span>'}
          </div>
          <div class="pc-dato pc-dato--ancho">
            <span class="pc-lbl">Tratamiento en curso</span>
            ${plan
              ? `<span>${esc(plan.tratamiento)}</span>${puntos(plan.hechas, plan.sesiones)}<span class="pc-resumen">Sesión ${plan.hechas}${plan.sesiones ? ' de ' + plan.sesiones : ''}${plan.frecuencia ? ' · ' + esc(plan.frecuencia) : ''}</span>`
              : '<span class="pc-vacio">Ninguno (pestaña Plan)</span>'}
          </div>
          <div class="pc-dato"><span class="pc-lbl">Última visita</span><span>${ultima ? esc(fmt(ultima.fecha, false)) + (nSes ? ` · sesión ${nSes}` : '') : '—'}</span></div>
          <div class="pc-dato"><span class="pc-lbl">Próxima</span><span>${proxima ? esc(fmt(proxima.fecha, false)) + (proxima.hora ? ' · ' + esc(proxima.hora) : '') : sugerida && sugerida > hoy ? 'Sugerida: ' + esc(fmt(sugerida, false)) : 'Sin turno'}</span></div>
