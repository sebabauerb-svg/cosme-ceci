      const turnos = seg.turnos as any[];
      cont.innerHTML = `
        <p class="nv-ayuda">Antes y después para comparar. Solo se ven con la sesión del panel abierta: nunca quedan en un link público.</p>
        <div class="pc-espacio"><span class="pc-bar pc-bar--ancha"><i style="width:${pct}%"></i></span><span class="pc-resumen">Fotos de todas las pacientes: ${seg.fotosMB} MB de ${seg.topeMB} MB</span></div>
        <div class="pc-subir pc-col">
          <label class="nv-campo">Foto<input type="file" id="ft-archivo" accept="image/*" /></label>
          <div class="pc-dos">
            <label class="nv-campo">Fecha<input type="date" id="ft-fecha" value="${hoyUY()}" /></label>
            <label class="nv-campo">Momento<select id="ft-etq"><option value="">—</option>${cfg.etiquetasFoto.map((e: string) => `<option>${esc(e)}</option>`).join('')}</select></label>
          </div>
          <label class="nv-campo">Sesión <span class="nv-ayuda">(opcional)</span><select id="ft-turno"><option value="">Ninguna</option>${turnos.map((t) => `<option value="${esc(t.id)}">${esc(fmt(t.fecha))}${t.hora ? ' · ' + esc(t.hora) : ''}</option>`).join('')}</select></label>
          <div class="nv-acciones"><button type="button" class="btn btn--primary btn--sm" id="ft-subir">Subir foto</button><span class="guardar__msg" id="ft-msg" role="status"></span></div>
        </div>
        ${fotos.length ? `<div class="pc-fotos">${fotos.map((f) => `
          <figure class="pc-foto">
            <a href="/api/admin/foto?id=${esc(f.id)}" target="_blank" rel="noopener"><img src="/api/admin/foto?id=${esc(f.id)}&t=mini" alt="Foto del ${esc(fmt(f.fecha))}" loading="lazy" /></a>
            <figcaption><span>${esc(fmt(f.fecha))}${f.etiqueta ? ' · ' + esc(f.etiqueta) : ''}</span><button type="button" class="pc-link pc-link--peligro" data-borrar-foto="${esc(f.id)}">Borrar</button></figcaption>
          </figure>`).join('')}</div>` : '<p class="ag-vacia">Todavía no hay fotos.</p>'}`;
      $('ft-subir').addEventListener('click', async () => {
        const out = $('ft-msg'); const file = ($('ft-archivo') as HTMLInputElement).files?.[0];
        if (!file) { out.className = 'guardar__msg guardar__msg--dirty'; out.textContent = 'Elegí una foto.'; return; }
        const btn = $('ft-subir') as HTMLButtonElement;
        btn.disabled = true; out.className = 'guardar__msg'; out.textContent = 'Preparando la foto…';
        try {
          const [datos, mini] = await Promise.all([achicar(file, 1280, 0.8), achicar(file, 360, 0.7)]);
          out.textContent = 'Subiendo…';
          await apiSeg({ accion: 'foto', id: fichaId, fecha: ($('ft-fecha') as HTMLInputElement).value,
            etiqueta: ($('ft-etq') as HTMLSelectElement).value || null, reserva_id: ($('ft-turno') as HTMLSelectElement).value || null, datos, mini });
          await recargarSeg();
        } catch (err) {
          btn.disabled = false; out.className = 'guardar__msg guardar__msg--dirty'; out.textContent = (err as Error).message;
        }
      });
      cont.querySelectorAll<HTMLButtonElement>('[data-borrar-foto]').forEach((b) =>
        dosToques(b, 'Tocá de nuevo para borrar', async () => {
          await apiSeg({ accion: 'foto-borrar', id: fichaId, foto_id: b.dataset.borrarFoto });
