  .pc-hist__f { font-weight: 600; }
  .pc-hist__d, .pc-hist__e { color: var(--ink-soft); }
  .pc-anterior { margin-top: 0.8rem; display: grid; gap: 0.4rem; }

  /* Hoja de sesión */
  .pc-hoja { border: 1px solid var(--clay); border-radius: var(--radius); padding: 1rem; }

  /* Fotos */
  .pc-espacio { display: grid; gap: 0.3rem; }
  .pc-subir { padding: 0.9rem; border-radius: var(--radius-sm); background: var(--cream); }
  .pc-fotos { display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: 0.7rem; }
  .pc-foto { margin: 0; display: grid; gap: 0.3rem; min-width: 0; }
  .pc-foto img { width: 100%; max-width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: var(--radius-sm); background: var(--cream-deep); display: block; }
  .pc-foto figcaption { display: flex; justify-content: space-between; gap: 0.4rem; font-size: 0.8rem; color: var(--ink-soft); flex-wrap: wrap; }

  @media (max-width: 640px) {
    .pc-dos, .pc-resumen-grid { grid-template-columns: minmax(0, 1fr); }
    .pc-resumen-grid .pc-dato:not(.pc-dato--ancho) { grid-column: auto; }
    .pc-mitad { max-width: none; }
    .pc-hist li { grid-template-columns: minmax(0, 1fr); gap: 0.1rem; }
  }
  @media (max-width: 640px) and (min-width: 360px) {
    .pc-resumen-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
