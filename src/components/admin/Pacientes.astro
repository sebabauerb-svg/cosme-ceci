    // ---------- Pestañas ----------
    function mostrarTab(t: string) {
      tab = t;
      document.querySelectorAll<HTMLElement>('#pc-tabs [role="tab"]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.t === t)));
      const clinica = t !== 'datos';
      $('pc-gate').hidden = !(clinica && !conConsent());
      document.querySelectorAll<HTMLElement>('.pc-panel').forEach((p) => {
        p.hidden = p.dataset.p !== t || (clinica && !conConsent());
      });
    }
    document.querySelectorAll<HTMLElement>('#pc-tabs [role="tab"]').forEach((b) => b.addEventListener('click', () => mostrarTab(b.dataset.t!)));
    $('pc-gate').addEventListener('click', (ev) => {
      const t = (ev.target as HTMLElement).closest<HTMLElement>('[data-ir-tab]')?.dataset.irTab;
      if (t) mostrarTab(t);
    });

    /** Grupo de opciones tipo chip (una o varias). */
    function ops(nombre: string, lista: readonly string[], sel: string[] | string | null, uno = false, alerta = false) {
      const marcados = Array.isArray(sel) ? sel : sel ? [sel] : [];
      return `<div class="pc-ops" data-ops="${nombre}" ${uno ? 'data-uno' : ''}>${lista.map((o) =>
        `<button type="button" class="pc-op ${alerta ? 'pc-op--alerta' : ''}" aria-pressed="${marcados.includes(o)}" data-v="${esc(o)}">${esc(o)}</button>`).join('')}</div>`;
    }
    const leerOps = (cont: HTMLElement, nombre: string) =>
      [...cont.querySelectorAll<HTMLElement>(`[data-ops="${nombre}"] [aria-pressed="true"]`)].map((b) => b.dataset.v!);
    document.addEventListener('click', (ev) => {
      const b = (ev.target as HTMLElement).closest<HTMLElement>('.pc-ops:not(.pc-ops--ver) > button');
      if (!b || !b.closest('.pc')) return;
      const g = b.parentElement!;
      if (g.hasAttribute('data-uno')) {
        const yaEstaba = b.getAttribute('aria-pressed') === 'true';
        g.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', 'false'));
        b.setAttribute('aria-pressed', String(!yaEstaba));
      } else b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
    });

    function guardarCon(btn: HTMLButtonElement, out: HTMLElement, fn: () => Promise<void>) {
      btn.addEventListener('click', async () => {
        btn.disabled = true; out.className = 'guardar__msg'; out.textContent = 'Guardando…';
        try {
          await fn();
          out.className = 'guardar__msg guardar__msg--ok'; out.textContent = 'Guardado.';
        } catch (err) {
          out.className = 'guardar__msg guardar__msg--dirty'; out.textContent = (err as Error).message;
        }
        btn.disabled = false;
      });
    }

