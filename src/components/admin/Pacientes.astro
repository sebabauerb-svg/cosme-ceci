          cargada = false;
        } catch (err) {
          cont.insertAdjacentHTML('beforeend', `<p class="guardar__msg guardar__msg--dirty">${esc((err as Error).message)}</p>`);
        }
      });
    }

    function mostrarBaja() {
      bajaAviso.hidden = !bajaDesde;
      campo('recordatorio_activo').disabled = !!bajaDesde && !reactivar;
      if (!bajaDesde) return;
      bajaAviso.innerHTML = reactivar
        ? 'Se va a reactivar al guardar. Hacelo solo si ella te pidió volver a recibirlo.'
        : `Ella pidió no recibir este recordatorio (${esc(fmt(bajaDesde))}). <button type="button" class="pc-link" id="pc-reactivar">Me pidió volver a recibirlo</button>`;
      document.getElementById('pc-reactivar')?.addEventListener('click', () => { reactivar = true; campo('recordatorio_activo').checked = true; mostrarBaja(); });
    }

    function llenarDatos() {
      const f = ficha?.ficha;
      form!.reset();
      campo('nombre').value = f?.nombre ?? '';
      campo('telefono').value = f?.telefono ?? '';
      campo('email').value = f?.email ?? '';
      campo('fecha_nacimiento').value = f?.fecha_nacimiento ?? '';
      campo('consentimiento_fecha').value = f?.consentimiento_fecha ?? '';
      (form!.elements.namedItem('notas') as HTMLTextAreaElement).value = f?.notas ?? '';
      campo('recordatorio_activo').checked = f ? f.recordatorio_activo && !f.baja_recordatorios_at : true;
      bajaDesde = f?.baja_recordatorios_at ?? null;
      mostrarBaja();
    }

    // ---------- Abrir ficha ----------
    async function recargarSeg() {
      seg = await apiSeg(undefined, '?id=' + encodeURIComponent(fichaId!));
      pintarCabecera(); pintarAnamnesis(); pintarPlan(); pintarSesiones(); pintarFotos();
    }

    function ver(v: 'lista' | 'ficha' | 'sesion') {
      vistaLista.hidden = v !== 'lista'; vistaFicha.hidden = v !== 'ficha'; vistaSesion.hidden = v !== 'sesion';
      (v === 'lista' ? vistaLista : v === 'ficha' ? vistaFicha : vistaSesion).scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    async function abrir(id: string | null, tabInicial?: string) {
      fichaId = id; ficha = null; seg = null; reactivar = false;
      msg.textContent = ''; msg.className = 'guardar__msg';
      ver('ficha');
      if (!id) {
        $('pc-cabecera').innerHTML = '<h3 class="pc-nombre">Nueva ficha</h3>';
        llenarDatos(); $('pc-vuelta-bloque').hidden = true;
        $('pc-tabs').hidden = true; mostrarTab('datos');
        campo('nombre').focus({ preventScroll: true });
        return;
      }
      $('pc-tabs').hidden = false;
      $('pc-cabecera').innerHTML = '<p class="ag-vacia">Cargando…</p>';
      try {
        const [d, s] = await Promise.all([api(undefined, '?id=' + encodeURIComponent(id)), apiSeg(undefined, '?id=' + encodeURIComponent(id))]);
        ficha = d; seg = s;
        ficha.waTel = (() => { const t = String(d.ficha.telefono ?? '').replace(/\D/g, ''); return t.length === 8 && t.startsWith('0') ? '598' + t.slice(1) : t.length === 9 && t.startsWith('09') ? '598' + t.slice(1) : t.startsWith('598') ? t : ''; })();
        llenarDatos(); pintarCabecera(); pintarVuelta(d.estado);
        pintarAnamnesis(); pintarPlan(); pintarSesiones(); pintarFotos();
        mostrarTab(tabInicial ?? (conConsent() ? (seg.sesiones.length ? 'sesiones' : 'anamnesis') : 'datos'));
      } catch (err) {
        $('pc-cabecera').innerHTML = `<p class="ag-vacia">${esc((err as Error).message)}</p>`;
      }
    }

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const btn = $('pc-guardar') as HTMLButtonElement;
      btn.disabled = true; msg.className = 'guardar__msg'; msg.textContent = 'Guardando…';
      try {
        const d = await api({
          accion: 'guardar', id: fichaId,
          nombre: campo('nombre').value, telefono: campo('telefono').value, email: campo('email').value,
          fecha_nacimiento: campo('fecha_nacimiento').value, consentimiento_fecha: campo('consentimiento_fecha').value,
          notas: (form.elements.namedItem('notas') as HTMLTextAreaElement).value,
          recordatorio_activo: campo('recordatorio_activo').checked, reactivar,
        });
        cargada = false;
        await abrir(d.id, 'datos');
        msg.className = 'guardar__msg guardar__msg--ok'; msg.textContent = 'Guardado.';
      } catch (err) {
        msg.className = 'guardar__msg guardar__msg--dirty';
        const e = err as Error & { id?: string };
        msg.innerHTML = esc(e.message) + (e.id ? ` <button type="button" class="pc-link" data-ir-ficha="${esc(e.id)}">Abrir esa ficha</button>` : '');
      }
      btn.disabled = false;
    });
    msg.addEventListener('click', (ev) => {
      const id = (ev.target as HTMLElement).closest<HTMLElement>('[data-ir-ficha]')?.dataset.irFicha;
      if (id) abrir(id);
    });

    // ---------- Hoja: registrar sesión ----------
    const sf = $('pc-sesion') as HTMLFormElement;
    const psTurno = $('ps-turno') as HTMLSelectElement;
    const psTrat = $('ps-trat') as HTMLSelectElement;

    function opcionesSesion(sel: string) {
      const planes = (seg.planes as any[]).filter((p) => p.estado !== 'terminado' || ('plan:' + p.id) === sel);
      return (planes.length ? `<optgroup label="Planes en curso">${planes.map((p) => {
        const n = editandoSesion?.plan_id === p.id ? editandoSesion.tratamientos?.[0]?.sesion : p.hechas + 1;
        return `<option value="plan:${esc(p.id)}"${('plan:' + p.id) === sel ? ' selected' : ''}>${esc(p.tratamiento)} · sesión ${n}${p.sesiones ? ' de ' + p.sesiones : ''}</option>`;
      }).join('')}</optgroup>` : '') + opcionesTrat(sel.startsWith('plan:') ? '' : sel).replace('Elegí el tratamiento…', 'Sin tratamiento del catálogo');
    }

    function abrirSesion(s: any | null) {
      editandoSesion = s;
      $('pc-sesion-tit').textContent = s ? 'Editar sesión' : 'Registrar sesión';
      $('pc-sesion-nombre').textContent = ficha.ficha.nombre;
      $('ps-msg').textContent = '';
      const turnos = seg.turnos as any[];
      const libres = turnos.filter((t) => !t.registrada || t.id === s?.id);
      psTurno.innerHTML = libres.map((t) => `<option value="${esc(t.id)}">${esc(fmt(t.fecha))}${t.hora ? ' · ' + esc(t.hora) : ''} · ${esc(MOD_LBL[t.modalidad] ?? t.modalidad)}</option>`).join('')
        + (s ? '' : '<option value="">Sin turno en la agenda: cargar con fecha</option>');
      psTurno.value = s ? s.id : (libres.find((t) => t.fecha === seg.hoy)?.id ?? (libres[0]?.fecha === seg.hoy ? libres[0].id : ''));
      ($('ps-fecha') as HTMLInputElement).value = seg.hoy;
      $('ps-fecha-campo').hidden = psTurno.value !== '';
      const t0 = s?.tratamientos?.[0];
      const plan = planActivo();
      const sel = s ? (s.plan_id ? 'plan:' + s.plan_id : t0 ? t0.id : '') : plan ? 'plan:' + plan.id : '';
      psTrat.innerHTML = opcionesSesion(sel);
      psTrat.value = sel;
      ($('ps-otro') as HTMLInputElement).value = t0 && t0.id === 'otro' && !s?.plan_id ? t0.nombre : '';
      $('ps-otro-campo').hidden = psTrat.value !== 'otro';
      $('ps-trat-ayuda').textContent = psTrat.value.startsWith('plan:') ? 'Viene del plan: suma la sesión sola.' : '';
      ($('ps-hizo') as HTMLTextAreaElement).value = s?.hizo ?? '';
      ($('ps-casa') as HTMLTextAreaElement).value = s?.indicaciones ?? '';
      ($('ps-evo') as HTMLTextAreaElement).value = s?.evolucion ?? '';
      ($('ps-prox') as HTMLInputElement).value = s?.proxima_fecha ?? '';
      $('ps-tol').innerHTML = (cfg.tolerancias as string[]).map((o) => `<button type="button" class="pc-op" aria-pressed="${s?.tolerancia === o}" data-v="${esc(o)}">${esc(o)}</button>`).join('');
      ver('sesion');
    }
    psTurno.addEventListener('change', () => { $('ps-fecha-campo').hidden = psTurno.value !== ''; });
    psTrat.addEventListener('change', () => {
      $('ps-otro-campo').hidden = psTrat.value !== 'otro';
      $('ps-trat-ayuda').textContent = psTrat.value.startsWith('plan:') ? 'Viene del plan: suma la sesión sola.' : '';
    });
    const cerrarSesion = () => { editandoSesion = null; ver('ficha'); };
    $('ps-cancelar').addEventListener('click', cerrarSesion);
    $('pc-sesion-volver').addEventListener('click', cerrarSesion);
    sf.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const btn = $('ps-guardar') as HTMLButtonElement; const out = $('ps-msg');
      btn.disabled = true; out.className = 'guardar__msg'; out.textContent = 'Guardando…';
      const tv = psTrat.value;
      try {
        await apiSeg({
          accion: 'sesion', id: fichaId,
          reserva_id: psTurno.value || null, fecha: ($('ps-fecha') as HTMLInputElement).value,
          plan_id: tv.startsWith('plan:') ? tv.slice(5) : null,
          tratamiento_id: tv.startsWith('plan:') ? '' : tv, tratamiento: ($('ps-otro') as HTMLInputElement).value,
          hizo: ($('ps-hizo') as HTMLTextAreaElement).value, tolerancia: $('ps-tol').querySelector<HTMLElement>('[aria-pressed="true"]')?.dataset.v ?? null,
          indicaciones: ($('ps-casa') as HTMLTextAreaElement).value, evolucion: ($('ps-evo') as HTMLTextAreaElement).value,
          proxima_fecha: ($('ps-prox') as HTMLInputElement).value,
        });
        cargada = false;
        editandoSesion = null;
        await abrir(fichaId!, 'sesiones');
      } catch (err) {
        out.className = 'guardar__msg guardar__msg--dirty'; out.textContent = (err as Error).message;
      }
      btn.disabled = false;
    });

    // ---------- Lista: eventos ----------
    lista.addEventListener('click', (ev) => {
      const id = (ev.target as HTMLElement).closest<HTMLElement>('.pc-item')?.dataset.id;
      if (id) abrir(id);
    });
    buscar.addEventListener('input', pintarLista);
    $('pc-ordenar').addEventListener('change', pintarLista);
    document.querySelectorAll<HTMLElement>('#pc-filtros [data-f]').forEach((b) => b.addEventListener('click', () => {
      filtro = b.dataset.f!;
      document.querySelectorAll('#pc-filtros [data-f]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      pintarLista();
    }));
    $('pc-nueva').addEventListener('click', () => abrir(null));
    $('pc-volver').addEventListener('click', () => { ver('lista'); if (!cargada) cargarLista(); });

    // Carga perezosa: recién cuando Ceci abre la pestaña.
    const tabPanel = document.querySelector<HTMLButtonElement>('.tab[data-ir="pacientes"]');
    tabPanel?.addEventListener('click', () => { if (!cargada && !vistaLista.hidden) cargarLista(); });
    if (tabPanel?.getAttribute('aria-current') === 'true') cargarLista();
  })();
</script>

<style is:global>
  /* Tonos de estado de la ficha (bien / atención / alerta): fuera de la paleta de
     marca a propósito, para que una alerta no se confunda con el acento. */
  .pc {
    display: grid;
    --pc-ok-bg: #e6ebe2; --pc-warn-bg: #fbefd9; --pc-warn: #8a5210; --pc-alerta-bg: #f7e1dc; --pc-alerta: #a23b2f;
  }
  .pc-col { display: grid; gap: 1rem; min-width: 0; }
  .pc-fila-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.8rem; flex-wrap: wrap; }
  .pc-fila-top > * { min-width: 0; }
