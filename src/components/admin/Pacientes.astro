  /* Lista */
  .pc-item { display: grid; grid-template-columns: 2.6rem minmax(0, 1fr); gap: 0.2rem 0.8rem; width: 100%; text-align: left; font: inherit; color: var(--ink); padding: 0.85rem 0.2rem; background: none; border: 0; border-top: 1px solid var(--sand); cursor: pointer; }
  .pc-item:hover { background: var(--cream); }
  .pc-item:focus-visible { outline: 2px solid var(--sage); outline-offset: -2px; }
  .pc-avatar { grid-row: span 3; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: var(--cream-deep); color: var(--clay-deep); display: grid; place-items: center; font-family: var(--font-serif); }
  .pc-item__top { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem 0.5rem; }
  .pc-item__sub { font-size: 0.85rem; color: var(--ink-soft); overflow-wrap: anywhere; }
  .pc-prog { display: flex; align-items: center; gap: 0.5rem; font-size: 0.84rem; color: var(--ink-soft); min-width: 0; }
  .pc-prog > span:last-child { overflow-wrap: anywhere; }
  .pc-bar { flex: none; width: 5rem; height: 5px; border-radius: 3px; background: var(--cream-deep); overflow: hidden; }
  .pc-bar i { display: block; height: 100%; background: var(--sage); }
  .pc-bar--ancha { width: 100%; height: 7px; }

  /* Chips */
  .pc-chip { display: inline-flex; align-items: center; font-size: 0.72rem; font-weight: 600; padding: 0.15rem 0.55rem; border-radius: 999px; background: var(--cream-deep); color: var(--ink-soft); white-space: nowrap; }
  .pc-chip.is-hoy { background: var(--sage); color: var(--white); }
  .pc-chip.is-ok { background: var(--pc-ok-bg); color: var(--sage-deep); }
  .pc-chip.is-warn { background: var(--pc-warn-bg); color: var(--pc-warn); }
  .pc-chip.is-alerta, .pc-chip.is-off { background: var(--pc-alerta-bg); color: var(--pc-alerta); }

  /* Ficha */
  .pc-volver { justify-self: start; font: inherit; font-size: 0.9rem; font-weight: 600; color: var(--sage-deep); background: none; border: 0; padding: 0.3rem 0; cursor: pointer; }
  .pc-contacto { display: flex; flex-wrap: wrap; gap: 0.2rem 1rem; font-size: 0.9rem; color: var(--ink-soft); }
  .pc-contacto b { font-weight: 600; color: var(--ink); }
  .pc-contacto span { overflow-wrap: anywhere; }
  .pc-alertas { display: grid; gap: 0.3rem; padding: 0.8rem 1rem; border-radius: var(--radius-sm); background: var(--pc-alerta-bg); color: var(--pc-alerta); }
