  .pc-acciones-linea { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; }
  .pc-acciones-linea input { font: inherit; padding: 0.45rem 0.7rem; border: 1px solid var(--sand); border-radius: var(--radius-sm); background: var(--white); color: var(--ink); }

  .pc-tabs { display: flex; gap: 0.1rem; overflow-x: auto; border-bottom: 1px solid var(--sand); scrollbar-width: none; }
  .pc-tabs button { flex: none; font: inherit; font-size: 0.9rem; font-weight: 600; padding: 0.6rem 0.75rem; border: 0; background: none; color: var(--ink-soft); border-bottom: 2px solid transparent; margin-bottom: -1px; cursor: pointer; }
  .pc-tabs button[aria-selected='true'] { color: var(--ink); border-bottom-color: var(--clay); }
  .pc-gate { margin: 0; padding: 0.8rem 1rem; border-radius: var(--radius-sm); background: var(--pc-warn-bg); color: var(--ink); font-size: 0.9rem; line-height: 1.6; }
  .pc-panel { min-width: 0; }

  .pc-dos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem 1rem; }
  .pc-mitad { max-width: 16rem; }
  .pc .nv-campo input, .pc .nv-campo select, .pc .nv-campo textarea { width: 100%; min-width: 0; }
  .pc-check { flex-wrap: nowrap; align-items: flex-start; }
  .pc-check input { flex: none; margin-top: 0.2rem; }
  .pc-baja-aviso { font-size: 0.88rem; color: var(--clay-deep); margin: -0.4rem 0 0; line-height: 1.6; }
  .pc-link { font: inherit; font-size: 0.88rem; color: var(--sage-deep); font-weight: 600; text-decoration: underline; background: none; border: 0; padding: 0; cursor: pointer; justify-self: start; }
  .pc-link--peligro { color: var(--pc-alerta); }
  .pc-bloque { margin-top: 1.6rem; padding-top: 1.2rem; border-top: 1px solid var(--sand); display: grid; gap: 0.5rem; }
  .pc-bloque h3 { font-size: 1.05rem; margin: 0; }
  .pc-vuelta__txt { margin: 0; line-height: 1.6; }

  /* Opciones tipo chip */
  .pc-ops { display: flex; flex-wrap: wrap; gap: 0.4rem; font-weight: 400; }
  .pc-op { font: inherit; font-size: 0.84rem; padding: 0.4rem 0.75rem; border: 1px solid var(--sand); border-radius: 999px; background: var(--white); color: var(--ink-soft); cursor: pointer; }
  .pc-op[aria-pressed='true'] { background: var(--pc-ok-bg); border-color: var(--sage); color: var(--sage-deep); font-weight: 600; }
  .pc-op--alerta[aria-pressed='true'] { background: var(--pc-alerta-bg); border-color: var(--pc-alerta); color: var(--pc-alerta); }

  /* Plan y sesiones */
  .pc-plan { border: 1px solid var(--sand); border-radius: var(--radius-sm); padding: 0.9rem; gap: 0.7rem; }
  .pc-plan__tit { font-family: var(--font-serif); font-weight: 500; font-size: 1.05rem; overflow-wrap: anywhere; }
  .pc-kv { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 0.25rem 0.9rem; font-size: 0.88rem; margin: 0; }
  .pc-kv dt { color: var(--ink-soft); }
