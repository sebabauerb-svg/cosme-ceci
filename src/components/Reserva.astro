---
import { site, whatsappLink } from '../data/site';
const { enlaces, contacto } = site;
---

<section class="section reserva" id="reservar">
  <div class="container">
    <div class="reserva__box reveal">
      <div class="reserva__copy">
        <h2>Diseñemos un protocolo a la medida de tu piel</h2>
        <p class="lead">
          Para conocer los planes de tratamiento y diseñar un protocolo según las necesidades
          reales de tu piel, coordinemos una sesión de valoración profesional, presencial u
          online.
        </p>

        <div class="reserva__cta">
          <a href="/reservar" class="btn btn--primary">
            Reservar online
          </a>
          <a href={whatsappLink()} class="btn btn--wa" target="_blank" rel="noopener">
            O escribime por WhatsApp
          </a>
        </div>
        <p class="reserva__fine">Atención en Montevideo y San José · Consulta virtual sin límites geográficos.</p>
      </div>

      <ul class="reserva__data">
        <li>
          <span class="reserva__ico reserva__ico--wa" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="currentColor"><path d="M16 3C9.4 3 4 8.4 4 15c0 2.1.6 4.2 1.6 6L4 29l8.2-2.1c1.7.9 3.7 1.4 5.8 1.4 6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.8c-1.8 0-3.6-.5-5.1-1.4l-.4-.2-4.9 1.3 1.3-4.7-.2-.4C5.5 18.3 5 16.7 5 15 5 9.5 9.9 5 16 5s11 4.5 11 10-4.9 9.8-11 9.8zm6.1-7.3c-.3-.2-1.9-1-2.2-1.1-.3-.1-.5-.2-.8.2-.2.3-.9 1.1-1.1 1.3-.2.2-.4.2-.7.1-1.8-.9-3-1.6-4.2-3.6-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.6s-.8-1.9-1.1-2.6c-.3-.7-.6-.6-.8-.6h-.7c-.2 0-.6.1-.9.4-.3.3-1.2 1.2-1.2 2.9s1.2 3.3 1.4 3.6c.2.3 2.4 3.7 5.9 5.1 2.2.9 3 1 4.1.8.7-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.3-.6-.5z"/></svg>
          </span>
          <span class="reserva__by">
            <span class="reserva__label">WhatsApp</span>
            <a href={whatsappLink()} target="_blank" rel="noopener">{contacto.whatsappDisplay}</a>
          </span>
        </li>
        {contacto.instagramUrl && (
          <li>
            <span class="reserva__ico reserva__ico--ig" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
            </span>
            <span class="reserva__by">
              <span class="reserva__label">Instagram</span>
              <a href={contacto.instagramUrl} target="_blank" rel="noopener">@{contacto.instagram}</a>
            </span>
          </li>
        )}
        {contacto.email && (
          <li>
            <span class="reserva__ico reserva__ico--mail" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="M3 6l9 7 9-7"/></svg>
            </span>
            <span class="reserva__by">
              <span class="reserva__label">Email</span>
              <a href={`mailto:${contacto.email}`}>{contacto.email}</a>
            </span>
          </li>
        )}
      </ul>
    </div>
  </div>
</section>

<style>
  .reserva__box {
    background: linear-gradient(150deg, var(--cream-deep), var(--sand));
    border-radius: var(--radius);
    padding: clamp(2rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 2.5rem;
    align-items: center;
    box-shadow: var(--shadow);
  }
  .reserva__copy h2 { margin: 0.4rem 0 1rem; }
  .reserva__cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.8rem; }
  .reserva__fine { font-size: 0.86rem; margin-top: 1.2rem; color: var(--ink-soft); }
  .reserva__data {
    list-style: none;
    display: grid;
    gap: 1.1rem;
    background: var(--white);
    border-radius: var(--radius-sm);
    padding: 1.6rem;
    border: 1px solid var(--sand);
  }
  .reserva__data li { display: flex; align-items: center; gap: 0.9rem; }
  .reserva__ico {
    flex: none;
    width: 42px; height: 42px;
    border-radius: 12px;
    display: grid; place-items: center;
    color: var(--cream);
  }
  .reserva__ico svg { width: 22px; height: 22px; }
  .reserva__ico--wa { background: #25d366; }
  .reserva__ico--ig { background: linear-gradient(135deg, #f9ce34, #ee2a7b 55%, #6228d7); }
  .reserva__ico--mail { background: var(--sage); }
  .reserva__by { display: flex; flex-direction: column; }
  .reserva__label {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sage-deep);
    font-weight: 600;
  }
  .reserva__by a {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--ink);
  }
  .reserva__by a:hover { color: var(--sage-deep); }
  @media (max-width: 860px) {
    .reserva__box { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .reserva__box { padding: 1.5rem 1.25rem; gap: 1.6rem; }
    .reserva__cta { margin-top: 1.4rem; }
    .reserva__data { padding: 1.2rem; gap: 0.9rem; }
  }
</style>
