---
import { categoriasTratamientos, formatUYU } from '../data/tratamientos';
import { modalidades } from '../data/modalidades';
import { whatsappLink } from '../data/site';
import {
  claveTratamiento,
  leerPrecios,
  precioDesde,
  precioModalidadTexto,
} from '../lib/precios-vigentes';

// Precios vigentes: los que Ceci carga en /admin → Precios (respaldo: el código).
const precios = await leerPrecios();
const valor = (id: string) => precios[claveTratamiento(id)];

const consultaMod = modalidades.find((m) => m.id === 'presencial');
const consulta = consultaMod && { ...consultaMod, precio: precioModalidadTexto(precios, consultaMod) };
const dev = import.meta.env.DEV;
---

<section class="section" id="tratamientos">
  <div class="container">
    <div class="trat__head reveal">
      <h2>Tratamientos y valores</h2>
      <p class="lead mx-auto text-center">
        Protocolos faciales, capilares y corporales, con su valor por sesión. Cada tratamiento
        se indica en tu consulta de valoración, según lo que tu piel necesita.
      </p>
      {consulta?.precio && (
        <p class="trat__consulta">
          Todo empieza con la Consulta Presencial ({consulta.precio}).
          {consulta.precioNota && <> {consulta.precioNota}.</>}
        </p>
      )}
    </div>

    <div class="trat__cats">
      {categoriasTratamientos.map((cat) => {
        const desde = precioDesde(cat.tratamientos.map((t) => t.id), precios);
        return (
          <details class="trat__cat reveal" open>
            <summary class="trat__catHead">
              <span class="trat__grupo">{cat.grupo}</span>
              <h3>{cat.titulo}</h3>
              {desde != null && <span class="trat__desde">Desde {formatUYU(desde)}</span>}
              <p>{cat.intro}</p>
              <span class="trat__chev" aria-hidden="true">+</span>
            </summary>
            <ul class="trat__list">
              {cat.tratamientos.map((t) => {
                const v = valor(t.id);
                return (
                  <li>
                    <div class="trat__itemHead">
                      <h4>{t.nombre}</h4>
                      {v.precio == null ? (
                        <span class="trat__precio trat__precio--consulta">
                          Valor en consulta
                          {dev && v.pendiente && <span class="trat__confirmar">CONFIRMAR</span>}
                        </span>
                      ) : (
                        <span class="trat__precio">
                          {formatUYU(v.precio)}
                          <span class="trat__unidad">{t.unidad ?? 'por sesión'}</span>
                        </span>
                      )}
                    </div>
                    <p>{t.descripcion}</p>
                    {(t.duracion || (v.precio != null && v.paquete6 != null)) && (
                      <p class="trat__meta">
                        {t.duracion && <span>{t.duracion}</span>}
                        {v.precio != null && v.paquete6 != null && (
                          <span>Paquete de 6 sesiones: <strong>{formatUYU(v.paquete6)}</strong></span>
                        )}
                      </p>
                    )}
                  </li>
                );
              })}
            </ul>
          </details>
        );
      })}
    </div>

    <p class="trat__fine">
      Valores de referencia en pesos uruguayos. El plan final, con la cantidad de sesiones y la
      combinación de tratamientos, se define en consulta. Los paquetes son personales e
      intransferibles.
    </p>

    <div class="trat__cta reveal">
      <p>¿No sabés cuál es para vos? Lo definimos juntas en tu consulta de valoración.</p>
      <div class="trat__ctaBtns">
        <a href="/reservar?modalidad=presencial" class="btn btn--primary">Reservar mi consulta</a>
        <a
          href={whatsappLink('Hola Ceci, quiero consultar por un tratamiento.')}
          class="btn btn--ghost"
          target="_blank"
          rel="noopener"
        >
          Consultar por WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<!-- En mobile el catálogo arranca plegado; sin JS queda todo abierto (open en el server). -->
<script is:inline>
  (() => {
    const mq = window.matchMedia('(max-width: 760px)');
    const cats = document.querySelectorAll('#tratamientos .trat__cat');
    const apply = (mobile) => {
      cats.forEach((d) => {
        if (mobile) d.removeAttribute('open');
        else d.setAttribute('open', '');
      });
    };
    let last = mq.matches;
    apply(last);
    const onChange = () => {
      if (mq.matches === last) return;
      last = mq.matches;
      apply(last);
    };
    mq.addEventListener('change', onChange);
    // Fallback: algunos navegadores no disparan 'change' de matchMedia al redimensionar.
    window.addEventListener('resize', onChange, { passive: true });
  })();
</script>

<style>
  .trat__head { text-align: center; max-width: 760px; margin-inline: auto; }
  .trat__head h2 { margin: 0.4rem 0 1rem; }
  .trat__cats { display: grid; gap: 2.5rem; margin-top: 3rem; }
  .trat__cat {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 2rem;
    align-items: start;
    padding-top: 2rem;
    border-top: 1px solid var(--sand);
  }
  .trat__cat:first-child { border-top: 0; padding-top: 0; }
  .trat__grupo {
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--clay);
    font-weight: 600;
  }
  .trat__catHead { list-style: none; }
  .trat__catHead::-webkit-details-marker { display: none; }
  .trat__catHead h3 { margin: 0.4rem 0 0.6rem; }
  .trat__catHead p { font-size: 0.95rem; }
  .trat__chev { display: none; }
  .trat__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.1rem;
  }
  .trat__list li {
    background: var(--white);
    border: 1px solid var(--sand);
    border-radius: var(--radius-sm);
    padding: 1.2rem;
  }
  .trat__list h4 {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    font-weight: 500;
    margin-bottom: 0.4rem;
    color: var(--ink);
  }
  .trat__list p { font-size: 0.92rem; }
  .trat__cta {
    margin-top: 3rem;
    text-align: center;
    display: grid;
    gap: 1.2rem;
    justify-items: center;
  }
  .trat__cta p { font-size: 1.05rem; color: var(--ink); }
  .trat__ctaBtns { display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: center; }

  /* Valores */
  .trat__consulta {
    margin-top: 1rem;
    font-size: 0.95rem;
    color: var(--sage-deep);
  }
  .trat__desde {
    display: inline-block;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--sage-deep);
  }
  .trat__itemHead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }
  .trat__itemHead h4 { margin-bottom: 0; flex: 1 1 12rem; }
  .trat__precio {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--clay-deep);
    white-space: nowrap;
  }
  .trat__unidad {
    margin-left: 0.3rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--ink-soft);
  }
  .trat__precio--consulta {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .trat__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin-top: 0.7rem;
    padding-top: 0.6rem;
    border-top: 1px dashed var(--sand);
    font-size: 0.85rem;
  }
  .trat__meta strong { color: var(--ink); font-weight: 600; white-space: nowrap; }
  /* Solo en `npm run dev`: marca los valores que faltan pasar. */
  .trat__confirmar {
    margin-left: 0.4rem;
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--clay) 22%, var(--white));
    color: var(--clay-deep);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .trat__fine {
    max-width: 640px;
    margin: 2.5rem auto 0;
    text-align: center;
    font-size: 0.85rem;
  }

  /* Desktop y tablet: el details se comporta como el bloque estático de siempre. */
  @media (min-width: 761px) {
    .trat__catHead { pointer-events: none; position: sticky; top: 100px; }
  }
  @media (min-width: 761px) and (max-width: 860px) {
    .trat__cat { grid-template-columns: 1fr; gap: 1.2rem; }
    .trat__catHead { position: static; }
  }

  /* Mobile: cada categoría es un acordeón; el catálogo entero cabe en una pantalla. */
  @media (max-width: 760px) {
    .trat__cats { gap: 0.8rem; margin-top: 2rem; }
    .trat__cat {
      display: block;
      background: var(--white);
      border: 1px solid var(--sand);
      border-radius: var(--radius-sm);
      padding: 0;
    }
    /* El :first-child del layout desktop anula el border-top; acá lo recupera. */
    .trat__cat:first-child { padding-top: 0; border-top: 1px solid var(--sand); }
    .trat__catHead {
      position: relative;
      cursor: pointer;
      padding: 1.05rem 3rem 1.05rem 1.2rem;
      -webkit-tap-highlight-color: transparent;
    }
    .trat__catHead h3 { margin: 0.25rem 0 0; font-size: 1.2rem; }
    .trat__catHead p { display: none; margin-top: 0.5rem; }
    .trat__cat[open] .trat__catHead p { display: block; }
    .trat__chev {
      display: block;
      position: absolute;
      top: 1.05rem;
      right: 1.2rem;
      font-size: 1.5rem;
      line-height: 1.4;
      color: var(--sage);
      transition: transform 0.2s ease;
    }
    .trat__cat[open] .trat__chev { transform: rotate(45deg); }
    .trat__list {
      grid-template-columns: 1fr;
      gap: 0.7rem;
      padding: 0 1.2rem 1.2rem;
    }
    .trat__list li { background: var(--cream); border-color: color-mix(in srgb, var(--sand) 60%, transparent); }
    .trat__cta { margin-top: 2rem; }
    @media (prefers-reduced-motion: reduce) {
      .trat__chev { transition: none; }
    }
  }
</style>
