---
import { categoriasTratamientos, formatUYU } from '../data/tratamientos';
import { modalidades } from '../data/modalidades';
import { whatsappLink } from '../data/site';
import { formasDePago } from '../data/pago';
import {
  claveTratamiento,
  leerPrecios,
  precioDesde,
  precioModalidadTexto,
} from '../lib/precios-vigentes';

// Precios vigentes: los que Ceci carga en /admin → Precios (respaldo: el código).
const precios = await leerPrecios();
const valor = (id: string) => precios[claveTratamiento(id)];

const consultaMod = modalidades.find((m) => m.id === 'presencial');
const consulta = consultaMod && { ...consultaMod, precio: precioModalidadTexto(precios, consultaMod) };
const dev = import.meta.env.DEV;
---

<section class="section" id="tratamientos">
  <div class="container">
    <div class="trat__head reveal">
      <h2>Tratamientos y valores</h2>
      <p class="lead mx-auto text-center">
        Protocolos faciales, capilares y corporales, con su valor por sesión. Cada tratamiento
        se indica en tu consulta de valoración, según lo que tu piel necesita.
      </p>
      {consulta?.precio && (
        <p class="trat__consulta">
          Todo empieza con la Consulta Presencial ({consulta.precio}).
          {consulta.precioNota && <> {consulta.precioNota}.</>}
        </p>
      )}
    </div>

    <div class="trat__cats">
      {categoriasTratamientos.map((cat) => {
        const desde = precioDesde(cat.tratamientos.map((t) => t.id), precios);
        return (
          <details class="trat__cat reveal" open>
            <summary class="trat__catHead">
              <span class="trat__grupo">{cat.grupo}</span>
              <h3>{cat.titulo}</h3>
              {desde != null && <span class="trat__desde">Desde {formatUYU(desde)}</span>}
              <p>{cat.intro}</p>
              <span class="trat__chev" aria-hidden="true">+</span>
            </summary>
            <ul class="trat__list">
              {cat.tratamientos.map((t) => {
                const v = valor(t.id);
                return (
                  <li>
                    <div class="trat__itemHead">
                      <h4>{t.nombre}</h4>
                      {v.precio == null ? (
                        <span class="trat__precio trat__precio--consulta">
                          Valor en consulta
                          {dev && v.pendiente && <span class="trat__confirmar">CONFIRMAR</span>}
                        </span>
                      ) : (
                        <span class="trat__precio">
                          {formatUYU(v.precio)}
                          <span class="trat__unidad">{t.unidad ?? 'por sesión'}</span>
                        </span>
                      )}
                    </div>
                    <p>{t.descripcion}</p>
                    {(t.duracion || (v.precio != null && (v.paquete6 != null || t.paquete12))) && (
                      <p class="trat__meta">
                        {t.duracion && <span>{t.duracion}</span>}
                        {v.precio != null && v.paquete6 != null && (
                          <span>Paquete de 6 sesiones: <strong>{formatUYU(v.paquete6)}</strong></span>
                        )}
                        {v.precio != null && t.paquete12 && (
                          <span>Paquete de 12 sesiones: <strong>{formatUYU(t.paquete12)}</strong></span>
                        )}
                        {v.precio != null && (v.paquete6 != null || t.paquete12) && t.paqueteNota && (
                          <span class="trat__paqNota">Sesiones {t.paqueteNota}</span>
                        )}
                      </p>
                    )}
                    {/* Cada tratamiento se reserva directo, con la misma agenda que
                        las consultas (pedido nov-2026). */}
                    <a class="trat__reservar" href={`/reservar?tratamiento=${t.id}`}>
                      Reservar <span aria-hidden="true">→</span>
                      <span class="sr-only"> {t.nombre}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </details>
        );
      })}
    </div>

    <ul class="trat__pago reveal">
      <li>{formasDePago.transferencia}</li>
      <li>{formasDePago.cuotas}</li>
    </ul>

    <p class="trat__fine">
      Valores de referencia en pesos uruguayos. El plan final, con la cantidad de sesiones y la
      combinación de tratamientos, se define en consulta. Los paquetes son personales e
      intransferibles.
    </p>

    <div class="trat__cta reveal">
      <p>¿No sabés cuál es para vos? Lo definimos en conjunto en tu consulta de valoración.</p>
      <div class="trat__ctaBtns">
        <a href="/reservar?modalidad=presencial" class="btn btn--primary">Reservar consulta</a>
        <a
          href={whatsappLink('Hola Ceci, quiero consultar por un tratamiento.')}
          class="btn btn--ghost"
          target="_blank"
          rel="noopener"
        >
          Consultar por WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<!-- El catálogo arranca plegado en todos los anchos (revisión UX nov-2026: en desktop
     ocupaba ~3.600 px abierto). Sin JS queda todo abierto (open en el server). -->
<script is:inline>
  document.querySelectorAll('#tratamientos .trat__cat').forEach((d) => d.removeAttribute('open'));
</script>

<style>
  .trat__head { text-align: center; max-width: 760px; margin-inline: auto; }
  .trat__head h2 { margin: 0.4rem 0 1rem; }
  /* Cada categoría es una fila plegable (como el índice de la portada): nombre,
     resumen y "Desde $X"; al tocarla se abren sus tratamientos. */
  .trat__cats { display: grid; margin-top: 3rem; border-bottom: 1px solid var(--sand); }
  .trat__cat { border-top: 1px solid var(--sand); }
  .trat__grupo {
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--clay);
    font-weight: 600;
  }
  .trat__catHead {
    list-style: none;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr) 8.5rem; /* columna fija: el resumen queda alineado haya o no "Desde" */
    column-gap: 2.5rem;
    align-items: center;
    padding: 1.5rem 3.5rem 1.5rem 0.75rem;
    cursor: pointer;
    transition: background-color 0.25s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .trat__catHead:hover { background-color: var(--cream-deep); }
  .trat__catHead::-webkit-details-marker { display: none; }
  .trat__grupo { grid-column: 1; }
  .trat__catHead h3 { grid-column: 1; margin: 0.3rem 0 0; }
  .trat__catHead p { grid-column: 2; grid-row: 1 / span 2; font-size: 0.95rem; }
  .trat__catHead .trat__desde { grid-column: 3; grid-row: 1 / span 2; justify-self: end; margin: 0; white-space: nowrap; }
  .trat__chev {
    position: absolute;
    top: 50%;
    right: 0.9rem;
    transform: translateY(-50%);
    font-size: 1.6rem;
    line-height: 1;
    color: var(--sage-deep);
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .trat__cat[open] .trat__chev { transform: translateY(-50%) rotate(45deg); }
  .trat__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.1rem;
    padding: 0.4rem 0.75rem 2rem;
  }
  .trat__list li {
    background: var(--white);
    border: 1px solid var(--sand);
    border-radius: var(--radius-sm);
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
  }
  .trat__reservar {
    margin-top: auto;
    align-self: flex-end;
    padding-top: 0.8rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--clay-deep);
  }
  .trat__reservar:hover { color: var(--ink); }
  .trat__list h4 {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    font-weight: 500;
    margin-bottom: 0.4rem;
    color: var(--ink);
  }
  .trat__list p { font-size: 0.92rem; }
  .trat__cta {
    margin-top: 3rem;
    text-align: center;
    display: grid;
    gap: 1.2rem;
    justify-items: center;
  }
  .trat__cta p { font-size: 1.05rem; color: var(--ink); }
  .trat__ctaBtns { display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: center; }

  /* Valores */
  .trat__consulta {
    margin-top: 1rem;
    font-size: 0.95rem;
    color: var(--sage-deep);
  }
  .trat__desde {
    display: inline-block;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--sage-deep);
  }
  .trat__itemHead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }
  .trat__itemHead h4 { margin-bottom: 0; flex: 1 1 12rem; }
  .trat__precio {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--clay-deep);
    white-space: nowrap;
  }
  .trat__unidad {
    margin-left: 0.3rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--ink-soft);
  }
  .trat__precio--consulta {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .trat__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin-top: 0.7rem;
    padding-top: 0.6rem;
    border-top: 1px dashed var(--sand);
    font-size: 0.85rem;
  }
  .trat__meta strong { color: var(--ink); font-weight: 600; white-space: nowrap; }
  /* Solo en `npm run dev`: marca los valores que faltan pasar. */
  .trat__confirmar {
    margin-left: 0.4rem;
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--clay) 22%, var(--white));
    color: var(--clay-deep);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .trat__paqNota { flex-basis: 100%; font-style: italic; }
  /* Formas de pago: van antes de la letra chica porque cambian el precio final. */
  .trat__pago {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin: 2.5rem auto 0;
  }
  .trat__pago li {
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--sand);
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink);
  }
  .trat__fine {
    max-width: 640px;
    margin: 1.2rem auto 0;
    text-align: center;
    font-size: 0.85rem;
  }

  /* Tablet: el resumen pasa debajo del nombre. */
  @media (max-width: 980px) {
    .trat__catHead { grid-template-columns: minmax(0, 1fr) auto; column-gap: 1.5rem; }
    .trat__catHead .trat__desde { grid-column: 2; }
    .trat__catHead p { grid-column: 1 / -1; grid-row: 3; margin-top: 0.5rem; }
  }

  /* Mobile: cada categoría es un acordeón; el catálogo entero cabe en una pantalla. */
  @media (max-width: 760px) {
    .trat__cats { gap: 0.8rem; margin-top: 2rem; border-bottom: 0; }
    .trat__cat {
      display: block;
      background: var(--white);
      border: 1px solid var(--sand);
      border-radius: var(--radius-sm);
      padding: 0;
    }
    /* El :first-child del layout desktop anula el border-top; acá lo recupera. */
    .trat__cat:first-child { padding-top: 0; border-top: 1px solid var(--sand); }
    .trat__catHead {
      display: block;
      padding: 1.05rem 3rem 1.05rem 1.2rem;
    }
    .trat__catHead:hover { background-color: transparent; }
    .trat__catHead .trat__desde { display: block; margin: 0.35rem 0 0; }
    .trat__catHead h3 { margin: 0.25rem 0 0; font-size: 1.2rem; }
    .trat__catHead p { display: none; margin-top: 0.5rem; }
    .trat__cat[open] .trat__catHead p { display: block; }
    .trat__chev {
      display: block;
      position: absolute;
      top: 1.05rem;
      right: 1.2rem;
      transform: none;
      font-size: 1.5rem;
      line-height: 1.4;
      color: var(--sage);
      transition: transform 0.2s ease;
    }
    .trat__cat[open] .trat__chev { transform: rotate(45deg); }
    .trat__list {
      grid-template-columns: 1fr;
      gap: 0.7rem;
      padding: 0 1.2rem 1.2rem;
    }
    .trat__list li { background: var(--cream); border-color: color-mix(in srgb, var(--sand) 60%, transparent); }
    .trat__cta { margin-top: 2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .trat__chev, .trat__catHead { transition: none; }
  }
</style>
