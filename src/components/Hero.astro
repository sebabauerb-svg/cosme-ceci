---
import { site, whatsappLink } from '../data/site';
import { imagenes } from '../data/imagenes';
const heroImg = imagenes.hero;
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy hero__copy--in">
      <span class="eyebrow">Cosmetología Médica · Montevideo y San José</span>
      <h1>Cuidado profesional para una piel sana, equilibrada y luminosa.</h1>
      <p class="lead">
        No hay recetas mágicas ni protocolos en serie. Cada piel cuenta una historia distinta,
        y por eso cada tratamiento empieza con una evaluación profesional y un protocolo
        diseñado a la medida real de tu piel.
      </p>

      <div class="hero__cta">
        <a href="/reservar" class="btn btn--primary">
          Reservar consulta
        </a>
        <a href="/#oferta" class="btn btn--ghost hero__ver">Ver qué ofrezco</a>
      </div>
    </div>

    <div class="hero__art hero__art--in">
      {heroImg.src ? (
        <div class="hero__photo">
          <picture>
            <source srcset={heroImg.src.replace(/\.jpg$/, '.webp')} type="image/webp" />
            <img src={heroImg.src} alt={heroImg.alt} width="1200" height="1600" fetchpriority="high" loading="eager" decoding="async" />
          </picture>
        </div>
      ) : (
        <div aria-hidden="true">
          <div class="hero__orb"></div>
          <div class="hero__leaf"></div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(1100px 520px at 78% -8%, rgba(110, 127, 106, 0.18), transparent 60%),
      radial-gradient(700px 420px at 0% 110%, rgba(192, 128, 95, 0.14), transparent 55%);
  }
  /* Arranque compacto (nov-2026): el Hero deja lugar para que el índice de lo que
     ofrece Ceci (Oferta.astro) asome en la primera pantalla. */
  .hero__inner {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: 3rem;
    align-items: center;
    padding-block: clamp(2rem, 4vw, 3rem) clamp(1.8rem, 3vw, 2.2rem);
  }
  .hero h1 { margin: 0.6rem 0 1.2rem; font-size: clamp(2.3rem, 4.2vw, 2.95rem); text-wrap: balance; }

  /* Entrada de carga: el contenido del hero asienta escalonado (ease-out-quint) */
  @keyframes heroIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: none; }
  }
  .hero__copy--in > * { animation: heroIn 0.9s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .hero__copy--in > *:nth-child(1) { animation-delay: 0.05s; }
  .hero__copy--in > *:nth-child(2) { animation-delay: 0.13s; }
  .hero__copy--in > *:nth-child(3) { animation-delay: 0.21s; }
  .hero__copy--in > *:nth-child(4) { animation-delay: 0.29s; }
  .hero__copy--in > *:nth-child(5) { animation-delay: 0.37s; }
  .hero__art--in { animation: heroIn 1s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both; }

  @media (prefers-reduced-motion: reduce) {
    .hero__copy--in > *, .hero__art--in { animation: none; }
  }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.5rem; }

  .hero__art { position: relative; aspect-ratio: 1 / 1; min-height: 280px; max-width: 400px; width: 100%; justify-self: end; }
  .hero__orb {
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    background: linear-gradient(150deg, var(--sage) 0%, var(--clay) 100%);
    opacity: 0.92;
  }
  .hero__leaf {
    position: absolute;
    width: 46%; height: 46%;
    right: 14%; bottom: 12%;
    background: var(--cream);
    border-radius: 0 100% 0 100%;
    opacity: 0.32;
  }
  .hero__photo {
    position: absolute;
    inset: 4%;
    border-radius: 50% 50% 48% 48% / 46% 46% 50% 50%;
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .hero__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 48%; }
  /* Una columna (tablet y celular): foto chica al lado del eyebrow para que, debajo
     del botón, ya aparezca el índice de consultas y tratamientos (antes la foto sola
     ocupaba media pantalla). */
  @media (max-width: 860px) {
    .hero__inner {
      --foto: 104px;
      grid-template-columns: var(--foto) minmax(0, 1fr);
      gap: 0 1.2rem;
      padding-block: 1.8rem 2.2rem;
    }
    .hero__copy { display: contents; }
    .hero__art {
      grid-column: 1; grid-row: 1;
      width: var(--foto); max-width: none; min-height: 0;
      align-self: center;
      justify-self: start;
    }
    .hero__photo { inset: 0; box-shadow: none; }
    .hero__copy > .eyebrow { grid-column: 2; grid-row: 1; align-self: center; }
    .hero__copy > :not(.eyebrow) { grid-column: 1 / -1; }
    .hero h1 { margin: 1.2rem 0 0.9rem; }
  }

  @media (max-width: 760px) {
    .hero__inner { --foto: 76px; gap: 0 1rem; padding-block: 1.4rem 1.9rem; }
    .hero__copy > .eyebrow { font-size: 0.72rem; letter-spacing: 0.12em; }
    .hero h1 { font-size: 1.9rem; margin: 1rem 0 0.75rem; }
    .hero .lead { font-size: 1rem; }
    .hero__cta { margin-top: 1.2rem; }
    .hero__cta .btn { flex: 1 1 auto; justify-content: center; }
    /* El índice empieza justo debajo: el segundo botón sobraría. */
    .hero__ver { display: none; }
  }
</style>
