---
import { site, whatsappLink } from '../data/site';
import { imagenes } from '../data/imagenes';
const heroImg = imagenes.hero;
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy hero__copy--in">
      <span class="eyebrow">Cosmetología Médica · Montevideo y San José</span>
      <h1>Cuidado profesional para una piel sana, equilibrada y luminosa.</h1>
      <p class="lead">
        No hay recetas mágicas ni protocolos en serie. Cada piel cuenta una historia distinta,
        y por eso cada tratamiento empieza con una evaluación profesional y un protocolo
        diseñado a la medida real de tu piel.
      </p>

      <div class="hero__cta">
        <a href="/reservar" class="btn btn--primary">
          Agendá tu valoración
        </a>
        <a href="/#modalidades" class="btn btn--ghost">Ver modalidades</a>
      </div>

      <ul class="hero__trust">
        <li><strong>Enfoque boutique</strong> y personalizado</li>
        <li><strong>Tecnología</strong> y activos de última generación</li>
        <li><strong>Atención</strong> basada en evidencia</li>
      </ul>
    </div>

    <div class="hero__art hero__art--in">
      {heroImg.src ? (
        <div class="hero__photo">
          <picture>
            <source srcset={heroImg.src.replace(/\.jpg$/, '.webp')} type="image/webp" />
            <img src={heroImg.src} alt={heroImg.alt} width="1200" height="1600" fetchpriority="high" loading="eager" decoding="async" />
          </picture>
        </div>
      ) : (
        <div aria-hidden="true">
          <div class="hero__orb"></div>
          <div class="hero__leaf"></div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(1100px 520px at 78% -8%, rgba(110, 127, 106, 0.18), transparent 60%),
      radial-gradient(700px 420px at 0% 110%, rgba(192, 128, 95, 0.14), transparent 55%);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3rem;
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .hero h1 { margin: 0.6rem 0 1.4rem; }

  /* Entrada de carga: el contenido del hero asienta escalonado (ease-out-quint) */
  @keyframes heroIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: none; }
  }
  .hero__copy--in > * { animation: heroIn 0.9s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .hero__copy--in > *:nth-child(1) { animation-delay: 0.05s; }
  .hero__copy--in > *:nth-child(2) { animation-delay: 0.13s; }
  .hero__copy--in > *:nth-child(3) { animation-delay: 0.21s; }
  .hero__copy--in > *:nth-child(4) { animation-delay: 0.29s; }
  .hero__copy--in > *:nth-child(5) { animation-delay: 0.37s; }
  .hero__art--in { animation: heroIn 1s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both; }

  @media (prefers-reduced-motion: reduce) {
    .hero__copy--in > *, .hero__art--in { animation: none; }
  }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }
  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    list-style: none;
    margin-top: 2.6rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--sand);
    font-size: 0.92rem;
    color: var(--ink-soft);
  }
  .hero__trust strong { color: var(--ink); font-family: var(--font-serif); font-weight: 500; }

  .hero__art { position: relative; aspect-ratio: 1 / 1; min-height: 320px; }
  .hero__orb {
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    background: linear-gradient(150deg, var(--sage) 0%, var(--clay) 100%);
    opacity: 0.92;
  }
  .hero__leaf {
    position: absolute;
    width: 46%; height: 46%;
    right: 14%; bottom: 12%;
    background: var(--cream);
    border-radius: 0 100% 0 100%;
    opacity: 0.32;
  }
  .hero__photo {
    position: absolute;
    inset: 4%;
    border-radius: 50% 50% 48% 48% / 46% 46% 50% 50%;
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .hero__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 48%; }
  @media (max-width: 860px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__art { order: -1; max-width: 340px; margin-inline: auto; width: 100%; }
  }

  /* Mobile: el hero entra en una pantalla — foto contenida y jerarquía más compacta. */
  @media (max-width: 760px) {
    .hero__inner { gap: 1.5rem; padding-block: 1.9rem 2.6rem; }
    .hero__art { max-width: 236px; min-height: 0; }
    .hero h1 { font-size: 2.05rem; margin: 0.5rem 0 1rem; }
    .hero__cta { margin-top: 1.4rem; }
    .hero__trust {
      margin-top: 1.6rem;
      padding-top: 1.2rem;
      gap: 0.45rem 1.4rem;
      font-size: 0.88rem;
    }
  }
</style>
