---
import { club } from '../data/club';
import { whatsappLink } from '../data/site';
import { formasDePago } from '../data/pago';
---

<section class="section club" id="club">
  <div class="container">
    <div class="club__head reveal">
      <h2>{club.nombre}</h2>
      <p class="club__sub">{club.subtitulo}</p>
      <p class="lead mx-auto text-center">{club.intro}</p>
      <a
        class="club__more"
        href={whatsappLink('Hola Ceci! Me gustaría saber más sobre el Club de las Estaciones.')}
        target="_blank"
        rel="noopener"
      >
        Quiero saber más →
      </a>
    </div>

    <div class="club__estaciones">
      {club.estaciones.map((e) => (
        <div class="club__est reveal">
          <span class="club__estName">{e.nombre}</span>
          <p>{e.texto}</p>
        </div>
      ))}
    </div>

    <div class="club__planes">
      {club.planes.map((p) => (
        <article class={`club__plan reveal ${p.destacado ? 'club__plan--feat' : ''}`}>
          <header class="club__planHead">
            <h3>{p.nombre}</h3>
            <span class="club__formato">{p.formato}</span>
          </header>
          <ul class="club__incluye">
            {p.incluye.map((i) => (
              <li><span aria-hidden="true">✓</span> {i}</li>
            ))}
          </ul>
          <div class="club__precio">
            <span class="club__monto">{p.precio}</span>
            <span class="club__periodo">{club.precioPeriodo}</span>
            <ul class="club__pago">
              <li>{formasDePago.transferencia}</li>
              <li>{formasDePago.cuotas}</li>
              {p.moneda === 'USD' && <li>{formasDePago.enPesosMp}</li>}
            </ul>
            <a href={`/reservar?modalidad=${p.modalidadId}`} class="btn btn--primary">
              {club.cta}<span class="sr-only"> al {p.nombre}</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .club {
    background: var(--ink);
    color: var(--cream);
  }
  .club h2 { color: var(--cream); }
  .club__head { text-align: center; max-width: 720px; margin-inline: auto; }
  .club__head h2 { margin: 0 0 0.35rem; }
  .club__sub {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--clay);
    margin-bottom: 1.1rem;
  }
  .club__head :global(.lead) { color: var(--sand); }
  .club__more {
    display: inline-block;
    margin-top: 1.4rem;
    color: var(--cream);
    font-weight: 600;
    border-bottom: 1.5px solid var(--clay);
    padding-bottom: 2px;
    position: relative;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  /* Amplía el área táctil sin mover el subrayado. */
  .club__more::before { content: ''; position: absolute; inset: -10px -6px; }
  .club__more:hover { color: var(--clay); border-color: var(--cream); }

  .club__estaciones {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 3rem;
  }
  .club__est {
    background: rgba(250, 246, 240, 0.05);
    border: 1px solid rgba(250, 246, 240, 0.14);
    border-radius: var(--radius-sm);
    padding: 1.3rem;
  }
  .club__estName {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--cream);
    display: block;
    margin-bottom: 0.5rem;
  }
  .club__est p { color: var(--sand); font-size: 0.92rem; }

  .club__planes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
    margin-top: 2rem;
  }
  .club__plan {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1.2rem;
    background: rgba(250, 246, 240, 0.05);
    border: 1px solid rgba(250, 246, 240, 0.14);
    border-radius: var(--radius);
    padding: clamp(1.4rem, 3vw, 2rem);
  }
  .club__plan--feat { border-color: var(--clay); }
  .club__planHead h3 { color: var(--cream); margin: 0 0 0.2rem; }
  .club__formato {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--clay);
  }
  .club__incluye { list-style: none; display: grid; gap: 0.75rem; align-content: start; }
  .club__incluye li { display: flex; gap: 0.7rem; color: var(--cream); }
  .club__incluye span { color: var(--sage); font-weight: 700; flex: none; }

  .club__precio {
    text-align: center;
    background: var(--cream);
    border-radius: var(--radius);
    padding: 1.5rem 1.2rem;
    display: grid;
    gap: 0.25rem;
    justify-items: center;
  }
  .club__monto { font-family: var(--font-serif); font-size: 2.4rem; color: var(--ink); line-height: 1; }
  .club__periodo { color: var(--ink-soft); font-size: 0.95rem; }
  .club__pago {
    list-style: none; display: grid; gap: 0.3rem;
    color: var(--ink-soft); font-size: 0.85rem; margin: 0.6rem 0 1rem; max-width: 30ch;
  }
  .club__precio .btn { width: 100%; justify-content: center; }

  @media (max-width: 860px) {
    .club__estaciones { grid-template-columns: repeat(2, 1fr); }
    .club__planes { grid-template-columns: 1fr; }
  }

  /* Mobile: las estaciones quedan en 2×2 compacto y el plan pierde aire sobrante. */
  @media (max-width: 760px) {
    .club__more { margin-top: 1rem; }
    /* Estaciones en una fila deslizable (asoma la siguiente): mitad de alto. */
    .club__estaciones {
      display: flex;
      gap: 0.7rem;
      margin: 2rem calc(-1 * clamp(1.25rem, 5vw, 2.5rem)) 0;
      padding-inline: clamp(1.25rem, 5vw, 2.5rem);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: clamp(1.25rem, 5vw, 2.5rem);
      scrollbar-width: none;
    }
    .club__estaciones::-webkit-scrollbar { display: none; }
    .club__est { padding: 0.95rem; flex: 0 0 72%; scroll-snap-align: start; }
    .club__estName { font-size: 1.1rem; margin-bottom: 0.35rem; }
    .club__est p { font-size: 0.85rem; }
    .club__planes { margin-top: 1.4rem; }
    .club__plan { gap: 1rem; padding: 1.25rem; }
    .club__incluye { gap: 0.6rem; }
    .club__incluye li { font-size: 0.95rem; }
    .club__precio { padding: 1.4rem 1.2rem; }
    .club__monto { font-size: 2.2rem; }
  }
</style>
